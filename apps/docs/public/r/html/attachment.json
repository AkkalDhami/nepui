      />\n                <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n              </svg>\n            </div>\n            <div class=\"np-attachment-content\">\n              <div class=\"np-attachment-title\">logo.svg</div>\n              <div class=\"np-attachment-description\">SVG · 12 KB</div>\n            </div>\n            <div class=\"np-attachment-actions\">\n              <button\n                type=\"button\"\n                class=\"np-button np-button-ghost np-button-icon-xs np-attachment-action\"\n                aria-label=\"Remove logo.svg\"\n              >\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  width=\"24\"\n                  height=\"24\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M18 6 6 18\" />\n                  <path d=\"m6 6 12 12\" />\n                </svg>\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Trigger</h2>\n        <p>A full-card link. The action stays clickable.</p>\n        <div style=\"width: 100%; max-width: 24rem; display: grid; gap: 0.75rem\">\n          <div class=\"np-attachment\">\n            <div class=\"np-attachment-media\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                />\n                <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n              </svg>\n            </div>\n            <div class=\"np-attachment-content\">\n              <div class=\"np-attachment-title\">release-notes.pdf</div>\n              <div class=\"np-attachment-description\">PDF · 1.2 MB</div>\n            </div>\n            <div class=\"np-attachment-actions\">\n              <button\n                type=\"button\"\n                class=\"np-button np-button-ghost np-button-icon-xs np-attachment-action\"\n                aria-label=\"Download release-notes.pdf\"\n              >\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  width=\"24\"\n                  height=\"24\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                  <polyline points=\"7 10 12 15 17 10\" />\n                  <line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\" />\n                </svg>\n              </button>\n            </div>\n            <a\n              href=\"#\"\n              class=\"np-attachment-trigger\"\n              aria-label=\"Open release-notes.pdf\"\n            ></a>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <div data-np-attachment data-state=\"error\" style=\"max-width: 24rem\">\n          <div data-np-attachment-media>\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              aria-hidden=\"true\"\n            >\n              <circle cx=\"12\" cy=\"12\" r=\"10\" />\n              <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n              <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />\n            </svg>\n          </div>\n          <div data-np-attachment-content>\n            <div data-np-attachment-title>invoice.pdf</div>\n            <div data-np-attachment-description>Upload failed</div>\n          </div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
