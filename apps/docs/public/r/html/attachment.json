    {
      "path": "registry/html/attachment/attachment.css",
      "content": "/* nepui — Attachment */\n\n.np-attachment,\n[data-np-attachment] {\n  --np-attachment-padding: calc(var(--np-spacing) * 2);\n  --np-attachment-gap: calc(var(--np-spacing) * 3);\n  --np-attachment-radius: var(--np-radius-xl);\n  --np-attachment-font-size: 0.875rem;\n  --np-attachment-media-size: 2.5rem;\n  --np-attachment-icon-size: 1.25rem;\n  --np-attachment-bg: var(--np-background);\n  --np-attachment-color: var(--np-foreground);\n  --np-attachment-border-color: var(--np-border);\n  --np-attachment-media-bg: var(--np-muted);\n  --np-attachment-media-color: var(--np-muted-foreground);\n  --np-attachment-description-color: var(--np-muted-foreground);\n  --np-attachment-progress: 0%;\n\n  position: relative;\n  box-sizing: border-box;\n  display: flex;\n  align-items: center;\n  gap: var(--np-attachment-gap);\n  min-width: 0;\n  padding: var(--np-attachment-padding);\n  border: 1px solid var(--np-attachment-border-color);\n  border-radius: var(--np-attachment-radius);\n  background-color: var(--np-attachment-bg);\n  color: var(--np-attachment-color);\n  font-size: var(--np-attachment-font-size);\n  line-height: 1.25;\n  text-align: start;\n}\n\n:is(.np-attachment, [data-np-attachment]):has(\n  > :is(.np-attachment-trigger, [data-np-attachment-trigger]):hover\n) {\n  background-color: color-mix(\n    in oklab,\n    var(--np-muted) 50%,\n    var(--np-attachment-bg)\n  );\n}\n\n:is(.np-attachment, [data-np-attachment]):has(\n  > :is(.np-attachment-trigger, [data-np-attachment-trigger]):focus-visible\n) {\n  border-color: var(--np-ring);\n  box-shadow: 0 0 0 3px color-mix(in oklch, var(--np-ring), transparent 50%);\n}\n\n:is(.np-attachment-sm, [data-size=\"sm\"]):is(\n  .np-attachment,\n  [data-np-attachment]\n) {\n  --np-attachment-padding: calc(var(--np-spacing) * 1.5);\n  --np-attachment-gap: calc(var(--np-spacing) * 2);\n  --np-attachment-radius: var(--np-radius-lg);\n  --np-attachment-media-size: 2rem;\n  --np-attachment-icon-size: 1rem;\n}\n\n:is(.np-attachment-xs, [data-size=\"xs\"]):is(\n  .np-attachment,\n  [data-np-attachment]\n) {\n  --np-attachment-padding: calc(var(--np-spacing) * 1);\n  --np-attachment-gap: calc(var(--np-spacing) * 2);\n  --np-attachment-radius: var(--np-radius-md);\n  --np-attachment-font-size: 0.75rem;\n  --np-attachment-media-size: 1.5rem;\n  --np-attachment-icon-size: 0.875rem;\n}\n\n:is(.np-attachment-vertical, [data-orientation=\"vertical\"]):is(\n  .np-attachment,\n  [data-np-attachment]\n) {\n  flex-direction: column;\n  align-items: stretch;\n}\n\n:is(.np-attachment-idle, [data-state=\"idle\"]):is(\n  .np-attachment,\n  [data-np-attachment]\n) {\n  --np-attachment-border-color: color-mix(\n    in oklab,\n    var(--np-muted-foreground) 50%,\n    transparent\n  );\n\n  border-style: dashed;\n}\n\n:is(.np-attachment-error, [data-state=\"error\"]):is(\n  .np-attachment,\n  [data-np-attachment]\n) {\n  --np-attachment-bg: color-mix(\n    in oklab,\n    var(--np-destructive) 5%,\n    var(--np-background)\n  );\n  --np-attachment-border-color: color-mix(\n    in oklab,\n    var(--np-destructive) 40%,\n    transparent\n  );\n  --np-attachment-media-bg: color-mix(\n    in oklab,\n    var(--np-destructive) 10%,\n    transparent\n  );\n  --np-attachment-media-color: var(--np-destructive);\n  --np-attachment-description-color: var(--np-destructive);\n}\n\n:is(.np-attachment-uploading, [data-state=\"uploading\"]):is(\n    .np-attachment,\n    [data-np-attachment]\n  )::after {\n  content: \"\";\n  position: absolute;\n  inset-inline: calc(var(--np-spacing) * 3);\n  inset-block-end: calc(var(--np-spacing) * 1);\n  height: 2px;\n  border-radius: 9999px;\n  background:\n    linear-gradient(var(--np-primary), var(--np-primary)) 0 0 /\n      var(--np-attachment-progress) 100% no-repeat,\n    var(--np-muted);\n  pointer-events: none;\n}\n\n:is(.np-attachment-uploading, [data-state=\"uploading\"]):is(\n    .np-attachment,\n    [data-np-attachment]\n  ):dir(rtl)::after {\n  background-position:\n    100% 0,\n    0 0;\n}\n\n:is(.np-attachment-uploading, [data-state=\"uploading\"]):is(\n  .np-attachment,\n  [data-np-attachment]\n) {\n  padding-block-end: calc(var(--np-attachment-padding) + var(--np-spacing) * 1);\n}\n\n.np-attachment-media,\n[data-np-attachment-media] {\n  box-sizing: border-box;\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  width: var(--np-attachment-media-size);\n  height: var(--np-attachment-media-size);\n  overflow: hidden;\n  border-radius: var(--np-radius-md);\n  background-color: var(--np-attachment-media-bg);\n  color: var(--np-attachment-media-color);\n}\n\n:is(.np-attachment-media, [data-np-attachment-media]) svg {\n  flex: none;\n  width: var(--np-attachment-icon-size);\n  height: var(--np-attachment-icon-size);\n}\n\n:is(.np-attachment-media-image, [data-variant=\"image\"]):is(\n  .np-attachment-media,\n  [data-np-attachment-media]\n) {\n  background-color: var(--np-muted);\n}\n\n:is(.np-attachment-media, [data-np-attachment-media]) img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n:is(.np-attachment-vertical, [data-orientation=\"vertical\"]):is(\n    .np-attachment,\n    [data-np-attachment]\n  )\n  > :is(.np-attachment-media-image, [data-variant=\"image\"]):is(\n    .np-attachment-media,\n    [data-np-attachment-media]\n  ) {\n  width: 100%;\n  height: auto;\n  aspect-ratio: 4 / 3;\n}\n\n:is(.np-attachment-vertical, [data-orientation=\"vertical\"]):is(\n    .np-attachment,\n    [data-np-attachment]\n  )\n  > :is(.np-attachment-media, [data-np-attachment-media]):not(\n    :is(.np-attachment-media-image, [data-variant=\"image\"])\n  ) {\n  align-self: flex-start;\n}\n\n.np-attachment-content,\n[data-np-attachment-content] {\n  box-sizing: border-box;\n  display: flex;\n  flex: 1 1 0%;\n  flex-direction: column;\n  gap: calc(var(--np-spacing) * 0.5);\n  min-width: 0;\n}\n\n.np-attachment-title,\n[data-np-attachment-title] {\n  overflow: hidden;\n  font-weight: 500;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.np-attachment-description,\n[data-np-attachment-description] {\n  overflow: hidden;\n  color: var(--np-attachment-description-color);\n  font-size: 0.75rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n:is(\n    .np-attachment-uploading,\n    .np-attachment-processing,\n    [data-state=\"uploading\"],\n    [data-state=\"processing\"]\n  ):is(.np-attachment, [data-np-attachment])\n  :is(.np-attachment-title, [data-np-attachment-title]) {\n  background-image: linear-gradient(\n    110deg,\n    var(--np-muted-foreground) 35%,\n    var(--np-foreground) 50%,\n    var(--np-muted-foreground) 65%\n  );\n  background-size: 250% 100%;\n  background-clip: text;\n  -webkit-background-clip: text;\n  color: transparent;\n  animation: np-attachment-shimmer 2s linear infinite;\n}\n\n@keyframes np-attachment-shimmer {\n  from {\n    background-position: 100% 0;\n  }\n\n  to {\n    background-position: 0 0;\n  }\n}\n\n.np-attachment-actions,\n[data-np-attachment-actions] {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex: none;\n  align-items: center;\n  gap: calc(var(--np-spacing) * 1);\n  margin-inline-start: auto;\n}\n\n:is(.np-attachment-vertical, [data-orientation=\"vertical\"]):is(\n    .np-attachment,\n    [data-np-attachment]\n  )\n  > :is(.np-attachment-actions, [data-np-attachment-actions]) {\n  position: absolute;\n  inset-block-start: calc(var(--np-spacing) * 3);\n  inset-inline-end: calc(var(--np-spacing) * 3);\n  margin-inline-start: 0;\n}\n\n:is(.np-attachment-action, [data-np-attachment-action]) {\n  position: relative;\n  z-index: 1;\n}\n\n.np-attachment-trigger,\n[data-np-attachment-trigger] {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  box-sizing: border-box;\n  display: block;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: inherit;\n  outline: none;\n  background: transparent;\n  color: inherit;\n  cursor: pointer;\n}\n\n@property --np-attachment-fade-start {\n  syntax: \"<length>\";\n  inherits: false;\n  initial-value: 0px;\n}\n\n@property --np-attachment-fade-end {\n  syntax: \"<length>\";\n  inherits: false;\n  initial-value: 0px;\n}\n\n.np-attachment-group,\n[data-np-attachment-group] {\n  --np-attachment-group-gap: calc(var(--np-spacing) * 2);\n  --np-attachment-group-item-width: 16rem;\n\n  box-sizing: border-box;\n  display: flex;\n  gap: var(--np-attachment-group-gap);\n  margin: -0.25rem;\n  padding: 0.25rem;\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  scroll-snap-type: x proximity;\n  scrollbar-width: none;\n}\n\n:is(.np-attachment-group, [data-np-attachment-group])::-webkit-scrollbar {\n  display: none;\n}\n\n:is(.np-attachment-group, [data-np-attachment-group])\n  > :is(.np-attachment, [data-np-attachment]) {\n  flex: 0 0 min(var(--np-attachment-group-item-width), 85%);\n  scroll-snap-align: start;\n}\n\n@supports (animation-timeline: scroll()) {\n  :is(.np-attachment-group, [data-np-attachment-group]) {\n    animation: np-attachment-fade linear both;\n    animation-timeline: scroll(self inline);\n    mask-image: linear-gradient(\n      to right,\n      transparent 0,\n      #000 var(--np-attachment-fade-start),\n      #000 calc(100% - var(--np-attachment-fade-end)),\n      transparent 100%\n    );\n  }\n\n  :is(.np-attachment-group, [data-np-attachment-group]):dir(rtl) {\n    mask-image: linear-gradient(\n      to left,\n      transparent 0,\n      #000 var(--np-attachment-fade-start),\n      #000 calc(100% - var(--np-attachment-fade-end)),\n      transparent 100%\n    );\n  }\n}\n\n@keyframes np-attachment-fade {\n  0% {\n    --np-attachment-fade-start: 0px;\n    --np-attachment-fade-end: 2rem;\n  }\n\n  5% {\n    --np-attachment-fade-start: 2rem;\n  }\n\n  95% {\n    --np-attachment-fade-end: 2rem;\n  }\n\n  100% {\n    --np-attachment-fade-start: 2rem;\n    --np-attachment-fade-end: 0px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :is(\n      .np-attachment-uploading,\n      .np-attachment-processing,\n      [data-state=\"uploading\"],\n      [data-state=\"processing\"]\n    ):is(.np-attachment, [data-np-attachment])\n    :is(.np-attachment-title, [data-np-attachment-title]) {\n    background-image: none;\n    color: var(--np-foreground);\n    animation: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/attachment.css"
    }
  ],
  "type": "registry:ui"
}
