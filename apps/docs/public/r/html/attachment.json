button-icon-xs np-attachment-action\"\n                aria-label=\"Remove mountains.jpg\"\n              >\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  width=\"24\"\n                  height=\"24\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M18 6 6 18\" />\n                  <path d=\"m6 6 12 12\" />\n                </svg>\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>States</h2>\n        <p>\n          idle, uploading (with <code>--np-attachment-progress</code>),\n          processing, error, done.\n        </p>\n        <div style=\"width: 100%; max-width: 24rem; display: grid; gap: 0.75rem\">\n          <div class=\"np-attachment np-attachment-idle\">\n            <div class=\"np-attachment-media\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                <polyline points=\"17 8 12 3 7 8\" />\n                <line x1=\"12\" x2=\"12\" y1=\"3\" y2=\"15\" />\n              </svg>\n            </div>\n            <div class=\"np-attachment-content\">\n              <div class=\"np-attachment-title\">invoice.pdf</div>\n              <div class=\"np-attachment-description\">Ready to upload</div>\n      