{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "item",
  "title": "Item",
  "description": "A versatile component for displaying content with media, title, description, and actions.",
  "registryDependencies": ["https://nepui.vercel.app/r/html/separator.json"],
  "files": [
    {
      "path": "registry/html/item/item.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Item</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/separator.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/avatar.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/item.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: var(--np-font-sans, system-ui, sans-serif);\n      }\n      main {\n        display: flex;\n        flex-direction: column;\n        gap: 2.5rem;\n        max-width: 40rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 0 0 0.25rem;\n        font-size: 0.875rem;\n        font-weight: 600;\n      }\n      .hint {\n        margin: 0 0 0.75rem;\n        font-size: 0.8125rem;\n        color: var(--np-muted-foreground);\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <p class=\"hint\">\n          <code>np-item</code> with media, content and actions.\n        </p>\n        <div style=\"width: 100%; max-width: 28rem\">\n          <div class=\"np-item np-item-outline\">\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Basic Item</div>\n              <p class=\"np-item-description\">\n                A simple item with title and description.\n              </p>\n            </div>\n            <div class=\"np-item-actions\">\n              <button\n                class=\"np-button np-button-outline np-button-sm\"\n                type=\"button\"\n              >\n                Action\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <p class=\"hint\"><code>data-np-item</code>, no classes.</p>\n        <div data-np-item data-variant=\"outline\" style=\"max-width: 28rem\">\n          <div data-np-item-media data-variant=\"icon\">\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n              <path\n                d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"\n              />\n            </svg>\n          </div>\n          <div data-np-item-content>\n            <div data-np-item-title>Data-attribute form</div>\n            <p data-np-item-description>\n              Same look with <code>data-np-item-*</code> and\n              <code>data-variant</code>.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Variants</h2>\n        <p class=\"hint\">\n          Default, <code>np-item-outline</code> and <code>np-item-muted</code>,\n          or <code>data-variant</code>.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            width: 100%;\n            max-width: 28rem;\n            flex-direction: column;\n            gap: 1rem;\n          \"\n        >\n          <div class=\"np-item\">\n            <div class=\"np-item-media np-item-media-icon\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n                <path\n                  d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"\n                />\n              </svg>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Default Variant</div>\n              <p class=\"np-item-description\">\n                Transparent background with no border.\n              </p>\n            </div>\n          </div>\n          <div class=\"np-item np-item-outline\">\n            <div class=\"np-item-media np-item-media-icon\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n                <path\n                  d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"\n                />\n              </svg>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Outline Variant</div>\n              <p class=\"np-item-description\">\n                Outlined style with a visible border.\n              </p>\n            </div>\n          </div>\n          <div class=\"np-item np-item-muted\">\n            <div class=\"np-item-media np-item-media-icon\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n                <path\n                  d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"\n                />\n              </svg>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Muted Variant</div>\n              <p class=\"np-item-description\">\n                Muted background for secondary content.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Sizes</h2>\n        <p class=\"hint\">\n          Default, <code>np-item-sm</code> and <code>np-item-xs</code>, or\n          <code>data-size</code>.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            width: 100%;\n            max-width: 28rem;\n            flex-direction: column;\n            gap: 1rem;\n          \"\n        >\n          <div class=\"np-item np-item-outline\">\n            <div class=\"np-item-media np-item-media-icon\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n                <path\n                  d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"\n                />\n              </svg>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Default Size</div>\n              <p class=\"np-item-description\">\n                The standard size for most use cases.\n              </p>\n            </div>\n          </div>\n          <div class=\"np-item np-item-outline np-item-sm\">\n            <div class=\"np-item-media np-item-media-icon\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n                <path\n                  d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"\n                />\n              </svg>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Small Size</div>\n              <p class=\"np-item-description\">\n                A compact size for dense layouts.\n              </p>\n            </div>\n          </div>\n          <div class=\"np-item np-item-outline np-item-xs\">\n            <div class=\"np-item-media np-item-media-icon\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n                <path\n                  d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"\n                />\n              </svg>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Extra Small Size</div>\n              <p class=\"np-item-description\">\n                The most compact size available.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Media</h2>\n        <p class=\"hint\">Icon, image and avatar.</p>\n        <div style=\"width: 100%; max-width: 28rem\">\n          <div class=\"np-item np-item-outline\">\n            <div class=\"np-item-media np-item-media-icon\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"\n                />\n                <path d=\"M12 8v4\" />\n                <path d=\"M12 16h.01\" />\n              </svg>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Security Alert</div>\n              <p class=\"np-item-description\">\n                New login detected from unknown device.\n              </p>\n            </div>\n            <div class=\"np-item-actions\">\n              <button\n                class=\"np-button np-button-outline np-button-sm\"\n                type=\"button\"\n              >\n                Review\n              </button>\n            </div>\n          </div>\n        </div>\n        <div style=\"height: 1rem\"></div>\n        <div\n          style=\"\n            display: flex;\n            width: 100%;\n            max-width: 28rem;\n            flex-direction: column;\n            gap: 1rem;\n          \"\n        >\n          <div class=\"np-item np-item-outline\">\n            <div class=\"np-item-media\">\n              <span class=\"np-avatar np-avatar-lg\">\n                <img\n                  class=\"np-avatar-image\"\n                  src=\"https://github.com/akkaldhami.png\"\n                  alt=\"Akkal Dhami\"\n                  onerror=\"this.hidden = true\"\n                />\n                <span class=\"np-avatar-fallback\">AD</span>\n              </span>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Akkal Dhami</div>\n              <p class=\"np-item-description\">Last seen 5 months ago</p>\n            </div>\n            <div class=\"np-item-actions\">\n              <button\n                class=\"np-button np-button-outline np-button-icon-sm\"\n                type=\"button\"\n                aria-label=\"Invite\"\n              >\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M5 12h14\" />\n                  <path d=\"M12 5v14\" />\n                </svg>\n              </button>\n            </div>\n          </div>\n          <div class=\"np-item np-item-outline\">\n            <div class=\"np-item-media\">\n              <div class=\"np-avatar-group\">\n                <span class=\"np-avatar\">\n                  <img\n                    class=\"np-avatar-image\"\n                    src=\"https://github.com/akkaldhami.png\"\n                    alt=\"@akkaldhami\"\n                    onerror=\"this.hidden = true\"\n                  />\n                  <span class=\"np-avatar-fallback\">AD</span>\n                </span>\n                <span class=\"np-avatar\">\n                  <img\n                    class=\"np-avatar-image\"\n                    src=\"https://github.com/pratapchaulagain.png\"\n                    alt=\"@pratapchaulagain\"\n                    onerror=\"this.hidden = true\"\n                  />\n                  <span class=\"np-avatar-fallback\">PC</span>\n                </span>\n                <span class=\"np-avatar\">\n                  <img\n                    class=\"np-avatar-image\"\n                    src=\"https://github.com/manisbhusal.png\"\n                    alt=\"@manisbhusal\"\n                    onerror=\"this.hidden = true\"\n                  />\n                  <span class=\"np-avatar-fallback\">MB</span>\n                </span>\n              </div>\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">No Team Members</div>\n              <p class=\"np-item-description\">\n                Invite your team to collaborate on this project.\n              </p>\n            </div>\n            <div class=\"np-item-actions\">\n              <button\n                class=\"np-button np-button-outline np-button-sm\"\n                type=\"button\"\n              >\n                Invite\n              </button>\n            </div>\n          </div>\n        </div>\n        <div style=\"height: 1rem\"></div>\n        <div style=\"width: 100%; max-width: 28rem\">\n          <div class=\"np-item-group\">\n            <a class=\"np-item np-item-outline\" href=\"#\">\n              <div class=\"np-item-media np-item-media-image\">\n                <img\n                  alt=\"\"\n                  src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 4'><rect width='4' height='4' fill='%23a1a1aa'/><circle cx='2' cy='2' r='1' fill='%23fafafa' fill-opacity='.7'/></svg>\"\n                />\n              </div>\n              <div class=\"np-item-content\">\n                <div class=\"np-item-title\">Midnight City Lights</div>\n                <p class=\"np-item-description\">Electric Nights - Neon Dreams</p>\n              </div>\n              <div class=\"np-item-content\" style=\"flex: none; text-align: end\">\n                <p class=\"np-item-description\">3:45</p>\n              </div>\n            </a>\n            <a class=\"np-item np-item-outline\" href=\"#\">\n              <div class=\"np-item-media np-item-media-image\">\n                <img\n                  alt=\"\"\n                  src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 4'><rect width='4' height='4' fill='%2394a3b8'/><circle cx='2' cy='2' r='1' fill='%23fafafa' fill-opacity='.7'/></svg>\"\n                />\n              </div>\n              <div class=\"np-item-content\">\n                <div class=\"np-item-title\">Coffee Shop Conversations</div>\n                <p class=\"np-item-description\">\n                  Urban Stories - The Morning Brew\n                </p>\n              </div>\n              <div class=\"np-item-content\" style=\"flex: none; text-align: end\">\n                <p class=\"np-item-description\">4:05</p>\n              </div>\n            </a>\n            <a class=\"np-item np-item-outline\" href=\"#\">\n              <div class=\"np-item-media np-item-media-image\">\n                <img\n                  alt=\"\"\n                  src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 4'><rect width='4' height='4' fill='%2386efac'/><circle cx='2' cy='2' r='1' fill='%23fafafa' fill-opacity='.7'/></svg>\"\n                />\n              </div>\n              <div class=\"np-item-content\">\n                <div class=\"np-item-title\">Digital Rain</div>\n                <p class=\"np-item-description\">Binary Beats - Cyber Symphony</p>\n              </div>\n              <div class=\"np-item-content\" style=\"flex: none; text-align: end\">\n                <p class=\"np-item-description\">3:30</p>\n              </div>\n            </a>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Group</h2>\n        <p class=\"hint\">\n          <code>np-item-group</code> with\n          <code>np-separator np-item-separator</code> between items.\n        </p>\n        <div style=\"width: 100%; max-width: 28rem\">\n          <div class=\"np-item-group\" role=\"list\">\n            <div class=\"np-item\" role=\"listitem\">\n              <div class=\"np-item-media\">\n                <span class=\"np-avatar\">\n                  <img\n                    class=\"np-avatar-image\"\n                    src=\"https://github.com/akkaldhami.png\"\n                    alt=\"Akkal Dhami\"\n                    onerror=\"this.hidden = true\"\n                  />\n                  <span class=\"np-avatar-fallback\">AD</span>\n                </span>\n              </div>\n              <div class=\"np-item-content\">\n                <div class=\"np-item-title\">Akkal Dhami</div>\n                <p class=\"np-item-description\">@akkaldhami</p>\n              </div>\n              <div class=\"np-item-actions\">\n                <button\n                  class=\"np-button np-button-ghost np-button-icon-sm\"\n                  type=\"button\"\n                  aria-label=\"Add akkaldhami\"\n                >\n                  <svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    aria-hidden=\"true\"\n                  >\n                    <path d=\"M5 12h14\" />\n                    <path d=\"M12 5v14\" />\n                  </svg>\n                </button>\n              </div>\n            </div>\n            <div class=\"np-separator np-item-separator\" role=\"separator\"></div>\n            <div class=\"np-item\" role=\"listitem\">\n              <div class=\"np-item-media\">\n                <span class=\"np-avatar\">\n                  <img\n                    class=\"np-avatar-image\"\n                    src=\"https://github.com/pratapchaulagain.png\"\n                    alt=\"pratapchaulagain\"\n                    onerror=\"this.hidden = true\"\n                  />\n                  <span class=\"np-avatar-fallback\">PC</span>\n                </span>\n              </div>\n              <div class=\"np-item-content\">\n                <div class=\"np-item-title\">pratapchaulagain</div>\n                <p class=\"np-item-description\">@pratapchaulagain</p>\n              </div>\n              <div class=\"np-item-actions\">\n                <button\n                  class=\"np-button np-button-ghost np-button-icon-sm\"\n                  type=\"button\"\n                  aria-label=\"Add pratapchaulagain\"\n                >\n                  <svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    aria-hidden=\"true\"\n                  >\n                    <path d=\"M5 12h14\" />\n                    <path d=\"M12 5v14\" />\n                  </svg>\n                </button>\n              </div>\n            </div>\n            <div class=\"np-separator np-item-separator\" role=\"separator\"></div>\n            <div class=\"np-item\" role=\"listitem\">\n              <div class=\"np-item-media\">\n                <span class=\"np-avatar\">\n                  <img\n                    class=\"np-avatar-image\"\n                    src=\"https://github.com/manisbhusal.png\"\n                    alt=\"manisbhusal\"\n                    onerror=\"this.hidden = true\"\n                  />\n                  <span class=\"np-avatar-fallback\">MB</span>\n                </span>\n              </div>\n              <div class=\"np-item-content\">\n                <div class=\"np-item-title\">manisbhusal</div>\n                <p class=\"np-item-description\">@manisbhusal</p>\n              </div>\n              <div class=\"np-item-actions\">\n                <button\n                  class=\"np-button np-button-ghost np-button-icon-sm\"\n                  type=\"button\"\n                  aria-label=\"Add manisbhusal\"\n                >\n                  <svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    aria-hidden=\"true\"\n                  >\n                    <path d=\"M5 12h14\" />\n                    <path d=\"M12 5v14\" />\n                  </svg>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Header and footer</h2>\n        <p class=\"hint\">Full-width rows above and below the content.</p>\n        <div\n          class=\"np-item-group\"\n          role=\"list\"\n          style=\"\n            display: grid;\n            grid-template-columns: repeat(3, minmax(0, 1fr));\n            width: 100%;\n            max-width: 36rem;\n            gap: 1rem;\n          \"\n        >\n          <div class=\"np-item np-item-outline\" role=\"listitem\">\n            <div class=\"np-item-header\">\n              <img\n                alt=\"v0-1.5-sm\"\n                src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 4'><rect width='4' height='4' fill='%23a1a1aa'/><circle cx='2' cy='2' r='1' fill='%23fafafa' fill-opacity='.7'/></svg>\"\n                style=\"\n                  width: 100%;\n                  aspect-ratio: 1;\n                  border-radius: var(--np-radius-sm);\n                  object-fit: cover;\n                \"\n              />\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">v0-1.5-sm</div>\n              <p class=\"np-item-description\">\n                Everyday tasks and UI generation.\n              </p>\n            </div>\n            <div class=\"np-item-footer\">Fast</div>\n          </div>\n          <div class=\"np-item np-item-outline\" role=\"listitem\">\n            <div class=\"np-item-header\">\n              <img\n                alt=\"v0-1.5-lg\"\n                src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 4'><rect width='4' height='4' fill='%2394a3b8'/><circle cx='2' cy='2' r='1' fill='%23fafafa' fill-opacity='.7'/></svg>\"\n                style=\"\n                  width: 100%;\n                  aspect-ratio: 1;\n                  border-radius: var(--np-radius-sm);\n                  object-fit: cover;\n                \"\n              />\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">v0-1.5-lg</div>\n              <p class=\"np-item-description\">Advanced thinking or reasoning.</p>\n            </div>\n            <div class=\"np-item-footer\">Thorough</div>\n          </div>\n          <div class=\"np-item np-item-outline\" role=\"listitem\">\n            <div class=\"np-item-header\">\n              <img\n                alt=\"v0-2.0-mini\"\n                src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 4'><rect width='4' height='4' fill='%2386efac'/><circle cx='2' cy='2' r='1' fill='%23fafafa' fill-opacity='.7'/></svg>\"\n                style=\"\n                  width: 100%;\n                  aspect-ratio: 1;\n                  border-radius: var(--np-radius-sm);\n                  object-fit: cover;\n                \"\n              />\n            </div>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">v0-2.0-mini</div>\n              <p class=\"np-item-description\">Open Source model for everyone.</p>\n            </div>\n            <div class=\"np-item-footer\">Open</div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Link</h2>\n        <p class=\"hint\">\n          Make the item an <code>a</code>, or a <code>button</code>.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            width: 100%;\n            max-width: 28rem;\n            flex-direction: column;\n            gap: 1rem;\n          \"\n        >\n          <a class=\"np-item\" href=\"#\">\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Visit our documentation</div>\n              <p class=\"np-item-description\">\n                Learn how to get started with our components.\n              </p>\n            </div>\n            <div class=\"np-item-actions\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"m9 18 6-6-6-6\" />\n              </svg>\n            </div>\n          </a>\n          <a\n            class=\"np-item np-item-outline\"\n            href=\"#\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n          >\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">External resource</div>\n              <p class=\"np-item-description\">\n                Opens in a new tab with security attributes.\n              </p>\n            </div>\n            <div class=\"np-item-actions\">\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M15 3h6v6\" />\n                <path d=\"M10 14 21 3\" />\n                <path\n                  d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"\n                />\n              </svg>\n            </div>\n          </a>\n        </div>\n      </section>\n\n      <section>\n        <h2>States</h2>\n        <p class=\"hint\">Selected, interactive and disabled.</p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n            max-width: 28rem;\n          \"\n        >\n          <div class=\"np-item np-item-outline\" aria-current=\"true\">\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Selected</div>\n              <p class=\"np-item-description\">\n                Use aria-current or data-selected.\n              </p>\n            </div>\n          </div>\n          <a class=\"np-item np-item-outline\" href=\"#\">\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Interactive</div>\n              <p class=\"np-item-description\">\n                A link or button gets hover and focus styles.\n              </p>\n            </div>\n          </a>\n          <button class=\"np-item np-item-outline\" type=\"button\" disabled>\n            <div class=\"np-item-content\">\n              <div class=\"np-item-title\">Disabled</div>\n              <p class=\"np-item-description\">Dimmed and not clickable.</p>\n            </div>\n          </button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
