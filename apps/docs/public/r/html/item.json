    {
      "path": "registry/html/item/item.css",
      "content": "/* nepui - Item */\n\n.np-item,\n[data-np-item] {\n  --np-item-gap: calc(var(--np-spacing) * 3);\n  --np-item-padding-x: calc(var(--np-spacing) * 4);\n  --np-item-padding-y: calc(var(--np-spacing) * 3);\n  --np-item-radius: var(--np-radius-md);\n  --np-item-bg: transparent;\n  --np-item-border: transparent;\n  --np-item-hover-bg: var(--np-muted);\n  --np-item-description-color: var(--np-muted-foreground);\n  --np-item-description-lines: 2;\n  --np-item-description-size: 0.875rem;\n  --np-item-content-gap: calc(var(--np-spacing) * 1);\n  --np-item-media-image-size: calc(var(--np-spacing) * 10);\n  --np-item-media-icon-size: calc(var(--np-spacing) * 8);\n  --np-item-media-icon-glyph: 1rem;\n  --np-item-media-bg: var(--np-muted);\n  --np-item-media-border: var(--np-border);\n  --np-item-media-radius: var(--np-radius-sm);\n\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  box-sizing: border-box;\n  width: 100%;\n  margin: 0;\n  gap: var(--np-item-gap);\n  padding: var(--np-item-padding-y) var(--np-item-padding-x);\n  border: 1px solid var(--np-item-border);\n  border-radius: var(--np-item-radius);\n  background-color: var(--np-item-bg);\n  color: inherit;\n  font-family: inherit;\n  font-size: 0.875rem;\n  line-height: calc(1.25 / 0.875);\n  text-align: start;\n  text-decoration: none;\n  appearance: none;\n  outline: none;\n  transition:\n    background-color 150ms ease,\n    border-color 150ms ease,\n    box-shadow 150ms ease;\n}\n\n.np-item-outline,\n:is(.np-item, [data-np-item])[data-variant=\"outline\"] {\n  --np-item-border: var(--np-border);\n}\n\n.np-item-muted,\n:is(.np-item, [data-np-item])[data-variant=\"muted\"] {\n  --np-item-bg: color-mix(in oklab, var(--np-muted) 50%, transparent);\n}\n\n.np-item-sm,\n:is(.np-item, [data-np-item])[data-size=\"sm\"] {\n  --np-item-gap: calc(var(--np-spacing) * 2.5);\n  --np-item-padding-x: calc(var(--np-spacing) * 3);\n  --np-item-padding-y: calc(var(--np-spacing) * 2.5);\n  --np-item-media-image-size: calc(var(--np-spacing) * 8);\n}\n\n.np-item-xs,\n:is(.np-item, [data-np-item])[data-size=\"xs\"] {\n  --np-item-gap: calc(var(--np-spacing) * 2);\n  --np-item-padding-x: calc(var(--np-spacing) * 2.5);\n  --np-item-padding-y: calc(var(--np-spacing) * 1.5);\n  --np-item-content-gap: 0px;\n  --np-item-description-size: 0.75rem;\n  --np-item-media-image-size: calc(var(--np-spacing) * 6);\n}\n\n:is(.np-item, [data-np-item]):is(\n  [aria-current]:not([aria-current=\"false\"]),\n  [data-selected]\n) {\n  background-color: var(--np-item-hover-bg);\n}\n\n:is(a, button, [role=\"button\"], [data-interactive]):is(\n  .np-item,\n  [data-np-item]\n) {\n  cursor: pointer;\n}\n\n:is(a, button, [role=\"button\"], [data-interactive]):is(\n    .np-item,\n    [data-np-item]\n  ):hover {\n  background-color: var(--np-item-hover-bg);\n}\n\n:is(.np-item, [data-np-item]):focus-visible {\n  border-color: var(--np-ring);\n  box-shadow: 0 0 0 3px color-mix(in oklch, var(--np-ring), transparent 50%);\n}\n\n:is(.np-item, [data-np-item]):is(\n  :disabled,\n  [aria-disabled=\"true\"],\n  [data-disabled]\n) {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.np-item-group,\n[data-np-item-group] {\n  --np-item-group-gap: calc(var(--np-spacing) * 4);\n\n  display: flex;\n  flex-direction: column;\n  box-sizing: border-box;\n  width: 100%;\n  margin: 0;\n  padding: 0;\n  gap: var(--np-item-group-gap);\n  list-style: none;\n}\n\n:is(.np-item-group, [data-np-item-group]):has(\n  > :is(.np-item-sm, :is(.np-item, [data-np-item])[data-size=\"sm\"])\n) {\n  --np-item-group-gap: calc(var(--np-spacing) * 2.5);\n}\n\n:is(.np-item-group, [data-np-item-group]):has(\n  > :is(.np-item-xs, :is(.np-item, [data-np-item])[data-size=\"xs\"])\n) {\n  --np-item-group-gap: calc(var(--np-spacing) * 2);\n}\n\n.np-item-separator,\n[data-np-item-separator] {\n  margin-block: calc(var(--np-spacing) * 2);\n}\n\n.np-item-media,\n[data-np-item-media] {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  gap: calc(var(--np-spacing) * 2);\n}\n\n:is(.np-item-media, [data-np-item-media]) svg {\n  pointer-events: none;\n}\n\n:is(.np-item, [data-np-item]):has(\n    .np-item-description,\n    [data-np-item-description]\n  )\n  > :is(.np-item-media, [data-np-item-media]) {\n  align-self: flex-start;\n  transform: translateY(calc(var(--np-spacing) * 0.5));\n}\n\n.np-item-media-icon,\n:is(.np-item-media, [data-np-item-media])[data-variant=\"icon\"] {\n  box-sizing: border-box;\n  width: var(--np-item-media-icon-size);\n  height: var(--np-item-media-icon-size);\n  border: 1px solid var(--np-item-media-border);\n  border-radius: var(--np-item-media-radius);\n  background-color: var(--np-item-media-bg);\n}\n\n:is(\n    .np-item-media-icon,\n    :is(.np-item-media, [data-np-item-media])[data-variant=\"icon\"]\n  )\n  svg:not([class*=\"size-\"]) {\n  width: var(--np-item-media-icon-glyph);\n  height: var(--np-item-media-icon-glyph);\n}\n\n.np-item-media-image,\n:is(.np-item-media, [data-np-item-media])[data-variant=\"image\"] {\n  width: var(--np-item-media-image-size);\n  height: var(--np-item-media-image-size);\n  border-radius: var(--np-item-media-radius);\n  overflow: hidden;\n}\n\n:is(\n    .np-item-media-image,\n    :is(.np-item-media, [data-np-item-media])[data-variant=\"image\"]\n  )\n  img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.np-item-content,\n[data-np-item-content] {\n  display: flex;\n  flex: 1 1 0%;\n  flex-direction: column;\n  min-width: 0;\n  gap: var(--np-item-content-gap);\n}\n\n:is(.np-item-content, [data-np-item-content])\n  + :is(.np-item-content, [data-np-item-content]) {\n  flex: none;\n}\n\n.np-item-title,\n[data-np-item-title] {\n  display: flex;\n  align-items: center;\n  width: fit-content;\n  max-width: 100%;\n  gap: calc(var(--np-spacing) * 2);\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1.375;\n  text-underline-offset: 4px;\n}\n\n.np-item-description,\n[data-np-item-description] {\n  display: -webkit-box;\n  margin: 0;\n  overflow: hidden;\n  color: var(--np-item-description-color);\n  font-size: var(--np-item-description-size);\n  font-weight: 400;\n  line-height: 1.5;\n  text-align: start;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: var(--np-item-description-lines);\n  line-clamp: var(--np-item-description-lines);\n}\n\n:is(.np-item-description, [data-np-item-description]) > a {\n  text-decoration: underline;\n  text-underline-offset: 4px;\n}\n\n:is(.np-item-description, [data-np-item-description]) > a:hover {\n  color: var(--np-primary);\n}\n\n.np-item-actions,\n[data-np-item-actions] {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: calc(var(--np-spacing) * 2);\n}\n\n.np-item-header,\n[data-np-item-header],\n.np-item-footer,\n[data-np-item-footer] {\n  display: flex;\n  flex-basis: 100%;\n  align-items: center;\n  justify-content: space-between;\n  gap: calc(var(--np-spacing) * 2);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .np-item,\n  [data-np-item] {\n    transition: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/item.css"
    }
  ],
  "type": "registry:ui"
}
