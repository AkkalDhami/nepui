{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "table",
  "title": "Table",
  "description": "A responsive table component.",
  "files": [
    {
      "path": "registry/html/table/table.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Table</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/badge.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/checkbox.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/table.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        display: grid;\n        gap: 2.5rem;\n        max-width: 44rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 0 0 0.75rem;\n        font-size: 1rem;\n      }\n      p {\n        margin: 0 0 0.75rem;\n        color: var(--np-muted-foreground);\n        font-size: 0.875rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <div class=\"np-table-container\">\n          <table class=\"np-table\">\n            <caption class=\"np-table-caption\">\n              A list of your recent invoices.\n            </caption>\n            <thead class=\"np-table-header\">\n              <tr class=\"np-table-row\">\n                <th class=\"np-table-head\" scope=\"col\" style=\"width: 6.25rem\">\n                  Invoice\n                </th>\n                <th class=\"np-table-head\" scope=\"col\">Status</th>\n                <th class=\"np-table-head\" scope=\"col\">Method</th>\n                <th class=\"np-table-head np-table-end\" scope=\"col\">Amount</th>\n              </tr>\n            </thead>\n            <tbody class=\"np-table-body\">\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">INV001</td>\n                <td class=\"np-table-cell\">Paid</td>\n                <td class=\"np-table-cell\">Credit Card</td>\n                <td class=\"np-table-cell np-table-end\">$250.00</td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">INV002</td>\n                <td class=\"np-table-cell\">Pending</td>\n                <td class=\"np-table-cell\">PayPal</td>\n                <td class=\"np-table-cell np-table-end\">$150.00</td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">INV003</td>\n                <td class=\"np-table-cell\">Unpaid</td>\n                <td class=\"np-table-cell\">Bank Transfer</td>\n                <td class=\"np-table-cell np-table-end\">$350.00</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <div data-np-table-container>\n          <table data-np-table>\n            <caption data-np-table-caption>\n              Same table, no classes.\n            </caption>\n            <thead data-np-table-header>\n              <tr data-np-table-row>\n                <th data-np-table-head scope=\"col\" style=\"width: 6.25rem\">\n                  Invoice\n                </th>\n                <th data-np-table-head scope=\"col\">Status</th>\n                <th data-np-table-head scope=\"col\">Method</th>\n                <th data-np-table-head data-align=\"end\" scope=\"col\">Amount</th>\n              </tr>\n            </thead>\n            <tbody data-np-table-body>\n              <tr data-np-table-row>\n                <td data-np-table-cell style=\"font-weight: 500\">INV001</td>\n                <td data-np-table-cell>Paid</td>\n                <td data-np-table-cell>Credit Card</td>\n                <td data-np-table-cell data-align=\"end\">$250.00</td>\n              </tr>\n              <tr data-np-table-row>\n                <td data-np-table-cell style=\"font-weight: 500\">INV002</td>\n                <td data-np-table-cell>Pending</td>\n                <td data-np-table-cell>PayPal</td>\n                <td data-np-table-cell data-align=\"end\">$150.00</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section>\n        <h2>Footer</h2>\n        <div class=\"np-table-container\">\n          <table class=\"np-table\">\n            <thead class=\"np-table-header\">\n              <tr class=\"np-table-row\">\n                <th class=\"np-table-head\" scope=\"col\">Invoice</th>\n                <th class=\"np-table-head\" scope=\"col\">Status</th>\n                <th class=\"np-table-head\" scope=\"col\">Method</th>\n                <th class=\"np-table-head np-table-end\" scope=\"col\">Amount</th>\n              </tr>\n            </thead>\n            <tbody class=\"np-table-body\">\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">INV001</td>\n                <td class=\"np-table-cell\">Paid</td>\n                <td class=\"np-table-cell\">Credit Card</td>\n                <td class=\"np-table-cell np-table-end\">$250.00</td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">INV002</td>\n                <td class=\"np-table-cell\">Pending</td>\n                <td class=\"np-table-cell\">PayPal</td>\n                <td class=\"np-table-cell np-table-end\">$150.00</td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">INV003</td>\n                <td class=\"np-table-cell\">Unpaid</td>\n                <td class=\"np-table-cell\">Bank Transfer</td>\n                <td class=\"np-table-cell np-table-end\">$350.00</td>\n              </tr>\n            </tbody>\n            <tfoot class=\"np-table-footer\">\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" colspan=\"3\">Total</td>\n                <td class=\"np-table-cell np-table-end\">$750.00</td>\n              </tr>\n            </tfoot>\n          </table>\n        </div>\n      </section>\n\n      <section>\n        <h2>Selected row</h2>\n        <p>\n          Add <code>data-state=\"selected\"</code> to a row. Hover the other rows\n          to see the hover background.\n        </p>\n        <div class=\"np-table-container\">\n          <table class=\"np-table\">\n            <thead class=\"np-table-header\">\n              <tr class=\"np-table-row\">\n                <th class=\"np-table-head\" scope=\"col\" style=\"width: 2rem\">\n                  <input\n                    type=\"checkbox\"\n                    class=\"np-checkbox\"\n                    aria-label=\"Select all products\"\n                  />\n                </th>\n                <th class=\"np-table-head\" scope=\"col\">Product</th>\n                <th class=\"np-table-head np-table-end\" scope=\"col\">Price</th>\n              </tr>\n            </thead>\n            <tbody class=\"np-table-body\">\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\">\n                  <input\n                    type=\"checkbox\"\n                    class=\"np-checkbox\"\n                    aria-label=\"Select Wireless Mouse\"\n                  />\n                </td>\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">\n                  Wireless Mouse\n                </td>\n                <td class=\"np-table-cell np-table-end\">$29.99</td>\n              </tr>\n              <tr class=\"np-table-row\" data-state=\"selected\">\n                <td class=\"np-table-cell\">\n                  <input\n                    type=\"checkbox\"\n                    class=\"np-checkbox\"\n                    aria-label=\"Select Mechanical Keyboard\"\n                    checked\n                  />\n                </td>\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">\n                  Mechanical Keyboard\n                </td>\n                <td class=\"np-table-cell np-table-end\">$129.99</td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\">\n                  <input\n                    type=\"checkbox\"\n                    class=\"np-checkbox\"\n                    aria-label=\"Select USB-C Hub\"\n                  />\n                </td>\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">\n                  USB-C Hub\n                </td>\n                <td class=\"np-table-cell np-table-end\">$49.99</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section>\n        <h2>Status and actions</h2>\n        <div class=\"np-table-container\">\n          <table class=\"np-table\">\n            <thead class=\"np-table-header\">\n              <tr class=\"np-table-row\">\n                <th class=\"np-table-head\" scope=\"col\">Product</th>\n                <th class=\"np-table-head\" scope=\"col\">Status</th>\n                <th class=\"np-table-head np-table-end\" scope=\"col\">Price</th>\n                <th\n                  class=\"np-table-head np-table-end\"\n                  scope=\"col\"\n                  style=\"width: 3rem\"\n                >\n                  <span\n                    style=\"\n                      position: absolute;\n                      width: 1px;\n                      height: 1px;\n                      overflow: hidden;\n                      clip: rect(0 0 0 0);\n                      white-space: nowrap;\n                    \"\n                    >Actions</span\n                  >\n                </th>\n              </tr>\n            </thead>\n            <tbody class=\"np-table-body\">\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">\n                  Wireless Mouse\n                </td>\n                <td class=\"np-table-cell\">\n                  <span\n                    class=\"np-badge\"\n                    data-variant=\"success\"\n                    data-appearance=\"light\"\n                    >In stock</span\n                  >\n                </td>\n                <td class=\"np-table-cell np-table-end\">$29.99</td>\n                <td class=\"np-table-cell np-table-end\">\n                  <button\n                    type=\"button\"\n                    class=\"np-button np-button-ghost np-button-icon-sm\"\n                    aria-label=\"Open menu for Wireless Mouse\"\n                  >\n                    <svg\n                      xmlns=\"http://www.w3.org/2000/svg\"\n                      width=\"24\"\n                      height=\"24\"\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"2\"\n                      stroke-linecap=\"round\"\n                      stroke-linejoin=\"round\"\n                      aria-hidden=\"true\"\n                    >\n                      <circle cx=\"12\" cy=\"12\" r=\"1\" />\n                      <circle cx=\"19\" cy=\"12\" r=\"1\" />\n                      <circle cx=\"5\" cy=\"12\" r=\"1\" />\n                    </svg>\n                  </button>\n                </td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">\n                  Mechanical Keyboard\n                </td>\n                <td class=\"np-table-cell\">\n                  <span\n                    class=\"np-badge\"\n                    data-variant=\"warning\"\n                    data-appearance=\"light\"\n                    >Low stock</span\n                  >\n                </td>\n                <td class=\"np-table-cell np-table-end\">$129.99</td>\n                <td class=\"np-table-cell np-table-end\">\n                  <button\n                    type=\"button\"\n                    class=\"np-button np-button-ghost np-button-icon-sm\"\n                    aria-label=\"Open menu for Mechanical Keyboard\"\n                  >\n                    <svg\n                      xmlns=\"http://www.w3.org/2000/svg\"\n                      width=\"24\"\n                      height=\"24\"\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"2\"\n                      stroke-linecap=\"round\"\n                      stroke-linejoin=\"round\"\n                      aria-hidden=\"true\"\n                    >\n                      <circle cx=\"12\" cy=\"12\" r=\"1\" />\n                      <circle cx=\"19\" cy=\"12\" r=\"1\" />\n                      <circle cx=\"5\" cy=\"12\" r=\"1\" />\n                    </svg>\n                  </button>\n                </td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\" style=\"font-weight: 500\">\n                  USB-C Hub\n                </td>\n                <td class=\"np-table-cell\">\n                  <span\n                    class=\"np-badge\"\n                    data-variant=\"destructive\"\n                    data-appearance=\"light\"\n                    >Out of stock</span\n                  >\n                </td>\n                <td class=\"np-table-cell np-table-end\">$49.99</td>\n                <td class=\"np-table-cell np-table-end\">\n                  <button\n                    type=\"button\"\n                    class=\"np-button np-button-ghost np-button-icon-sm\"\n                    aria-label=\"Open menu for USB-C Hub\"\n                  >\n                    <svg\n                      xmlns=\"http://www.w3.org/2000/svg\"\n                      width=\"24\"\n                      height=\"24\"\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"2\"\n                      stroke-linecap=\"round\"\n                      stroke-linejoin=\"round\"\n                      aria-hidden=\"true\"\n                    >\n                      <circle cx=\"12\" cy=\"12\" r=\"1\" />\n                      <circle cx=\"19\" cy=\"12\" r=\"1\" />\n                      <circle cx=\"5\" cy=\"12\" r=\"1\" />\n                    </svg>\n                  </button>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section>\n        <h2>Alignment</h2>\n        <div class=\"np-table-container\">\n          <table class=\"np-table\">\n            <thead class=\"np-table-header\">\n              <tr class=\"np-table-row\">\n                <th class=\"np-table-head\" scope=\"col\">Start (default)</th>\n                <th class=\"np-table-head np-table-center\" scope=\"col\">\n                  Center\n                </th>\n                <th class=\"np-table-head np-table-end\" scope=\"col\">End</th>\n              </tr>\n            </thead>\n            <tbody class=\"np-table-body\">\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\">Left</td>\n                <td class=\"np-table-cell np-table-center\">Middle</td>\n                <td class=\"np-table-cell np-table-end\">Right</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section>\n        <h2>Custom variables</h2>\n        <p>\n          Denser rows with <code>--np-table-cell-padding</code> and\n          <code>--np-table-head-height</code>, set on the table.\n        </p>\n        <div class=\"np-table-container\">\n          <table\n            class=\"np-table\"\n            style=\"\n              --np-table-cell-padding: 0.25rem 0.5rem;\n              --np-table-head-height: 2rem;\n            \"\n          >\n            <thead class=\"np-table-header\">\n              <tr class=\"np-table-row\">\n                <th class=\"np-table-head\" scope=\"col\">Invoice</th>\n                <th class=\"np-table-head\" scope=\"col\">Status</th>\n                <th class=\"np-table-head np-table-end\" scope=\"col\">Amount</th>\n              </tr>\n            </thead>\n            <tbody class=\"np-table-body\">\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\">INV001</td>\n                <td class=\"np-table-cell\">Paid</td>\n                <td class=\"np-table-cell np-table-end\">$250.00</td>\n              </tr>\n              <tr class=\"np-table-row\">\n                <td class=\"np-table-cell\">INV002</td>\n                <td class=\"np-table-cell\">Pending</td>\n                <td class=\"np-table-cell np-table-end\">$150.00</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/table.html"
    },
    {
      "path": "registry/html/table/table.css",
      "content": "/* nepui — Table */\n\n.np-table-container,\n[data-np-table-container] {\n  position: relative;\n  box-sizing: border-box;\n  width: 100%;\n  overflow-x: auto;\n}\n\n:is(.np-table-container, [data-np-table-container]):focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 3px color-mix(in oklch, var(--np-ring), transparent 50%);\n}\n\n.np-table,\n[data-np-table] {\n  --np-table-font-size: 0.875rem;\n  --np-table-border-color: var(--np-border);\n  --np-table-head-height: calc(var(--np-spacing) * 10);\n  --np-table-head-color: var(--np-foreground);\n  --np-table-cell-padding: calc(var(--np-spacing) * 2);\n  --np-table-row-hover-bg: color-mix(\n    in oklab,\n    var(--np-muted) 50%,\n    transparent\n  );\n  --np-table-row-selected-bg: var(--np-muted);\n  --np-table-footer-bg: color-mix(in oklab, var(--np-muted) 50%, transparent);\n  --np-table-caption-color: var(--np-muted-foreground);\n  --np-table-caption-gap: calc(var(--np-spacing) * 4);\n\n  box-sizing: border-box;\n  width: 100%;\n  caption-side: bottom;\n  border-collapse: collapse;\n  border-spacing: 0;\n  text-indent: 0;\n  font-size: var(--np-table-font-size);\n}\n\n:is(.np-table-header, [data-np-table-header]) > tr {\n  border-bottom: 1px solid var(--np-table-border-color);\n}\n\n:is(.np-table-body, [data-np-table-body]) > tr:last-child {\n  border-bottom: 0;\n}\n\n.np-table-footer,\n[data-np-table-footer] {\n  border-top: 1px solid var(--np-table-border-color);\n  background-color: var(--np-table-footer-bg);\n  font-weight: 500;\n}\n\n:is(.np-table-footer, [data-np-table-footer]) > tr:last-child {\n  border-bottom: 0;\n}\n\n.np-table-row,\n[data-np-table-row] {\n  border-bottom: 1px solid var(--np-table-border-color);\n  transition: background-color 150ms ease;\n}\n\n:is(.np-table-row, [data-np-table-row]):hover {\n  background-color: var(--np-table-row-hover-bg);\n}\n\n:is(.np-table-row, [data-np-table-row]):is(\n  [data-state=\"selected\"],\n  [data-selected],\n  [aria-selected=\"true\"]\n) {\n  background-color: var(--np-table-row-selected-bg);\n}\n\n.np-table-head,\n[data-np-table-head] {\n  box-sizing: border-box;\n  height: var(--np-table-head-height);\n  padding-inline: var(--np-table-cell-padding);\n  color: var(--np-table-head-color);\n  font-weight: 500;\n  text-align: start;\n  vertical-align: middle;\n  white-space: nowrap;\n}\n\n.np-table-cell,\n[data-np-table-cell] {\n  box-sizing: border-box;\n  padding: var(--np-table-cell-padding);\n  text-align: start;\n  vertical-align: middle;\n  white-space: nowrap;\n}\n\n:is(\n  .np-table-head,\n  [data-np-table-head],\n  .np-table-cell,\n  [data-np-table-cell]\n):has([role=\"checkbox\"], input[type=\"checkbox\"]) {\n  padding-inline-end: 0;\n}\n\n.np-table-center,\n:is(\n  .np-table-head,\n  [data-np-table-head],\n  .np-table-cell,\n  [data-np-table-cell]\n)[data-align=\"center\"] {\n  text-align: center;\n}\n\n.np-table-end,\n:is(\n  .np-table-head,\n  [data-np-table-head],\n  .np-table-cell,\n  [data-np-table-cell]\n)[data-align=\"end\"] {\n  text-align: end;\n}\n\n.np-table-caption,\n[data-np-table-caption] {\n  box-sizing: border-box;\n  margin-block-start: var(--np-table-caption-gap);\n  color: var(--np-table-caption-color);\n  font-size: var(--np-table-font-size);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .np-table-row,\n  [data-np-table-row] {\n    transition: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/table.css"
    }
  ],
  "type": "registry:ui"
}
