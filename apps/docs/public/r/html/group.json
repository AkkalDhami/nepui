{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "group",
  "title": "Group",
  "description": "A container that visually groups a series of controls.",
  "registryDependencies": [
    "https://nepui.vercel.app/r/html/button.json",
    "https://nepui.vercel.app/r/html/input.json"
  ],
  "files": [
    {
      "path": "registry/html/group/group.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Group</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/input.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/group.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        display: grid;\n        gap: 2.5rem;\n        max-width: 44rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 0 0 0.75rem;\n        font-size: 1rem;\n      }\n      p {\n        margin: 0 0 0.75rem;\n        color: var(--np-muted-foreground);\n        font-size: 0.875rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Default</h2>\n        <p>Joined buttons with separators.</p>\n        <div class=\"np-group\" role=\"group\" aria-label=\"File actions\">\n          <button type=\"button\" class=\"np-button np-button-outline\">\n            Files\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button type=\"button\" class=\"np-button np-button-outline\">\n            Media\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-icon\"\n            aria-label=\"More\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>With input</h2>\n        <p>An input and a button.</p>\n        <div class=\"np-group\" role=\"group\" aria-label=\"Share link\">\n          <input\n            class=\"np-input\"\n            type=\"text\"\n            value=\"https://nepui.dev/docs\"\n            readonly\n            aria-label=\"Link\"\n          />\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-icon\"\n            aria-label=\"Copy link\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\" />\n              <path\n                d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"\n              />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Small</h2>\n        <p>Controls keep their own size.</p>\n        <div class=\"np-group\" role=\"group\" aria-label=\"File actions\">\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-sm\"\n          >\n            Files\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-sm\"\n          >\n            Media\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-icon-sm\"\n            aria-label=\"More\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Large</h2>\n        <div class=\"np-group\" role=\"group\" aria-label=\"File actions\">\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-lg\"\n          >\n            Files\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-lg\"\n          >\n            Media\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-icon-lg\"\n            aria-label=\"More\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>With a disabled button</h2>\n        <div class=\"np-group\" role=\"group\" aria-label=\"File actions\">\n          <button type=\"button\" class=\"np-button np-button-outline\">\n            Files\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button type=\"button\" class=\"np-button np-button-outline\" disabled>\n            Media\n          </button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-icon\"\n            aria-label=\"More\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>With default buttons</h2>\n        <p>Set <code>--np-group-separator-color</code> for filled buttons.</p>\n        <div\n          class=\"np-group\"\n          role=\"group\"\n          aria-label=\"File actions\"\n          style=\"\n            --np-group-separator-color: color-mix(\n              in oklab,\n              var(--np-primary-foreground) 30%,\n              transparent\n            );\n          \"\n        >\n          <button type=\"button\" class=\"np-button\">Files</button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button type=\"button\" class=\"np-button\">Media</button>\n          <div\n            class=\"np-group-separator\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-icon\"\n            aria-label=\"More\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>With start text</h2>\n        <p><code>np-group-text</code> as a label.</p>\n        <div class=\"np-group\" role=\"group\" aria-label=\"Website\">\n          <div class=\"np-group-text\">https://</div>\n          <input\n            class=\"np-input\"\n            type=\"text\"\n            placeholder=\"example.com\"\n            aria-label=\"Domain\"\n          />\n        </div>\n      </section>\n\n      <section>\n        <h2>With end text</h2>\n        <div class=\"np-group\" role=\"group\" aria-label=\"Website\">\n          <input\n            class=\"np-input\"\n            type=\"text\"\n            placeholder=\"example\"\n            aria-label=\"Domain\"\n          />\n          <div class=\"np-group-text\">.com</div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Vertical</h2>\n        <p><code>np-group-vertical</code>, with a horizontal separator.</p>\n        <div class=\"np-group np-group-vertical\" role=\"group\" aria-label=\"Zoom\">\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-icon\"\n            aria-label=\"Zoom in\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M5 12h14\" />\n              <path d=\"M12 5v14\" />\n            </svg>\n          </button>\n          <div\n            class=\"np-group-separator np-group-separator-horizontal\"\n            role=\"separator\"\n            aria-orientation=\"horizontal\"\n          ></div>\n          <button\n            type=\"button\"\n            class=\"np-button np-button-outline np-button-icon\"\n            aria-label=\"Zoom out\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M5 12h14\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Nested groups</h2>\n        <p>Groups inside a group sit apart.</p>\n        <div class=\"np-group\" role=\"group\" aria-label=\"Pagination\">\n          <div class=\"np-group\" role=\"group\" aria-label=\"Pages\">\n            <button\n              type=\"button\"\n              class=\"np-button np-button-outline np-button-icon\"\n            >\n              1\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-button np-button-outline np-button-icon\"\n              aria-current=\"page\"\n            >\n              2\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-button np-button-outline np-button-icon\"\n            >\n              3\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-button np-button-outline np-button-icon\"\n            >\n              4\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-button np-button-outline np-button-icon\"\n            >\n              5\n            </button>\n          </div>\n          <div class=\"np-group\" role=\"group\" aria-label=\"Previous and next\">\n            <button type=\"button\" class=\"np-button np-button-outline\">\n              Previous\n            </button>\n            <button type=\"button\" class=\"np-button np-button-outline\">\n              Next\n            </button>\n          </div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/group.html"
    },
    {
      "path": "registry/html/group/group.css",
      "content": "/* nepui — Group */\n\n.np-group,\n[data-np-group] {\n  --np-group-gap: calc(var(--np-spacing) * 2);\n  --np-group-separator-color: var(--np-input);\n  --np-group-separator-size: 1px;\n\n  box-sizing: border-box;\n  display: flex;\n  width: fit-content;\n}\n\n:is(.np-group-vertical, [data-orientation=\"vertical\"]):is(\n  .np-group,\n  [data-np-group]\n) {\n  flex-direction: column;\n}\n\n:is(.np-group, [data-np-group]):has(> :is(.np-group, [data-np-group])) {\n  gap: var(--np-group-gap);\n}\n\n:is(.np-group, [data-np-group]) > :is(:focus-visible, :has(:focus-visible)) {\n  z-index: 1;\n}\n\n:is(.np-group, [data-np-group]):not(\n    :is(.np-group-vertical, [data-orientation=\"vertical\"])\n  )\n  > :not(\n    .np-group,\n    [data-np-group],\n    .np-group-separator,\n    [data-np-group-separator]\n  ):not(:first-child) {\n  border-start-start-radius: 0;\n  border-end-start-radius: 0;\n  border-inline-start-width: 0;\n}\n\n:is(.np-group, [data-np-group]):not(\n    :is(.np-group-vertical, [data-orientation=\"vertical\"])\n  )\n  > :not(\n    .np-group,\n    [data-np-group],\n    .np-group-separator,\n    [data-np-group-separator]\n  ):not(:last-child) {\n  border-start-end-radius: 0;\n  border-end-end-radius: 0;\n}\n\n:is(.np-group, [data-np-group]):not(\n    :is(.np-group-vertical, [data-orientation=\"vertical\"])\n  )\n  > :not(\n    .np-group,\n    [data-np-group],\n    .np-group-separator,\n    [data-np-group-separator]\n  ):has(+ :is(.np-group-separator, [data-np-group-separator])) {\n  border-inline-end-width: 0;\n}\n\n:is(.np-group-vertical, [data-orientation=\"vertical\"]):is(\n    .np-group,\n    [data-np-group]\n  )\n  > :not(\n    .np-group,\n    [data-np-group],\n    .np-group-separator,\n    [data-np-group-separator]\n  ):not(:first-child) {\n  border-start-start-radius: 0;\n  border-start-end-radius: 0;\n  border-block-start-width: 0;\n}\n\n:is(.np-group-vertical, [data-orientation=\"vertical\"]):is(\n    .np-group,\n    [data-np-group]\n  )\n  > :not(\n    .np-group,\n    [data-np-group],\n    .np-group-separator,\n    [data-np-group-separator]\n  ):not(:last-child) {\n  border-end-start-radius: 0;\n  border-end-end-radius: 0;\n}\n\n:is(.np-group-vertical, [data-orientation=\"vertical\"]):is(\n    .np-group,\n    [data-np-group]\n  )\n  > :not(\n    .np-group,\n    [data-np-group],\n    .np-group-separator,\n    [data-np-group-separator]\n  ):has(+ :is(.np-group-separator, [data-np-group-separator])) {\n  border-block-end-width: 0;\n}\n\n.np-group-text,\n[data-np-group-text] {\n  --np-group-text-bg: var(--np-muted);\n  --np-group-text-color: var(--np-muted-foreground);\n  --np-group-text-border-color: var(--np-input);\n  --np-group-text-radius: var(--np-radius-lg);\n  --np-group-text-height: 2rem;\n\n  box-sizing: border-box;\n  display: inline-flex;\n  align-items: center;\n  gap: calc(var(--np-spacing) * 2);\n  min-height: var(--np-group-text-height);\n  padding-inline: calc(var(--np-spacing) * 3 - 1px);\n  border: 1px solid var(--np-group-text-border-color);\n  border-radius: var(--np-group-text-radius);\n  background-color: var(--np-group-text-bg);\n  color: var(--np-group-text-color);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  white-space: nowrap;\n}\n\n:is(.np-group-text, [data-np-group-text]) svg {\n  flex: none;\n  width: 1rem;\n  height: 1rem;\n  pointer-events: none;\n}\n\n.np-group-separator,\n[data-np-group-separator] {\n  position: relative;\n  z-index: 2;\n  box-sizing: border-box;\n  flex: none;\n  align-self: stretch;\n  width: var(--np-group-separator-size);\n  margin: 0;\n  padding: 0;\n  border: 0;\n  background-color: var(--np-group-separator-color);\n  pointer-events: none;\n}\n\n:is(.np-group-separator-horizontal, [data-orientation=\"horizontal\"]):is(\n  .np-group-separator,\n  [data-np-group-separator]\n) {\n  width: auto;\n  height: var(--np-group-separator-size);\n}\n\n:is(.np-group, [data-np-group])\n  > :is(:focus-visible, :has(:focus-visible))\n  + :is(.np-group-separator, [data-np-group-separator]),\n:is(.np-group, [data-np-group])\n  > :is(.np-group-separator, [data-np-group-separator]):has(\n    + :focus-visible,\n    + * :focus-visible\n  ) {\n  background-color: var(--np-ring);\n}\n",
      "type": "registry:ui",
      "target": "styles/group.css"
    }
  ],
  "type": "registry:ui"
}
