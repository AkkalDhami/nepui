{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "label",
  "title": "Label",
  "description": "Renders an accessible label associated with controls.",
  "files": [
    {
      "path": "registry/html/label/label.html",
      "content": "<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Label - nepui</title>\r\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\r\n    <link rel=\"stylesheet\" href=\"../styles/label.css\" />\r\n\r\n    <!-- Inline page styles (demo layout only, not part of the component) -->\r\n    <style>\r\n      body {\r\n        margin: 0;\r\n        padding: 2rem;\r\n        font-family: system-ui, sans-serif;\r\n        background: var(--np-background);\r\n        color: var(--np-foreground);\r\n      }\r\n\r\n      .demo {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 1.5rem;\r\n        max-width: 22rem;\r\n      }\r\n\r\n      .field {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 0.5rem;\r\n      }\r\n\r\n      .row {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 0.5rem;\r\n      }\r\n\r\n      input[type=\"email\"],\r\n      input[type=\"text\"] {\r\n        height: 2rem;\r\n        padding: 0 0.625rem;\r\n        border: 1px solid var(--np-border);\r\n        border-radius: var(--np-radius-md);\r\n        background: var(--np-background);\r\n        color: inherit;\r\n        font: inherit;\r\n        font-size: 0.875rem;\r\n        box-sizing: border-box;\r\n      }\r\n\r\n      input:disabled {\r\n        opacity: 0.5;\r\n      }\r\n\r\n      h2 {\r\n        margin: 0 0 0.25rem;\r\n        font-size: 0.75rem;\r\n        font-weight: 500;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.05em;\r\n        opacity: 0.6;\r\n      }\r\n    </style>\r\n  </head>\r\n  <body>\r\n    <main class=\"demo\">\r\n      <section>\r\n        <h2>Class</h2>\r\n        <div class=\"field\">\r\n          <label class=\"np-label\" for=\"email\">Email</label>\r\n          <input id=\"email\" type=\"email\" placeholder=\"you@example.com\" />\r\n        </div>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Data attribute</h2>\r\n        <div class=\"field\">\r\n          <label data-np-label for=\"name\">Name</label>\r\n          <input id=\"name\" type=\"text\" placeholder=\"Your name\" />\r\n        </div>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Inline style override</h2>\r\n        <div class=\"field\">\r\n          <label\r\n            class=\"np-label\"\r\n            for=\"role\"\r\n            style=\"color: var(--np-destructive); font-size: 1rem\"\r\n          >\r\n            Role (required)\r\n          </label>\r\n          <input id=\"role\" type=\"text\" />\r\n        </div>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Disabled control before label (peer)</h2>\r\n        <div class=\"row\">\r\n          <input id=\"a\" type=\"checkbox\" disabled />\r\n          <label class=\"np-label\" for=\"a\">Accept terms</label>\r\n        </div>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Disabled via ancestor</h2>\r\n        <div class=\"field\" data-disabled=\"true\">\r\n          <label class=\"np-label\" for=\"b\">Nickname</label>\r\n          <input id=\"b\" type=\"text\" disabled />\r\n        </div>\r\n      </section>\r\n    </main>\r\n  </body>\r\n</html>\r\n",
      "type": "registry:component",
      "target": "html/label.html"
    },
    {
      "path": "registry/html/label/label.css",
      "content": "/* nepui — Label */\r\n\r\n.np-label,\r\n[data-np-label] {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n\r\n  font-size: 0.875rem;\r\n  font-weight: 500;\r\n  line-height: 1;\r\n\r\n  -webkit-user-select: none;\r\n  user-select: none;\r\n}\r\n\r\n/* Disabled via an ancestor: <div data-disabled=\"true\"> … <label> … </div> */\r\n[data-disabled=\"true\"] :is(.np-label, [data-np-label]) {\r\n  pointer-events: none;\r\n  opacity: 0.5;\r\n}\r\n\r\n/* Disabled control placed BEFORE the label: <input disabled /> <label> */\r\n:is(input, select, textarea, button, [role=\"checkbox\"], [role=\"switch\"]):is(\r\n    :disabled,\r\n    [aria-disabled=\"true\"],\r\n    [data-disabled]\r\n  )\r\n  ~ :is(.np-label, [data-np-label]) {\r\n  cursor: not-allowed;\r\n  opacity: 0.5;\r\n}\r\n",
      "type": "registry:component",
      "target": "styles/label.css"
    }
  ],
  "type": "registry:component"
}
