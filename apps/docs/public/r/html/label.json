{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "label",
  "title": "Label",
  "description": "Renders an accessible label associated with controls.",
  "files": [
    {
      "path": "registry/html/label/label.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Label - nepui</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/label.css\" />\n\n    <!-- Inline page styles (demo layout only, not part of the component) -->\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem;\n        font-family: system-ui, sans-serif;\n        background: var(--np-background);\n        color: var(--np-foreground);\n      }\n\n      .demo {\n        display: flex;\n        flex-direction: column;\n        gap: 1.5rem;\n        max-width: 22rem;\n      }\n\n      .field {\n        display: flex;\n        flex-direction: column;\n        gap: 0.5rem;\n      }\n\n      .row {\n        display: flex;\n        align-items: center;\n        gap: 0.5rem;\n      }\n\n      input[type=\"email\"],\n      input[type=\"text\"] {\n        height: 2rem;\n        padding: 0 0.625rem;\n        border: 1px solid var(--np-border);\n        border-radius: var(--np-radius-md);\n        background: var(--np-background);\n        color: inherit;\n        font: inherit;\n        font-size: 0.875rem;\n        box-sizing: border-box;\n      }\n\n      input:disabled {\n        opacity: 0.5;\n      }\n\n      h2 {\n        margin: 0 0 0.25rem;\n        font-size: 0.75rem;\n        font-weight: 500;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        opacity: 0.6;\n      }\n    </style>\n  </head>\n  <body>\n    <main class=\"demo\">\n      <section>\n        <h2>Class</h2>\n        <div class=\"field\">\n          <label class=\"np-label\" for=\"email\">Email</label>\n          <input id=\"email\" type=\"email\" placeholder=\"you@example.com\" />\n        </div>\n      </section>\n\n      <section>\n        <h2>Data attribute</h2>\n        <div class=\"field\">\n          <label data-np-label for=\"name\">Name</label>\n          <input id=\"name\" type=\"text\" placeholder=\"Your name\" />\n        </div>\n      </section>\n\n      <section>\n        <h2>Inline style override</h2>\n        <div class=\"field\">\n          <label\n            class=\"np-label\"\n            for=\"role\"\n            style=\"color: var(--np-destructive); font-size: 1rem\"\n          >\n            Role (required)\n          </label>\n          <input id=\"role\" type=\"text\" />\n        </div>\n      </section>\n\n      <section>\n        <h2>Disabled control before label (peer)</h2>\n        <div class=\"row\">\n          <input id=\"a\" type=\"checkbox\" disabled />\n          <label class=\"np-label\" for=\"a\">Accept terms</label>\n        </div>\n      </section>\n\n      <section>\n        <h2>Disabled via ancestor</h2>\n        <div class=\"field\" data-disabled=\"true\">\n          <label class=\"np-label\" for=\"b\">Nickname</label>\n          <input id=\"b\" type=\"text\" disabled />\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:component",
      "target": "html/label.html"
    },
    {
      "path": "registry/html/label/label.css",
      "content": "/* nepui — Label */\n\n.np-label,\n[data-np-label] {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1;\n\n  -webkit-user-select: none;\n  user-select: none;\n}\n\n/* Disabled via an ancestor: <div data-disabled=\"true\"> … <label> … </div> */\n[data-disabled=\"true\"] :is(.np-label, [data-np-label]) {\n  pointer-events: none;\n  opacity: 0.5;\n}\n\n/* Disabled control placed BEFORE the label: <input disabled /> <label> */\n:is(input, select, textarea, button, [role=\"checkbox\"], [role=\"switch\"]):is(\n    :disabled,\n    [aria-disabled=\"true\"],\n    [data-disabled]\n  )\n  ~ :is(.np-label, [data-np-label]) {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n",
      "type": "registry:component",
      "target": "styles/label.css"
    }
  ],
  "type": "registry:component"
}
