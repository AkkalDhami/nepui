{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aspect-ratio",
  "title": "Aspect Ratio",
  "description": "Displays content within a desired ratio.",
  "files": [
    {
      "path": "registry/html/aspect-ratio/aspect-ratio.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Aspect Ratio</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/aspect-ratio.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: var(--np-font-sans, system-ui, sans-serif);\n      }\n      main {\n        display: flex;\n        flex-direction: column;\n        gap: 2.5rem;\n        max-width: 40rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 0 0 0.25rem;\n        font-size: 0.875rem;\n        font-weight: 600;\n      }\n      .hint {\n        margin: 0 0 0.75rem;\n        font-size: 0.8125rem;\n        color: var(--np-muted-foreground);\n      }\n      .row {\n        display: flex;\n        flex-wrap: wrap;\n        align-items: flex-start;\n        gap: 1.5rem;\n      }\n      .fill {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        height: 100%;\n        border: 1px dashed var(--np-border);\n        border-radius: var(--np-radius-md);\n        background: var(--np-muted);\n        color: var(--np-muted-foreground);\n        font-size: 0.875rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <p class=\"hint\">\n          <code>class=\"np-aspect-ratio\"</code> is 16 / 9 by default. A direct\n          <code>img</code> fills the box.\n        </p>\n        <div class=\"np-aspect-ratio\" style=\"max-width: 24rem\">\n          <img\n            alt=\"Landscape illustration\"\n            src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'><rect width='4' height='3' fill='%23a1a1aa'/><circle cx='3' cy='1' r='.5' fill='%23fafafa'/><path d='M0 3L1.3 1.5 2.2 2.4 2.9 1.8 4 3Z' fill='%2352525b'/></svg>\"\n            style=\"border-radius: var(--np-radius-md)\"\n          />\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <p class=\"hint\"><code>data-np-aspect-ratio</code>, no class needed.</p>\n        <div data-np-aspect-ratio style=\"max-width: 24rem\">\n          <img\n            alt=\"Landscape illustration\"\n            src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'><rect width='4' height='3' fill='%23a1a1aa'/><circle cx='3' cy='1' r='.5' fill='%23fafafa'/><path d='M0 3L1.3 1.5 2.2 2.4 2.9 1.8 4 3Z' fill='%2352525b'/></svg>\"\n            style=\"border-radius: var(--np-radius-md)\"\n          />\n        </div>\n      </section>\n\n      <section>\n        <h2>Presets</h2>\n        <p class=\"hint\">\n          <code>np-aspect-ratio-square</code> and\n          <code>np-aspect-ratio-portrait</code>, or <code>data-ratio</code>.\n        </p>\n        <div class=\"row\">\n          <div\n            class=\"np-aspect-ratio np-aspect-ratio-square\"\n            style=\"width: 12rem\"\n          >\n            <img\n              alt=\"Landscape illustration\"\n              src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'><rect width='4' height='3' fill='%23a1a1aa'/><circle cx='3' cy='1' r='.5' fill='%23fafafa'/><path d='M0 3L1.3 1.5 2.2 2.4 2.9 1.8 4 3Z' fill='%2352525b'/></svg>\"\n              style=\"border-radius: var(--np-radius-md)\"\n            />\n          </div>\n          <div data-np-aspect-ratio data-ratio=\"portrait\" style=\"width: 9rem\">\n            <img\n              alt=\"Landscape illustration\"\n              src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'><rect width='4' height='3' fill='%23a1a1aa'/><circle cx='3' cy='1' r='.5' fill='%23fafafa'/><path d='M0 3L1.3 1.5 2.2 2.4 2.9 1.8 4 3Z' fill='%2352525b'/></svg>\"\n              style=\"border-radius: var(--np-radius-md)\"\n            />\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Custom ratio</h2>\n        <p class=\"hint\">\n          Set <code>--np-aspect-ratio-value</code>, for example\n          <code>3 / 2</code> or <code>2.39</code>.\n        </p>\n        <div class=\"row\">\n          <div\n            class=\"np-aspect-ratio\"\n            style=\"width: 14rem; --np-aspect-ratio-value: 3 / 2\"\n          >\n            <img\n              alt=\"Landscape illustration\"\n              src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'><rect width='4' height='3' fill='%23a1a1aa'/><circle cx='3' cy='1' r='.5' fill='%23fafafa'/><path d='M0 3L1.3 1.5 2.2 2.4 2.9 1.8 4 3Z' fill='%2352525b'/></svg>\"\n              style=\"border-radius: var(--np-radius-md)\"\n            />\n          </div>\n          <div\n            class=\"np-aspect-ratio\"\n            style=\"width: 14rem; --np-aspect-ratio-value: 2.39\"\n          >\n            <img\n              alt=\"Landscape illustration\"\n              src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'><rect width='4' height='3' fill='%23a1a1aa'/><circle cx='3' cy='1' r='.5' fill='%23fafafa'/><path d='M0 3L1.3 1.5 2.2 2.4 2.9 1.8 4 3Z' fill='%2352525b'/></svg>\"\n              style=\"border-radius: var(--np-radius-md)\"\n            />\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Fit</h2>\n        <p class=\"hint\">\n          <code>--np-aspect-ratio-fit: contain</code> shows the whole image\n          instead of cropping it.\n        </p>\n        <div\n          class=\"np-aspect-ratio\"\n          style=\"\n            max-width: 24rem;\n            --np-aspect-ratio-fit: contain;\n            --np-aspect-ratio-value: 1 / 1;\n          \"\n        >\n          <img\n            alt=\"Landscape illustration\"\n            src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'><rect width='4' height='3' fill='%23a1a1aa'/><circle cx='3' cy='1' r='.5' fill='%23fafafa'/><path d='M0 3L1.3 1.5 2.2 2.4 2.9 1.8 4 3Z' fill='%2352525b'/></svg>\"\n            style=\"border-radius: var(--np-radius-md)\"\n          />\n        </div>\n      </section>\n\n      <section>\n        <h2>Any content</h2>\n        <p class=\"hint\">\n          Other children size themselves. Give them <code>height: 100%</code> to\n          fill.\n        </p>\n        <div class=\"np-aspect-ratio\" style=\"max-width: 24rem\">\n          <div class=\"fill\">16 / 9</div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/aspect-ratio.html"
    },
    {
      "path": "registry/html/aspect-ratio/aspect-ratio.css",
      "content": "/* nepui - Aspect Ratio */\n\n.np-aspect-ratio,\n[data-np-aspect-ratio] {\n  --np-aspect-ratio-value: 16 / 9;\n  --np-aspect-ratio-fit: cover;\n\n  position: relative;\n  box-sizing: border-box;\n  aspect-ratio: var(--np-aspect-ratio-value);\n}\n\n:is(.np-aspect-ratio, [data-np-aspect-ratio]) > :is(img, video, iframe) {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border: 0;\n  object-fit: var(--np-aspect-ratio-fit);\n}\n\n.np-aspect-ratio-square,\n:is(.np-aspect-ratio, [data-np-aspect-ratio])[data-ratio=\"square\"] {\n  --np-aspect-ratio-value: 1 / 1;\n}\n\n.np-aspect-ratio-portrait,\n:is(.np-aspect-ratio, [data-np-aspect-ratio])[data-ratio=\"portrait\"] {\n  --np-aspect-ratio-value: 9 / 16;\n}\n",
      "type": "registry:ui",
      "target": "styles/aspect-ratio.css"
    }
  ],
  "type": "registry:ui"
}
