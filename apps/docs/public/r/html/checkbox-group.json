{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "checkbox-group",
  "title": "Checkbox Group",
  "description": "Provides shared state to a series of checkboxes.",
  "registryDependencies": [
    "https://nepui.vercel.app/r/html/checkbox.json",
    "https://nepui.vercel.app/r/html/label.json"
  ],
  "files": [
    {
      "path": "registry/html/checkbox-group/checkbox-group.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Checkbox Group</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/label.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/checkbox.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/checkbox-group.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: var(--np-font-sans, system-ui, sans-serif);\n      }\n      main {\n        display: flex;\n        flex-direction: column;\n        gap: 2.5rem;\n        max-width: 40rem;\n        margin-inline: auto;\n      }\n\n      h2 {\n        margin: 0 0 0.25rem;\n        font-size: 0.875rem;\n        font-weight: 600;\n      }\n      .hint {\n        margin: 0 0 0.75rem;\n        font-size: 0.8125rem;\n        color: var(--np-muted-foreground);\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <p class=\"hint\">\n          <code>class=\"np-checkbox-group\"</code> on a\n          <code>role=\"group\"</code> element.\n        </p>\n        <div\n          class=\"np-checkbox-group\"\n          role=\"group\"\n          aria-label=\"Select frameworks\"\n        >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"next\"\n              checked\n            />Next.js</label\n          >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"vite\"\n            />Vite</label\n          >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"astro\"\n            />Astro</label\n          >\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <p class=\"hint\">\n          <code>data-np-checkbox-group</code>, no class needed.\n        </p>\n        <div data-np-checkbox-group role=\"group\" aria-label=\"Select tools\">\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"git\"\n              checked\n            />Git</label\n          >\n          <label class=\"np-label\"\n            ><input class=\"np-checkbox\" type=\"checkbox\" value=\"npm\" />npm</label\n          >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"docker\"\n            />Docker</label\n          >\n        </div>\n      </section>\n\n      <section>\n        <h2>Horizontal</h2>\n        <p class=\"hint\">\n          <code>np-checkbox-group-horizontal</code> or\n          <code>data-orientation=\"horizontal\"</code>.\n        </p>\n        <div\n          class=\"np-checkbox-group np-checkbox-group-horizontal\"\n          role=\"group\"\n          aria-label=\"Select frameworks, horizontal\"\n        >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"next\"\n              checked\n            />Next.js</label\n          >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"vite\"\n            />Vite</label\n          >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"astro\"\n              checked\n            />Astro</label\n          >\n        </div>\n      </section>\n\n      <section>\n        <h2>Disabled</h2>\n        <p class=\"hint\">\n          Native <code>disabled</code> on an input, or on a\n          <code>fieldset</code> wrapping the group.\n        </p>\n        <div class=\"np-checkbox-group\" role=\"group\" aria-label=\"Disabled item\">\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"next\"\n              checked\n            />Next.js</label\n          >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"vite\"\n              disabled\n            />Vite</label\n          >\n          <label class=\"np-label\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"astro\"\n            />Astro</label\n          >\n        </div>\n      </section>\n\n      <section>\n        <h2>Parent checkbox</h2>\n        <p class=\"hint\">\n          A few lines of <code>oninput</code> keep the parent in sync, including\n          its indeterminate state.\n        </p>\n        <div\n          class=\"np-checkbox-group\"\n          role=\"group\"\n          aria-labelledby=\"idx-frameworks\"\n          oninput=\"\n            var t = event.target\n            function leaves(g) {\n              return g.querySelectorAll('input:not([data-parent])')\n            }\n            if (t.hasAttribute('data-parent')) {\n              leaves(t.closest('[role=group]')).forEach(function (i) {\n                i.checked = t.checked\n              })\n            }\n            this.querySelectorAll('[data-parent]').forEach(function (p) {\n              var l = leaves(p.closest('[role=group]')),\n                n = 0\n              l.forEach(function (i) {\n                if (i.checked) n++\n              })\n              p.checked = n === l.length\n              p.indeterminate = n > 0 && n !== l.length\n            })\n          \"\n        >\n          <label class=\"np-label\" id=\"idx-frameworks\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              data-parent\n            />Frameworks</label\n          >\n          <label class=\"np-label np-checkbox-group-child\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"next\"\n            />Next.js</label\n          >\n          <label class=\"np-label np-checkbox-group-child\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"vite\"\n            />Vite</label\n          >\n          <label class=\"np-label np-checkbox-group-child\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"astro\"\n            />Astro</label\n          >\n        </div>\n      </section>\n\n      <section>\n        <h2>Nested parent</h2>\n        <p class=\"hint\">\n          Each group with a <code>data-parent</code> checkbox tracks the\n          checkboxes inside it.\n        </p>\n        <div\n          class=\"np-checkbox-group\"\n          role=\"group\"\n          aria-labelledby=\"idx-perms\"\n          oninput=\"\n            var t = event.target\n            function leaves(g) {\n              return g.querySelectorAll('input:not([data-parent])')\n            }\n            if (t.hasAttribute('data-parent')) {\n              leaves(t.closest('[role=group]')).forEach(function (i) {\n                i.checked = t.checked\n              })\n            }\n            this.querySelectorAll('[data-parent]').forEach(function (p) {\n              var l = leaves(p.closest('[role=group]')),\n                n = 0\n              l.forEach(function (i) {\n                if (i.checked) n++\n              })\n              p.checked = n === l.length\n              p.indeterminate = n > 0 && n !== l.length\n            })\n          \"\n        >\n          <label class=\"np-label\" id=\"idx-perms\"\n            ><input class=\"np-checkbox\" type=\"checkbox\" data-parent />User\n            Permissions</label\n          >\n          <label class=\"np-label np-checkbox-group-child\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"view-dashboard\"\n            />View Dashboard</label\n          >\n          <label class=\"np-label np-checkbox-group-child\"\n            ><input\n              class=\"np-checkbox\"\n              type=\"checkbox\"\n              value=\"access-reports\"\n            />Access Reports</label\n          >\n          <div\n            class=\"np-checkbox-group np-checkbox-group-child\"\n            role=\"group\"\n            aria-labelledby=\"idx-manage\"\n          >\n            <label class=\"np-label\" id=\"idx-manage\"\n              ><input class=\"np-checkbox\" type=\"checkbox\" data-parent />Manage\n              Users</label\n            >\n            <label class=\"np-label np-checkbox-group-child\"\n              ><input\n                class=\"np-checkbox\"\n                type=\"checkbox\"\n                value=\"create-user\"\n              />Create User</label\n            >\n            <label class=\"np-label np-checkbox-group-child\"\n              ><input\n                class=\"np-checkbox\"\n                type=\"checkbox\"\n                value=\"edit-user\"\n              />Edit User</label\n            >\n            <label class=\"np-label np-checkbox-group-child\"\n              ><input\n                class=\"np-checkbox\"\n                type=\"checkbox\"\n                value=\"delete-user\"\n              />Delete User</label\n            >\n            <label class=\"np-label np-checkbox-group-child\"\n              ><input\n                class=\"np-checkbox\"\n                type=\"checkbox\"\n                value=\"assign-roles\"\n              />Assign Roles</label\n            >\n          </div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/checkbox-group.html"
    },
    {
      "path": "registry/html/checkbox-group/checkbox-group.css",
      "content": "/* nepui — Checkbox Group */\n\n.np-checkbox-group,\n[data-np-checkbox-group] {\n  --np-checkbox-group-gap: calc(var(--np-spacing) * 3);\n  --np-checkbox-group-direction: column;\n  --np-checkbox-group-align: flex-start;\n  --np-checkbox-group-wrap: nowrap;\n  --np-checkbox-group-indent: calc(var(--np-spacing) * 4);\n\n  display: flex;\n  box-sizing: border-box;\n  flex-direction: var(--np-checkbox-group-direction);\n  flex-wrap: var(--np-checkbox-group-wrap);\n  align-items: var(--np-checkbox-group-align);\n  gap: var(--np-checkbox-group-gap);\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.np-checkbox-group-horizontal,\n:is(\n  .np-checkbox-group,\n  [data-np-checkbox-group]\n)[data-orientation=\"horizontal\"] {\n  --np-checkbox-group-gap: calc(var(--np-spacing) * 4);\n  --np-checkbox-group-direction: row;\n  --np-checkbox-group-align: center;\n  --np-checkbox-group-wrap: wrap;\n}\n\n.np-checkbox-group-child,\n[data-np-checkbox-group-child] {\n  margin-inline-start: var(\n    --np-checkbox-group-indent,\n    calc(var(--np-spacing) * 4)\n  );\n}\n",
      "type": "registry:ui",
      "target": "styles/checkbox-group.css"
    }
  ],
  "type": "registry:ui"
}
