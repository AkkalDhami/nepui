{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "toggle",
  "title": "Toggle",
  "description": "A two-state button that can be either on or off.",
  "files": [
    {
      "path": "registry/html/toggle/toggle.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Toggle</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/toggle.css\" />\n    <script src=\"../javascripts/toggle.js\" defer></script>\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        max-width: 44rem;\n        margin-inline: auto;\n      }\n      header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 1rem;\n      }\n      h1 {\n        margin: 0;\n        font-size: 1.5rem;\n      }\n      h2 {\n        margin: 2rem 0 0.25rem;\n        font-size: 1rem;\n      }\n      p {\n        margin: 0 0 0.75rem;\n        color: var(--np-muted-foreground);\n        font-size: 0.875rem;\n      }\n      .row {\n        display: flex;\n        flex-wrap: wrap;\n        align-items: center;\n        gap: 0.5rem;\n      }\n      section {\n        padding-block-end: 1.25rem;\n        border-block-end: 1px solid var(--np-border);\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <p><code>class=\"np-toggle\"</code></p>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle bookmark\"\n            data-fill-icon\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z\" />\n            </svg>\n            Bookmark\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle italic\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <line x1=\"19\" x2=\"10\" y1=\"4\" y2=\"4\" />\n              <line x1=\"14\" x2=\"5\" y1=\"20\" y2=\"20\" />\n              <line x1=\"15\" x2=\"9\" y1=\"4\" y2=\"20\" />\n            </svg>\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"true\"\n            aria-label=\"Toggle bold\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8\"\n              />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <p>\n          <code>data-np-toggle</code> with <code>data-variant</code> and\n          <code>data-size</code>, no classes.\n        </p>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            data-np-toggle\n            aria-pressed=\"false\"\n            aria-label=\"Toggle bookmark\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z\" />\n            </svg>\n            Bookmark\n          </button>\n          <button\n            type=\"button\"\n            data-np-toggle\n            data-variant=\"outline\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle italic\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <line x1=\"19\" x2=\"10\" y1=\"4\" y2=\"4\" />\n              <line x1=\"14\" x2=\"5\" y1=\"20\" y2=\"20\" />\n              <line x1=\"15\" x2=\"9\" y1=\"4\" y2=\"20\" />\n            </svg>\n          </button>\n          <button\n            type=\"button\"\n            data-np-toggle\n            data-variant=\"outline\"\n            data-size=\"lg\"\n            aria-pressed=\"true\"\n            aria-label=\"Toggle bold\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8\"\n              />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Variants</h2>\n        <p>Default and outline, each off and on.</p>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle default off\"\n          >\n            Default\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"true\"\n            aria-label=\"Toggle default on\"\n          >\n            Default\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle outline off\"\n          >\n            Outline\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline\"\n            aria-pressed=\"true\"\n            aria-label=\"Toggle outline on\"\n          >\n            Outline\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Sizes</h2>\n        <p>\n          Small (1.75rem), default (2rem) and large (2.25rem) line up with\n          Button and Input.\n        </p>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline np-toggle-sm\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle small\"\n          >\n            Small\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle default\"\n          >\n            Default\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline np-toggle-lg\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle large\"\n          >\n            Large\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>With text and icon</h2>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle italic\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <line x1=\"19\" x2=\"10\" y1=\"4\" y2=\"4\" />\n              <line x1=\"14\" x2=\"5\" y1=\"20\" y2=\"20\" />\n              <line x1=\"15\" x2=\"9\" y1=\"4\" y2=\"20\" />\n            </svg>\n            Italic\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle bold\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8\"\n              />\n            </svg>\n            Bold\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Fill icon</h2>\n        <p>\n          <code>np-toggle-fill-icon</code> or <code>data-fill-icon</code> fills\n          a stroke icon while pressed.\n        </p>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-fill-icon\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle like\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"\n              />\n            </svg>\n            Like\n          </button>\n          <button\n            type=\"button\"\n            data-np-toggle\n            data-fill-icon\n            aria-pressed=\"true\"\n            aria-label=\"Toggle save\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z\" />\n            </svg>\n            Save\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Disabled</h2>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle disabled\"\n            disabled\n          >\n            Disabled\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline\"\n            aria-pressed=\"true\"\n            aria-label=\"Toggle disabled on\"\n            disabled\n          >\n            Disabled on\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle aria-disabled\"\n            aria-disabled=\"true\"\n          >\n            aria-disabled\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Invalid</h2>\n        <p><code>aria-invalid=\"true\"</code> or <code>data-invalid</code>.</p>\n        <div class=\"row\">\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle invalid\"\n            aria-invalid=\"true\"\n          >\n            Invalid\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle np-toggle-outline\"\n            aria-pressed=\"false\"\n            aria-label=\"Toggle invalid outline\"\n            aria-invalid=\"true\"\n          >\n            Invalid outline\n          </button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/toggle.html"
    },
    {
      "path": "registry/html/toggle/toggle.css",
      "content": "/* nepui — Toggle */\n\n.np-toggle,\n[data-np-toggle] {\n  --np-toggle-height: calc(var(--np-spacing) * 8);\n  --np-toggle-min-width: calc(var(--np-spacing) * 8);\n  --np-toggle-padding-inline: calc(var(--np-spacing) * 2.5);\n  --np-toggle-gap: calc(var(--np-spacing) * 1);\n  --np-toggle-radius: var(--np-radius-md);\n  --np-toggle-font-size: 0.875rem;\n  --np-toggle-icon-size: 1rem;\n  --np-toggle-bg: transparent;\n  --np-toggle-border-width: 1px;\n  --np-toggle-border-color: transparent;\n  --np-toggle-shadow: none;\n  --np-toggle-hover-bg: var(--np-muted);\n  --np-toggle-hover-color: var(--np-foreground);\n  --np-toggle-pressed-bg: var(--np-muted);\n  --np-toggle-invalid-ring: color-mix(\n    in oklch,\n    var(--np-destructive),\n    transparent 80%\n  );\n\n  box-sizing: border-box;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--np-toggle-gap);\n  height: var(--np-toggle-height);\n  min-width: var(--np-toggle-min-width);\n  margin: 0;\n  padding-block: 0;\n  padding-inline: var(--np-toggle-padding-inline);\n  border: var(--np-toggle-border-width) solid var(--np-toggle-border-color);\n  border-radius: var(--np-toggle-radius);\n  background-color: var(--np-toggle-bg);\n  box-shadow: var(--np-toggle-shadow);\n  color: inherit;\n  font-family: inherit;\n  font-size: var(--np-toggle-font-size);\n  font-weight: 500;\n  line-height: 1.25;\n  white-space: nowrap;\n  cursor: pointer;\n  outline: none;\n  appearance: none;\n  transition-property: color, background-color, border-color, box-shadow;\n  transition-duration: 150ms;\n  transition-timing-function: ease;\n}\n\n:is(.np-toggle, [data-np-toggle]) svg {\n  flex-shrink: 0;\n  pointer-events: none;\n}\n\n:is(.np-toggle, [data-np-toggle]) svg:not([class*=\"size-\"]) {\n  width: var(--np-toggle-icon-size);\n  height: var(--np-toggle-icon-size);\n}\n\n:is(.np-toggle, [data-np-toggle]):hover {\n  background-color: var(--np-toggle-hover-bg);\n  color: var(--np-toggle-hover-color);\n}\n\n:is(.np-toggle, [data-np-toggle]):is([aria-pressed=\"true\"], [data-pressed]) {\n  background-color: var(--np-toggle-pressed-bg);\n}\n\n:is(.np-toggle, [data-np-toggle]):focus-visible {\n  border-color: var(--np-ring);\n  box-shadow: 0 0 0 3px color-mix(in oklch, var(--np-ring), transparent 50%);\n}\n\n:is(.np-toggle, [data-np-toggle]):is([aria-invalid=\"true\"], [data-invalid]) {\n  border-color: var(--np-destructive);\n  box-shadow: 0 0 0 3px var(--np-toggle-invalid-ring);\n}\n\n:is(.np-toggle, [data-np-toggle]):is(\n  :disabled,\n  [aria-disabled=\"true\"],\n  [data-disabled]\n) {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.np-toggle-outline,\n:is(.np-toggle, [data-np-toggle])[data-variant=\"outline\"] {\n  --np-toggle-border-width: 1px;\n  --np-toggle-border-color: var(--np-input, var(--np-border));\n  --np-toggle-shadow: var(--np-shadow-sm);\n}\n\n.np-toggle-sm,\n:is(.np-toggle, [data-np-toggle])[data-size=\"sm\"] {\n  --np-toggle-height: 1.75rem;\n  --np-toggle-min-width: 1.75rem;\n  --np-toggle-radius: min(var(--np-radius-md), 12px);\n  --np-toggle-font-size: 0.8rem;\n}\n\n.np-toggle-lg,\n:is(.np-toggle, [data-np-toggle])[data-size=\"lg\"] {\n  --np-toggle-height: 2.25rem;\n  --np-toggle-min-width: 2.25rem;\n}\n\n.np-toggle-fill-icon:is([aria-pressed=\"true\"], [data-pressed]) svg,\n:is(.np-toggle, [data-np-toggle])[data-fill-icon]:is(\n    [aria-pressed=\"true\"],\n    [data-pressed]\n  )\n  svg {\n  fill: var(--np-foreground);\n}\n\n:is(.dark, [data-theme=\"dark\"]) :is(.np-toggle, [data-np-toggle]) {\n  --np-toggle-invalid-ring: color-mix(\n    in oklch,\n    var(--np-destructive),\n    transparent 60%\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not(.light, [data-theme=\"light\"]) :is(.np-toggle, [data-np-toggle]) {\n    --np-toggle-invalid-ring: color-mix(\n      in oklch,\n      var(--np-destructive),\n      transparent 60%\n    );\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .np-toggle,\n  [data-np-toggle] {\n    transition: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/toggle.css"
    },
    {
      "path": "registry/html/toggle/toggle.js",
      "content": ";(function () {\n  \"use strict\"\n\n  if (typeof document === \"undefined\" || document.__npToggle) return\n  document.__npToggle = true\n\n  const TOGGLE = \".np-toggle, [data-np-toggle]\"\n  const GROUP = \".np-toggle-group, [data-np-toggle-group]\"\n  const DISABLED = '[aria-disabled=\"true\"], [data-disabled]'\n\n  document.addEventListener(\"click\", (event) => {\n    if (!(event.target instanceof Element)) return\n\n    const toggle = event.target.closest(TOGGLE)\n    if (!toggle) return\n\n    // Group items are handled by toggle-group.js.\n    if (toggle.closest(GROUP)) return\n\n    if (toggle.disabled === true || toggle.matches(DISABLED)) return\n\n    const pressed = toggle.getAttribute(\"aria-pressed\") !== \"true\"\n    toggle.setAttribute(\"aria-pressed\", pressed ? \"true\" : \"false\")\n\n    toggle.dispatchEvent(\n      new CustomEvent(\"np-toggle-change\", {\n        bubbles: true,\n        detail: { pressed },\n      })\n    )\n  })\n})()\n",
      "type": "registry:ui",
      "target": "javascripts/toggle.js"
    }
  ],
  "type": "registry:ui"
}
