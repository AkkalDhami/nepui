{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "trace",
  "title": "Trace",
  "description": "The building block for reasoning, tool calls, sources and more.",
  "files": [
    {
      "path": "registry/html/trace/trace.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Trace</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/trace.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        display: grid;\n        gap: 2.5rem;\n        max-width: 44rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 0 0 0.75rem;\n        font-size: 1rem;\n      }\n      p {\n        margin: 0 0 0.75rem;\n        color: var(--np-muted-foreground);\n        font-size: 0.875rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Default</h2>\n        <p>\n          A finished step, an expandable step with <code>&lt;details&gt;</code>,\n          and a link.\n        </p>\n        <div class=\"np-trace\" style=\"width: 100%; max-width: 28rem\">\n          <span class=\"np-trace-line\"\n            ><span class=\"np-trace-icon\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              >\n                <circle cx=\"11\" cy=\"11\" r=\"8\" />\n                <path d=\"m21 21-4.3-4.3\" /></svg></span\n            ><span class=\"np-trace-title\"\n              >Searched for minimumReleaseAge</span\n            ></span\n          >\n          <details class=\"np-trace-collapsible\">\n            <summary class=\"np-trace-collapsible-trigger\">\n              <span class=\"np-trace-line\"\n                ><span class=\"np-trace-icon\"\n                  ><svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                  >\n                    <polyline points=\"4 17 10 11 4 5\" />\n                    <line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\" /></svg></span\n                ><span class=\"np-trace-title\">Ran node --version</span></span\n              >\n            </summary>\n            <div class=\"np-trace-collapsible-content\">v24.18.0</div>\n          </details>\n          <a\n            href=\"https://docs.astro.build\"\n            target=\"_blank\"\n            rel=\"noreferrer\"\n            class=\"np-trace-link\"\n            ><span class=\"np-trace-line\"\n              ><span class=\"np-trace-title\"\n                >Install Astro<span class=\"np-trace-sr-only\">\n                  (opens in a new tab)</span\n                ></span\n              ><span class=\"np-trace-icon\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                >\n                  <path d=\"M7 7h10v10\" />\n                  <path d=\"M7 17 17 7\" /></svg></span></span\n          ></a>\n        </div>\n      </section>\n\n      <section>\n        <h2>Status</h2>\n        <p>\n          <code>np-trace-error|running|pending</code> on the line. Running\n          shimmers the title.\n        </p>\n        <div class=\"np-trace\" style=\"width: 100%; max-width: 28rem\">\n          <span class=\"np-trace-line\"\n            ><span class=\"np-trace-icon\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              >\n                <polyline points=\"4 17 10 11 4 5\" />\n                <line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\" /></svg></span\n            ><span class=\"np-trace-title\">Ran pnpm install</span></span\n          >\n          <span class=\"np-trace-line np-trace-error\"\n            ><span class=\"np-trace-icon\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              >\n                <polyline points=\"4 17 10 11 4 5\" />\n                <line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\" /></svg></span\n            ><span class=\"np-trace-title\">Failed to run pnpm lint</span></span\n          >\n          <span class=\"np-trace-line np-trace-running\"\n            ><span class=\"np-trace-icon\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              >\n                <polyline points=\"4 17 10 11 4 5\" />\n                <line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\" /></svg></span\n            ><span class=\"np-trace-title\">Running pnpm build</span></span\n          >\n          <span class=\"np-trace-line np-trace-pending\"\n            ><span class=\"np-trace-icon\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              >\n                <polyline points=\"4 17 10 11 4 5\" />\n                <line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\" /></svg></span\n            ><span class=\"np-trace-title\">Run pnpm test</span></span\n          >\n        </div>\n      </section>\n\n      <section>\n        <h2>Description</h2>\n        <p>Secondary text after the title.</p>\n        <div class=\"np-trace\" style=\"width: 100%; max-width: 28rem\">\n          <span class=\"np-trace-line\"\n            ><span class=\"np-trace-icon\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              >\n                <path\n                  d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                />\n                <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" /></svg></span\n            ><span class=\"np-trace-title\">Read</span\n            ><span class=\"np-trace-description\"\n              >src/components/trace.tsx</span\n            ></span\n          >\n          <span class=\"np-trace-line\"\n            ><span class=\"np-trace-icon\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              >\n                <circle cx=\"11\" cy=\"11\" r=\"8\" />\n                <path d=\"m21 21-4.3-4.3\" /></svg></span\n            ><span class=\"np-trace-title\">Searched</span\n            ><span class=\"np-trace-description\"\n              >for cache keys in the docs</span\n            ></span\n          >\n        </div>\n      </section>\n\n      <section>\n        <h2>Collapsible</h2>\n        <p>\n          Native <code>&lt;details&gt;</code> and <code>&lt;summary&gt;</code>.\n          Add <code>open</code> to start open.\n        </p>\n        <div class=\"np-trace\" style=\"width: 100%; max-width: 28rem\">\n          <details class=\"np-trace-collapsible\">\n            <summary class=\"np-trace-collapsible-trigger\">\n              <span class=\"np-trace-line\"\n                ><span class=\"np-trace-icon\"\n                  ><svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                  >\n                    <polyline points=\"4 17 10 11 4 5\" />\n                    <line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\" /></svg></span\n                ><span class=\"np-trace-title\">Ran node --version</span></span\n              >\n            </summary>\n            <div class=\"np-trace-collapsible-content\">v24.18.0</div>\n          </details>\n          <details class=\"np-trace-collapsible\" open>\n            <summary class=\"np-trace-collapsible-trigger\">\n              <span class=\"np-trace-line\"\n                ><span class=\"np-trace-icon\"\n                  ><svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                  >\n                    <polyline points=\"4 17 10 11 4 5\" />\n                    <line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\" /></svg></span\n                ><span class=\"np-trace-title\">Ran pnpm build</span></span\n              >\n            </summary>\n            <div class=\"np-trace-collapsible-content\">\n              <pre\n                style=\"\n                  margin: 0;\n                  font-family: ui-monospace, monospace;\n                  font-size: 0.8125rem;\n                \"\n              >\nvite v6.0.0 building for production\n        ✓ 42 modules transformed\n        dist/index.html   0.45 kB</pre>\n            </div>\n          </details>\n          <details class=\"np-trace-collapsible\">\n            <summary class=\"np-trace-collapsible-trigger\">\n              <span class=\"np-trace-line\"\n                ><span class=\"np-trace-icon\"\n                  ><svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                  >\n                    <path\n                      d=\"M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z\"\n                    />\n                    <path\n                      d=\"M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z\"\n                    />\n                    <path d=\"M12 5v13\" /></svg></span\n                ><span class=\"np-trace-title\">Thinking</span\n                ><span class=\"np-trace-description\">4 seconds</span></span\n              >\n            </summary>\n            <div class=\"np-trace-collapsible-content\">\n              The cache key needs the lockfile hash, otherwise a dependency bump\n              would reuse a stale build.\n            </div>\n          </details>\n        </div>\n      </section>\n\n      <section>\n        <h2>Link</h2>\n        <p>\n          Put <code>np-trace-link</code> on an <code>&lt;a&gt;</code> or\n          <code>&lt;button&gt;</code>.\n        </p>\n        <div class=\"np-trace\" style=\"width: 100%; max-width: 28rem\">\n          <a\n            href=\"https://docs.astro.build\"\n            target=\"_blank\"\n            rel=\"noreferrer\"\n            class=\"np-trace-link\"\n            ><span class=\"np-trace-line\"\n              ><span class=\"np-trace-title\"\n                >Install Astro<span class=\"np-trace-sr-only\">\n                  (opens in a new tab)</span\n                ></span\n              ><span class=\"np-trace-icon\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                >\n                  <path d=\"M7 7h10v10\" />\n                  <path d=\"M7 17 17 7\" /></svg></span></span\n          ></a>\n          <a\n            href=\"https://vite.dev\"\n            target=\"_blank\"\n            rel=\"noreferrer\"\n            class=\"np-trace-link\"\n            ><span class=\"np-trace-line\"\n              ><span class=\"np-trace-icon\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                >\n                  <circle cx=\"12\" cy=\"12\" r=\"10\" />\n                  <path d=\"M2 12h20\" />\n                  <path\n                    d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"\n                  /></svg></span\n              ><span class=\"np-trace-title\"\n                >Vite documentation<span class=\"np-trace-sr-only\">\n                  (opens in a new tab)</span\n                ></span\n              ><span class=\"np-trace-icon\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                >\n                  <path d=\"M7 7h10v10\" />\n                  <path d=\"M7 17 17 7\" /></svg></span></span\n          ></a>\n          <button type=\"button\" class=\"np-trace-link\" onclick=\"alert('Opened')\">\n            <span class=\"np-trace-line\"\n              ><span class=\"np-trace-icon\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                >\n                  <path\n                    d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                  />\n                  <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" /></svg></span\n              ><span class=\"np-trace-title\">Open the changelog</span\n              ><span class=\"np-trace-icon\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                >\n                  <path d=\"m9 18 6-6-6-6\" /></svg></span\n            ></span>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Group</h2>\n        <p>A nested <code>np-trace</code> inside the content.</p>\n        <div class=\"np-trace\" style=\"width: 100%; max-width: 28rem\">\n          <details class=\"np-trace-collapsible\">\n            <summary class=\"np-trace-collapsible-trigger\">\n              <span class=\"np-trace-line\"\n                ><span class=\"np-trace-icon\"\n                  ><svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                  >\n                    <circle cx=\"11\" cy=\"11\" r=\"8\" />\n                    <path d=\"m21 21-4.3-4.3\" /></svg></span\n                ><span class=\"np-trace-title\">Explored 3 files</span></span\n              >\n            </summary>\n            <div class=\"np-trace-collapsible-content\">\n              <div class=\"np-trace\">\n                <span class=\"np-trace-line\"\n                  ><span class=\"np-trace-icon\"\n                    ><svg\n                      xmlns=\"http://www.w3.org/2000/svg\"\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"2\"\n                      stroke-linecap=\"round\"\n                      stroke-linejoin=\"round\"\n                    >\n                      <path\n                        d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                      />\n                      <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" /></svg></span\n                  ><span class=\"np-trace-title\">Read package.json</span></span\n                >\n                <span class=\"np-trace-line\"\n                  ><span class=\"np-trace-icon\"\n                    ><svg\n                      xmlns=\"http://www.w3.org/2000/svg\"\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"2\"\n                      stroke-linecap=\"round\"\n                      stroke-linejoin=\"round\"\n                    >\n                      <path\n                        d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                      />\n                      <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" /></svg></span\n                  ><span class=\"np-trace-title\">Read vite.config.ts</span></span\n                >\n                <span class=\"np-trace-line\"\n                  ><span class=\"np-trace-icon\"\n                    ><svg\n                      xmlns=\"http://www.w3.org/2000/svg\"\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"2\"\n                      stroke-linecap=\"round\"\n                      stroke-linejoin=\"round\"\n                    >\n                      <path\n                        d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                      />\n                      <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" /></svg></span\n                  ><span class=\"np-trace-title\">Read src/main.tsx</span></span\n                >\n              </div>\n            </div>\n          </details>\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <div data-np-trace>\n          <span data-np-trace-line data-status=\"running\"\n            ><span data-np-trace-title>Running pnpm build</span></span\n          >\n          <details data-np-trace-collapsible>\n            <summary data-np-trace-collapsible-trigger>\n              <span data-np-trace-line\n                ><span data-np-trace-title>Ran node --version</span></span\n              >\n            </summary>\n            <div data-np-trace-collapsible-content>v24.18.0</div>\n          </details>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/trace.html"
    },
    {
      "path": "registry/html/trace/trace.css",
      "content": "/* nepui — Trace */\n\n.np-trace,\n[data-np-trace] {\n  --np-trace-gap: calc(var(--np-spacing) * 1);\n\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: var(--np-trace-gap);\n  min-width: 0;\n}\n\n.np-trace-line,\n[data-np-trace-line] {\n  --np-trace-line-gap: calc(var(--np-spacing) * 2);\n  --np-trace-icon-size: 1rem;\n  --np-trace-font-size: 0.875rem;\n  --np-trace-color: var(--np-muted-foreground);\n  --np-trace-hover-color: var(--np-foreground);\n\n  box-sizing: border-box;\n  display: flex;\n  align-items: center;\n  gap: var(--np-trace-line-gap);\n  min-width: 0;\n  color: var(--np-trace-color);\n  font-size: var(--np-trace-font-size);\n  line-height: 1.25rem;\n}\n\n:is(.np-trace-error, [data-status=\"error\"]):is(\n  .np-trace-line,\n  [data-np-trace-line]\n) {\n  --np-trace-color: var(--np-destructive);\n  --np-trace-hover-color: var(--np-destructive);\n}\n\n:is(.np-trace-pending, [data-status=\"pending\"]):is(\n  .np-trace-line,\n  [data-np-trace-line]\n) {\n  --np-trace-color: color-mix(\n    in oklab,\n    var(--np-muted-foreground) 60%,\n    transparent\n  );\n}\n\n.np-trace-icon,\n[data-np-trace-icon] {\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  width: var(--np-trace-icon-size, 1rem);\n  height: var(--np-trace-icon-size, 1rem);\n  pointer-events: none;\n}\n\n:is(.np-trace-icon, [data-np-trace-icon]) svg {\n  width: 100%;\n  height: 100%;\n  flex: none;\n}\n\n.np-trace-title,\n[data-np-trace-title] {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.np-trace-description,\n[data-np-trace-description] {\n  min-width: 0;\n  color: color-mix(in oklab, var(--np-trace-color) 70%, transparent);\n  overflow-wrap: anywhere;\n}\n\n:is(.np-trace-running, [data-status=\"running\"]):is(\n    .np-trace-line,\n    [data-np-trace-line]\n  )\n  :is(.np-trace-title, [data-np-trace-title]) {\n  background-image: linear-gradient(\n    110deg,\n    var(--np-muted-foreground) 35%,\n    var(--np-foreground) 50%,\n    var(--np-muted-foreground) 65%\n  );\n  background-size: 250% 100%;\n  background-clip: text;\n  -webkit-background-clip: text;\n  color: transparent;\n  animation: np-trace-shimmer 2s linear infinite;\n}\n\n@keyframes np-trace-shimmer {\n  from {\n    background-position: 100% 0;\n  }\n\n  to {\n    background-position: 0 0;\n  }\n}\n\n.np-trace-link,\n[data-np-trace-link],\n.np-trace-collapsible-trigger,\n[data-np-trace-collapsible-trigger] {\n  box-sizing: border-box;\n  display: flex;\n  align-items: center;\n  gap: var(--np-spacing);\n  width: 100%;\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: var(--np-radius-sm);\n  outline: none;\n  background: none;\n  color: inherit;\n  font: inherit;\n  text-align: start;\n  text-decoration: none;\n  cursor: pointer;\n}\n\n:is(\n    .np-trace-link,\n    [data-np-trace-link],\n    .np-trace-collapsible-trigger,\n    [data-np-trace-collapsible-trigger]\n  )\n  > :is(.np-trace-line, [data-np-trace-line]) {\n  flex: 1 1 auto;\n}\n\n:is(\n    .np-trace-link,\n    [data-np-trace-link],\n    .np-trace-collapsible-trigger,\n    [data-np-trace-collapsible-trigger]\n  ):hover\n  > :is(.np-trace-line, [data-np-trace-line]) {\n  color: var(--np-trace-hover-color);\n}\n\n:is(\n  .np-trace-link,\n  [data-np-trace-link],\n  .np-trace-collapsible-trigger,\n  [data-np-trace-collapsible-trigger]\n):focus-visible {\n  box-shadow: 0 0 0 3px color-mix(in oklch, var(--np-ring), transparent 50%);\n}\n\n:is(\n  .np-trace-link,\n  [data-np-trace-link],\n  .np-trace-collapsible-trigger,\n  [data-np-trace-collapsible-trigger]\n):is(:disabled, [aria-disabled=\"true\"], [data-disabled]) {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.np-trace-collapsible,\n[data-np-trace-collapsible] {\n  box-sizing: border-box;\n  min-width: 0;\n}\n\nsummary:is(.np-trace-collapsible-trigger, [data-np-trace-collapsible-trigger]) {\n  list-style: none;\n}\n\nsummary:is(\n    .np-trace-collapsible-trigger,\n    [data-np-trace-collapsible-trigger]\n  )::-webkit-details-marker {\n  display: none;\n}\n\n:is(.np-trace-collapsible-trigger, [data-np-trace-collapsible-trigger])::after {\n  content: \"\";\n  flex: none;\n  width: 0.375rem;\n  height: 0.375rem;\n  margin-inline: 0.25rem;\n  margin-block-end: 0.125rem;\n  border-inline-end: 1.5px solid var(--np-muted-foreground);\n  border-block-end: 1.5px solid var(--np-muted-foreground);\n  rotate: 45deg;\n  transition: rotate var(--np-trace-duration, 150ms) ease;\n}\n\n:is(.np-trace-collapsible-trigger, [data-np-trace-collapsible-trigger]):is(\n    [aria-expanded=\"true\"],\n    [data-panel-open]\n  )::after,\n:is(.np-trace-collapsible, [data-np-trace-collapsible])[open]\n  > :is(\n    .np-trace-collapsible-trigger,\n    [data-np-trace-collapsible-trigger]\n  )::after {\n  margin-block-end: -0.125rem;\n  rotate: 225deg;\n}\n\n.np-trace-collapsible-content,\n[data-np-trace-collapsible-content] {\n  --np-trace-indent: calc(1rem + var(--np-spacing) * 2);\n  --np-trace-duration: 150ms;\n\n  box-sizing: border-box;\n  min-width: 0;\n  padding-block: calc(var(--np-spacing) * 1) calc(var(--np-spacing) * 2);\n  padding-inline-start: var(--np-trace-indent);\n  color: var(--np-muted-foreground);\n  font-size: 0.875rem;\n  line-height: 1.375;\n  overflow-wrap: anywhere;\n}\n\n.np-trace-collapsible-content[data-open],\n.np-trace-collapsible-content[data-closed],\n[data-np-trace-collapsible-content][data-open],\n[data-np-trace-collapsible-content][data-closed] {\n  height: var(--collapsible-panel-height);\n  overflow: hidden;\n  transition: height var(--np-trace-duration) ease;\n}\n\n:is(\n  .np-trace-collapsible-content,\n  [data-np-trace-collapsible-content]\n)[data-starting-style],\n:is(\n  .np-trace-collapsible-content,\n  [data-np-trace-collapsible-content]\n)[data-ending-style] {\n  height: 0;\n}\n\ndetails:is(.np-trace-collapsible, [data-np-trace-collapsible]) {\n  interpolate-size: allow-keywords;\n}\n\ndetails:is(\n    .np-trace-collapsible,\n    [data-np-trace-collapsible]\n  )::details-content {\n  block-size: 0;\n  overflow: hidden;\n  transition:\n    block-size 150ms ease,\n    content-visibility 150ms ease allow-discrete;\n}\n\ndetails:is(\n    .np-trace-collapsible,\n    [data-np-trace-collapsible]\n  )[open]::details-content {\n  block-size: auto;\n}\n\n.np-trace-sr-only,\n[data-np-trace-sr-only] {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  border: 0;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :is(.np-trace-running, [data-status=\"running\"]):is(\n      .np-trace-line,\n      [data-np-trace-line]\n    )\n    :is(.np-trace-title, [data-np-trace-title]) {\n    background-image: none;\n    color: var(--np-foreground);\n    animation: none;\n  }\n\n  :is(\n    .np-trace-collapsible-trigger,\n    [data-np-trace-collapsible-trigger]\n  )::after,\n  :is(.np-trace-collapsible-content, [data-np-trace-collapsible-content]),\n  details:is(\n      .np-trace-collapsible,\n      [data-np-trace-collapsible]\n    )::details-content {\n    transition: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/trace.css"
    }
  ],
  "type": "registry:ui"
}
