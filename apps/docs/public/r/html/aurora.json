{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aurora",
  "title": "Aurora",
  "description": "A slow, soft, animated glow behind your hero or any section, with named gradients, in plain CSS.",
  "registryDependencies": [
    "https://nepui.vercel.app/r/html/gradient-text.json"
  ],
  "files": [
    {
      "path": "registry/html/aurora/aurora.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Aurora</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/gradient-text.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/aurora.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        display: grid;\n        gap: 2.5rem;\n        max-width: 48rem;\n        margin-inline: auto;\n      }\n      h2.sec {\n        margin: 0 0 0.75rem;\n        font-size: 1rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2 class=\"sec\">Hero</h2>\n        <section\n          class=\"np-aurora\"\n          data-gradient=\"ocean\"\n          style=\"\n            position: relative;\n            display: grid;\n            place-items: center;\n            gap: 1rem;\n            padding: 5rem 1.5rem;\n            text-align: center;\n            border: 1px solid var(--np-border);\n            border-radius: var(--np-radius-xl);\n          \"\n        >\n          <span\n            style=\"\n              padding: 0.25rem 0.75rem;\n              border: 1px solid var(--np-border);\n              border-radius: 9999px;\n              background: var(--np-background);\n              font-size: 0.75rem;\n              font-weight: 500;\n            \"\n            >New: motion components</span\n          >\n          <h1\n            style=\"\n              margin: 0;\n              max-width: 30rem;\n              font-size: 3rem;\n              line-height: 1.1;\n              font-weight: 700;\n              letter-spacing: -0.03em;\n            \"\n          >\n            Interfaces that feel\n            <span class=\"np-gradient-text\" data-gradient=\"ocean\">alive</span>\n          </h1>\n          <p\n            style=\"\n              margin: 0;\n              max-width: 28rem;\n              color: var(--np-muted-foreground);\n            \"\n          >\n            A slow, soft glow behind your hero. Pure CSS, no canvas and no\n            script.\n          </p>\n          <div\n            style=\"\n              display: flex;\n              flex-wrap: wrap;\n              justify-content: center;\n              gap: 0.75rem;\n            \"\n          >\n            <button type=\"button\" class=\"np-button\">Get started</button>\n            <button type=\"button\" class=\"np-button np-button-outline\">\n              Learn more\n            </button>\n          </div>\n        </section>\n      </section>\n\n      <section>\n        <h2 class=\"sec\">Gradients</h2>\n        <div\n          style=\"\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));\n            gap: 0.75rem;\n          \"\n        >\n          <div\n            class=\"np-aurora\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >aurora</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"aurora\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"sunrise\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >sunrise</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"sunrise\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"sunset\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >sunset</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"sunset\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"ocean\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >ocean</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"ocean\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"forest\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >forest</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"forest\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"fire\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >fire</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"fire\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"candy\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >candy</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"candy\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"lavender\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >lavender</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"lavender\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"mint\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >mint</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"mint\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"peach\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >peach</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"peach\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"midnight\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >midnight</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"midnight\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"gold\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >gold</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"gold\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"rainbow\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >rainbow</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"rainbow\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"cyber\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >cyber</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"cyber\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"plasma\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >plasma</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"plasma\"</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"mono\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem; text-transform: capitalize\"\n              >mono</strong\n            >\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >data-gradient=\"mono\"</span\n            >\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2 class=\"sec\">Cover</h2>\n        <section\n          class=\"np-aurora\"\n          data-gradient=\"sunset\"\n          data-mask=\"none\"\n          data-intensity=\"strong\"\n          style=\"\n            display: grid;\n            place-items: center;\n            gap: 1rem;\n            padding: 7rem 1.5rem;\n            text-align: center;\n            border-radius: var(--np-radius-xl);\n            border: 1px solid var(--np-border);\n          \"\n        >\n          <h1\n            style=\"\n              margin: 0;\n              max-width: 32rem;\n              font-size: 3.25rem;\n              line-height: 1.05;\n              font-weight: 800;\n              letter-spacing: -0.035em;\n            \"\n          >\n            Ship something\n            <span class=\"np-gradient-text\" data-gradient=\"fire\">beautiful</span>\n          </h1>\n          <p\n            style=\"\n              margin: 0;\n              max-width: 26rem;\n              color: var(--np-muted-foreground);\n            \"\n          >\n            The glow covers the whole section, so the content stays in front.\n          </p>\n          <button type=\"button\" class=\"np-button\">Start building</button>\n        </section>\n      </section>\n\n      <section>\n        <h2 class=\"sec\">Mask</h2>\n        <div\n          style=\"\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));\n            gap: 0.75rem;\n          \"\n        >\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"candy\"\n            data-mask=\"corner\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">corner</strong>\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >From the corner</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"candy\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">center</strong>\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >Centered glow</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"candy\"\n            data-mask=\"top\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">top</strong>\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >Fades downward</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"candy\"\n            data-mask=\"bottom\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">bottom</strong>\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >Rises from below</span\n            >\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"candy\"\n            data-mask=\"none\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">none</strong>\n            <span\n              style=\"color: var(--np-muted-foreground); font-size: 0.8125rem\"\n              >Fills the box</span\n            >\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2 class=\"sec\">Intensity, speed and stillness</h2>\n        <div\n          style=\"\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));\n            gap: 0.75rem;\n          \"\n        >\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"forest\"\n            data-mask=\"center\"\n            data-intensity=\"subtle\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">Subtle</strong>\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"forest\"\n            data-mask=\"center\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">Default</strong>\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"forest\"\n            data-mask=\"center\"\n            data-intensity=\"strong\"\n            data-speed=\"fast\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">Strong and fast</strong>\n          </div>\n          <div\n            class=\"np-aurora\"\n            data-gradient=\"forest\"\n            data-mask=\"center\"\n            data-animate=\"false\"\n            style=\"\n              display: grid;\n              place-items: center;\n              gap: 0.25rem;\n              padding: 2.5rem 1rem;\n              text-align: center;\n              border: 1px solid var(--np-border);\n              border-radius: var(--np-radius-lg);\n            \"\n          >\n            <strong style=\"font-size: 1.125rem\">Still</strong>\n          </div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/aurora.html"
    },
    {
      "path": "registry/html/aurora/aurora.css",
      "content": "/* nepui — Aurora */\n\n:is(.np-aurora, [data-np-aurora]) {\n  --np-aurora-color-1: oklch(0.72 0.14 250);\n  --np-aurora-color-2: oklch(0.7 0.18 280);\n  --np-aurora-color-3: oklch(0.8 0.12 220);\n  --np-aurora-color-4: oklch(0.72 0.2 310);\n  --np-aurora-color-5: oklch(0.78 0.13 190);\n  --np-aurora-opacity: 0.6;\n  --np-aurora-blur: 10px;\n  --np-aurora-duration: 60s;\n  --np-aurora-mask: radial-gradient(\n    ellipse at 100% 0%,\n    #000 10%,\n    transparent 70%\n  );\n\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  background: var(--np-background);\n  color: var(--np-foreground);\n}\n\n:is(.np-aurora, [data-np-aurora])::before {\n  content: \"\";\n  position: absolute;\n  inset: calc(var(--np-aurora-blur) * -1);\n  z-index: -1;\n  pointer-events: none;\n  background-image:\n    repeating-linear-gradient(\n      100deg,\n      var(--np-background) 0%,\n      var(--np-background) 7%,\n      transparent 10%,\n      transparent 12%,\n      var(--np-background) 16%\n    ),\n    repeating-linear-gradient(\n      100deg,\n      var(--np-aurora-color-1) 10%,\n      var(--np-aurora-color-2) 15%,\n      var(--np-aurora-color-3) 20%,\n      var(--np-aurora-color-4) 25%,\n      var(--np-aurora-color-5) 30%\n    );\n  background-size: 300% 200%;\n  background-position:\n    50% 50%,\n    50% 50%;\n  filter: blur(var(--np-aurora-blur));\n  opacity: var(--np-aurora-opacity);\n  -webkit-mask-image: var(--np-aurora-mask);\n  mask-image: var(--np-aurora-mask);\n  animation: np-aurora-flow var(--np-aurora-duration) linear infinite;\n  will-change: background-position;\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"sunrise\"] {\n  --np-aurora-color-1: oklch(0.7 0.19 295);\n  --np-aurora-color-2: oklch(0.72 0.2 320);\n  --np-aurora-color-3: oklch(0.72 0.21 350);\n  --np-aurora-color-4: oklch(0.76 0.19 30);\n  --np-aurora-color-5: oklch(0.8 0.16 70);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"sunset\"] {\n  --np-aurora-color-1: oklch(0.7 0.2 30);\n  --np-aurora-color-2: oklch(0.76 0.18 50);\n  --np-aurora-color-3: oklch(0.7 0.22 350);\n  --np-aurora-color-4: oklch(0.65 0.2 330);\n  --np-aurora-color-5: oklch(0.6 0.18 300);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"ocean\"] {\n  --np-aurora-color-1: oklch(0.75 0.15 200);\n  --np-aurora-color-2: oklch(0.7 0.16 220);\n  --np-aurora-color-3: oklch(0.66 0.18 250);\n  --np-aurora-color-4: oklch(0.72 0.15 230);\n  --np-aurora-color-5: oklch(0.78 0.13 190);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"forest\"] {\n  --np-aurora-color-1: oklch(0.75 0.17 150);\n  --np-aurora-color-2: oklch(0.7 0.17 130);\n  --np-aurora-color-3: oklch(0.78 0.15 170);\n  --np-aurora-color-4: oklch(0.72 0.16 110);\n  --np-aurora-color-5: oklch(0.8 0.13 180);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"fire\"] {\n  --np-aurora-color-1: oklch(0.65 0.22 25);\n  --np-aurora-color-2: oklch(0.72 0.2 45);\n  --np-aurora-color-3: oklch(0.82 0.18 75);\n  --np-aurora-color-4: oklch(0.7 0.21 35);\n  --np-aurora-color-5: oklch(0.6 0.22 15);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"candy\"] {\n  --np-aurora-color-1: oklch(0.8 0.14 350);\n  --np-aurora-color-2: oklch(0.78 0.15 320);\n  --np-aurora-color-3: oklch(0.76 0.14 290);\n  --np-aurora-color-4: oklch(0.8 0.12 260);\n  --np-aurora-color-5: oklch(0.82 0.14 330);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"lavender\"] {\n  --np-aurora-color-1: oklch(0.78 0.12 295);\n  --np-aurora-color-2: oklch(0.74 0.13 280);\n  --np-aurora-color-3: oklch(0.8 0.11 310);\n  --np-aurora-color-4: oklch(0.72 0.13 265);\n  --np-aurora-color-5: oklch(0.78 0.12 300);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"mint\"] {\n  --np-aurora-color-1: oklch(0.82 0.13 170);\n  --np-aurora-color-2: oklch(0.8 0.14 150);\n  --np-aurora-color-3: oklch(0.84 0.12 190);\n  --np-aurora-color-4: oklch(0.78 0.15 130);\n  --np-aurora-color-5: oklch(0.84 0.11 200);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"peach\"] {\n  --np-aurora-color-1: oklch(0.82 0.12 50);\n  --np-aurora-color-2: oklch(0.8 0.13 30);\n  --np-aurora-color-3: oklch(0.85 0.11 70);\n  --np-aurora-color-4: oklch(0.78 0.14 10);\n  --np-aurora-color-5: oklch(0.83 0.12 40);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"midnight\"] {\n  --np-aurora-color-1: oklch(0.55 0.15 270);\n  --np-aurora-color-2: oklch(0.6 0.17 285);\n  --np-aurora-color-3: oklch(0.62 0.14 250);\n  --np-aurora-color-4: oklch(0.55 0.16 300);\n  --np-aurora-color-5: oklch(0.5 0.13 260);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"gold\"] {\n  --np-aurora-color-1: oklch(0.82 0.16 85);\n  --np-aurora-color-2: oklch(0.78 0.17 70);\n  --np-aurora-color-3: oklch(0.88 0.15 95);\n  --np-aurora-color-4: oklch(0.72 0.16 60);\n  --np-aurora-color-5: oklch(0.85 0.15 80);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"rainbow\"] {\n  --np-aurora-color-1: oklch(0.72 0.19 25);\n  --np-aurora-color-2: oklch(0.8 0.18 90);\n  --np-aurora-color-3: oklch(0.76 0.19 150);\n  --np-aurora-color-4: oklch(0.7 0.17 230);\n  --np-aurora-color-5: oklch(0.68 0.2 300);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"cyber\"] {\n  --np-aurora-color-1: oklch(0.8 0.17 200);\n  --np-aurora-color-2: oklch(0.65 0.25 330);\n  --np-aurora-color-3: oklch(0.6 0.2 280);\n  --np-aurora-color-4: oklch(0.82 0.16 195);\n  --np-aurora-color-5: oklch(0.66 0.24 340);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"plasma\"] {\n  --np-aurora-color-1: oklch(0.6 0.25 300);\n  --np-aurora-color-2: oklch(0.65 0.24 340);\n  --np-aurora-color-3: oklch(0.7 0.22 20);\n  --np-aurora-color-4: oklch(0.62 0.24 330);\n  --np-aurora-color-5: oklch(0.58 0.22 290);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-gradient=\"mono\"] {\n  --np-aurora-color-1: var(--np-foreground);\n  --np-aurora-color-2: var(--np-muted-foreground);\n  --np-aurora-color-3: var(--np-foreground);\n  --np-aurora-color-4: var(--np-muted-foreground);\n  --np-aurora-color-5: var(--np-foreground);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-mask=\"center\"] {\n  --np-aurora-mask: radial-gradient(\n    ellipse at 50% 50%,\n    #000 10%,\n    transparent 70%\n  );\n}\n\n:is(.np-aurora, [data-np-aurora])[data-mask=\"top\"] {\n  --np-aurora-mask: linear-gradient(to bottom, #000 0%, transparent 80%);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-mask=\"bottom\"] {\n  --np-aurora-mask: linear-gradient(to top, #000 0%, transparent 80%);\n}\n\n:is(.np-aurora, [data-np-aurora])[data-mask=\"none\"] {\n  --np-aurora-mask: none;\n}\n\n:is(.np-aurora, [data-np-aurora])[data-intensity=\"subtle\"] {\n  --np-aurora-opacity: 0.35;\n}\n\n:is(.np-aurora, [data-np-aurora])[data-intensity=\"strong\"] {\n  --np-aurora-opacity: 0.9;\n}\n\n:is(.np-aurora, [data-np-aurora])[data-speed=\"slow\"] {\n  --np-aurora-duration: 120s;\n}\n\n:is(.np-aurora, [data-np-aurora])[data-speed=\"fast\"] {\n  --np-aurora-duration: 30s;\n}\n\n:is(.np-aurora, [data-np-aurora])[data-animate=\"false\"]::before {\n  animation: none;\n}\n\n@keyframes np-aurora-flow {\n  to {\n    background-position:\n      350% 50%,\n      350% 50%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :is(.np-aurora, [data-np-aurora])::before {\n    animation: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/aurora.css"
    }
