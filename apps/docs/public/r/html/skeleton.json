{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skeleton",
  "title": "Skeleton",
  "description": "Use to show a placeholder while content is loading.",
  "files": [
    {
      "path": "registry/html/skeleton/skeleton.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Skeleton - nepui</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/skeleton.css\" />\n\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem;\n        font-family: system-ui, sans-serif;\n        background: var(--np-background);\n        color: var(--np-foreground);\n      }\n      .demo {\n        display: flex;\n        flex-direction: column;\n        gap: 2rem;\n        max-width: 24rem;\n      }\n      .row {\n        display: flex;\n        align-items: center;\n        gap: 1rem;\n      }\n      .stack {\n        display: flex;\n        flex-direction: column;\n        gap: 0.5rem;\n      }\n      h2 {\n        margin: 0 0 0.75rem;\n        font-size: 0.75rem;\n        font-weight: 500;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        opacity: 0.6;\n      }\n    </style>\n  </head>\n  <body>\n    <main class=\"demo\">\n      <section>\n        <h2>Avatar and text (class)</h2>\n        <div class=\"row\" aria-busy=\"true\">\n          <div\n            class=\"np-skeleton np-skeleton-circle\"\n            style=\"width: 3rem; height: 3rem; flex-shrink: 0\"\n          ></div>\n          <div class=\"stack\" style=\"flex: 1\">\n            <div\n              class=\"np-skeleton\"\n              style=\"width: 15rem; max-width: 100%\"\n            ></div>\n            <div\n              class=\"np-skeleton\"\n              style=\"width: 12rem; max-width: 100%\"\n            ></div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Card (data attributes)</h2>\n        <div class=\"stack\" aria-busy=\"true\">\n          <div data-np-skeleton style=\"height: 8rem; width: 100%\"></div>\n          <div data-np-skeleton style=\"width: 70%\"></div>\n          <div data-np-skeleton style=\"width: 45%\"></div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Shape and color</h2>\n        <div class=\"row\">\n          <div\n            data-np-skeleton\n            data-shape=\"circle\"\n            style=\"width: 2.5rem; height: 2.5rem\"\n          ></div>\n          <div\n            class=\"np-skeleton\"\n            style=\"width: 8rem; height: 2rem; --np-skeleton-color: #7c3aed33\"\n          ></div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/skeleton.html"
    },
    {
      "path": "registry/html/skeleton/skeleton.css",
      "content": "/* nepui — Skeleton */\n\n.np-skeleton,\n[data-np-skeleton] {\n  --np-skeleton-height: 1rem;\n  --np-skeleton-radius: var(--np-radius-md);\n  --np-skeleton-color: var(--np-muted);\n  display: block;\n  box-sizing: border-box;\n  height: var(--np-skeleton-height);\n  border-radius: var(--np-skeleton-radius);\n  background: var(--np-skeleton-color);\n  animation: np-skeleton-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n.np-skeleton-circle,\n:is(.np-skeleton, [data-np-skeleton])[data-shape=\"circle\"] {\n  --np-skeleton-radius: 9999px;\n}\n\n@keyframes np-skeleton-pulse {\n  50% {\n    opacity: 0.5;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :is(.np-skeleton, [data-np-skeleton]) {\n    animation: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/skeleton.css"
    }
  ],
  "type": "registry:ui"
}
