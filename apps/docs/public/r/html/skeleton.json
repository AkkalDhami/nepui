{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skeleton",
  "title": "Skeleton",
  "description": "Use to show a placeholder while content is loading.",
  "files": [
    {
      "path": "registry/html/skeleton/skeleton.html",
      "content": "<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Skeleton - nepui</title>\r\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\r\n    <link rel=\"stylesheet\" href=\"../styles/skeleton.css\" />\r\n\r\n    <style>\r\n      body {\r\n        margin: 0;\r\n        padding: 2rem;\r\n        font-family: system-ui, sans-serif;\r\n        background: var(--np-background);\r\n        color: var(--np-foreground);\r\n      }\r\n      .demo {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 2rem;\r\n        max-width: 24rem;\r\n      }\r\n      .row {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 1rem;\r\n      }\r\n      .stack {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 0.5rem;\r\n      }\r\n      h2 {\r\n        margin: 0 0 0.75rem;\r\n        font-size: 0.75rem;\r\n        font-weight: 500;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.05em;\r\n        opacity: 0.6;\r\n      }\r\n    </style>\r\n  </head>\r\n  <body>\r\n    <main class=\"demo\">\r\n      <section>\r\n        <h2>Avatar and text (class)</h2>\r\n        <div class=\"row\" aria-busy=\"true\">\r\n          <div\r\n            class=\"np-skeleton np-skeleton-circle\"\r\n            style=\"width: 3rem; height: 3rem; flex-shrink: 0\"\r\n          ></div>\r\n          <div class=\"stack\" style=\"flex: 1\">\r\n            <div\r\n              class=\"np-skeleton\"\r\n              style=\"width: 15rem; max-width: 100%\"\r\n            ></div>\r\n            <div\r\n              class=\"np-skeleton\"\r\n              style=\"width: 12rem; max-width: 100%\"\r\n            ></div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Card (data attributes)</h2>\r\n        <div class=\"stack\" aria-busy=\"true\">\r\n          <div data-np-skeleton style=\"height: 8rem; width: 100%\"></div>\r\n          <div data-np-skeleton style=\"width: 70%\"></div>\r\n          <div data-np-skeleton style=\"width: 45%\"></div>\r\n        </div>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Shape and color</h2>\r\n        <div class=\"row\">\r\n          <div\r\n            data-np-skeleton\r\n            data-shape=\"circle\"\r\n            style=\"width: 2.5rem; height: 2.5rem\"\r\n          ></div>\r\n          <div\r\n            class=\"np-skeleton\"\r\n            style=\"width: 8rem; height: 2rem; --np-skeleton-color: #7c3aed33\"\r\n          ></div>\r\n        </div>\r\n      </section>\r\n    </main>\r\n  </body>\r\n</html>\r\n",
      "type": "registry:ui",
      "target": "html/skeleton.html"
    },
    {
      "path": "registry/html/skeleton/skeleton.css",
      "content": "/* nepui — Skeleton */\r\n\r\n.np-skeleton,\r\n[data-np-skeleton] {\r\n  --np-skeleton-height: 1rem;\r\n  --np-skeleton-radius: var(--np-radius-md);\r\n  --np-skeleton-color: var(--np-muted);\r\n  display: block;\r\n  box-sizing: border-box;\r\n  height: var(--np-skeleton-height);\r\n  border-radius: var(--np-skeleton-radius);\r\n  background: var(--np-skeleton-color);\r\n  animation: np-skeleton-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\r\n}\r\n\r\n.np-skeleton-circle,\r\n:is(.np-skeleton, [data-np-skeleton])[data-shape=\"circle\"] {\r\n  --np-skeleton-radius: 9999px;\r\n}\r\n\r\n@keyframes np-skeleton-pulse {\r\n  50% {\r\n    opacity: 0.5;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  :is(.np-skeleton, [data-np-skeleton]) {\r\n    animation: none;\r\n  }\r\n}\r\n",
      "type": "registry:ui",
      "target": "styles/skeleton.css"
    }
  ],
  "type": "registry:ui"
}
