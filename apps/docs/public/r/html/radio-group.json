{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "radio-group",
  "title": "Radio Group",
  "description": "A set of checkable buttons—known as radio buttons—where no more than one of the buttons can be checked at a time",
  "files": [
    {
      "path": "registry/html/radio-group/radio-group.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Radio Group</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/label.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/field.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/radio-group.css\" />\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n      }\n      body {\n        margin: 0;\n        padding: 2rem 1rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        display: grid;\n        gap: 2rem;\n        max-width: 40rem;\n        margin-inline: auto;\n      }\n\n      h2 {\n        margin: 0 0 0.75rem;\n        font-size: 0.875rem;\n        color: var(--np-muted-foreground);\n        font-weight: 500;\n      }\n      .row {\n        display: flex;\n        align-items: center;\n        gap: 0.75rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <div\n          class=\"np-radio-group\"\n          role=\"radiogroup\"\n          aria-label=\"Density\"\n          style=\"width: fit-content\"\n        >\n          <div class=\"row\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"density\"\n              id=\"a1\"\n              value=\"default\"\n            />\n            <label class=\"np-label\" for=\"a1\">Default</label>\n          </div>\n          <div class=\"row\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"density\"\n              id=\"a2\"\n              value=\"comfortable\"\n              checked\n            />\n            <label class=\"np-label\" for=\"a2\">Comfortable</label>\n          </div>\n          <div class=\"row\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"density\"\n              id=\"a3\"\n              value=\"compact\"\n            />\n            <label class=\"np-label\" for=\"a3\">Compact</label>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <div\n          data-np-radio-group\n          role=\"radiogroup\"\n          aria-label=\"Size\"\n          style=\"width: fit-content\"\n        >\n          <div class=\"row\">\n            <input\n              data-np-radio-group-item\n              type=\"radio\"\n              name=\"size\"\n              id=\"b1\"\n              value=\"sm\"\n            />\n            <label class=\"np-label\" for=\"b1\">Small</label>\n          </div>\n          <div class=\"row\">\n            <input\n              data-np-radio-group-item\n              type=\"radio\"\n              name=\"size\"\n              id=\"b2\"\n              value=\"md\"\n              checked\n            />\n            <label class=\"np-label\" for=\"b2\">Medium</label>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Horizontal</h2>\n        <div\n          class=\"np-radio-group\"\n          data-orientation=\"horizontal\"\n          role=\"radiogroup\"\n          aria-label=\"Alignment\"\n          style=\"width: fit-content\"\n        >\n          <div class=\"row\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"align\"\n              id=\"c1\"\n              value=\"left\"\n              checked\n            />\n            <label class=\"np-label\" for=\"c1\">Left</label>\n          </div>\n          <div class=\"row\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"align\"\n              id=\"c2\"\n              value=\"center\"\n            />\n            <label class=\"np-label\" for=\"c2\">Center</label>\n          </div>\n          <div class=\"row\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"align\"\n              id=\"c3\"\n              value=\"right\"\n            />\n            <label class=\"np-label\" for=\"c3\">Right</label>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Description</h2>\n        <div\n          class=\"np-radio-group\"\n          role=\"radiogroup\"\n          aria-label=\"Spacing\"\n          style=\"width: 100%; max-width: 20rem\"\n        >\n          <div class=\"np-field np-field-horizontal\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"spacing\"\n              id=\"d1\"\n              value=\"default\"\n            />\n            <div class=\"np-field-content\">\n              <label class=\"np-field-label\" for=\"d1\">Default</label>\n              <p class=\"np-field-description\">\n                Standard spacing for most use cases.\n              </p>\n            </div>\n          </div>\n          <div class=\"np-field np-field-horizontal\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"spacing\"\n              id=\"d2\"\n              value=\"compact\"\n              checked\n            />\n            <div class=\"np-field-content\">\n              <label class=\"np-field-label\" for=\"d2\">Compact</label>\n              <p class=\"np-field-description\">\n                Minimal spacing for dense layouts.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Choice card</h2>\n        <div\n          class=\"np-radio-group\"\n          role=\"radiogroup\"\n          aria-label=\"Plan\"\n          style=\"width: 100%; max-width: 24rem\"\n        >\n          <label class=\"np-field-label\" for=\"card-plus\">\n            <span class=\"np-field np-field-horizontal\">\n              <span class=\"np-field-content\">\n                <span class=\"np-field-title\">Plus</span>\n                <span class=\"np-field-description\"\n                  >For individuals and small teams.</span\n                >\n              </span>\n              <input\n                class=\"np-radio-group-item\"\n                type=\"radio\"\n                name=\"card-plan\"\n                id=\"card-plus\"\n                value=\"plus\"\n                checked\n              />\n            </span>\n          </label>\n          <label class=\"np-field-label\" for=\"card-pro\">\n            <span class=\"np-field np-field-horizontal\">\n              <span class=\"np-field-content\">\n                <span class=\"np-field-title\">Pro</span>\n                <span class=\"np-field-description\"\n                  >For growing businesses.</span\n                >\n              </span>\n              <input\n                class=\"np-radio-group-item\"\n                type=\"radio\"\n                name=\"card-plan\"\n                id=\"card-pro\"\n                value=\"pro\"\n              />\n            </span>\n          </label>\n          <label class=\"np-field-label\" for=\"card-enterprise\">\n            <span class=\"np-field np-field-horizontal\">\n              <span class=\"np-field-content\">\n                <span class=\"np-field-title\">Enterprise</span>\n                <span class=\"np-field-description\"\n                  >For large teams and organizations.</span\n                >\n              </span>\n              <input\n                class=\"np-radio-group-item\"\n                type=\"radio\"\n                name=\"card-plan\"\n                id=\"card-enterprise\"\n                value=\"enterprise\"\n              />\n            </span>\n          </label>\n        </div>\n      </section>\n\n      <section>\n        <h2>Disabled</h2>\n        <div\n          class=\"np-radio-group\"\n          role=\"radiogroup\"\n          aria-label=\"Tier\"\n          style=\"width: fit-content\"\n        >\n          <div class=\"np-field np-field-horizontal\">\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"tier\"\n              id=\"f1\"\n              value=\"free\"\n              checked\n            />\n            <label class=\"np-field-label\" for=\"f1\">Free</label>\n          </div>\n          <div class=\"np-field np-field-horizontal\" data-disabled>\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"tier\"\n              id=\"f2\"\n              value=\"pro\"\n              disabled\n            />\n            <label class=\"np-field-label\" for=\"f2\">Pro</label>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Invalid</h2>\n        <div\n          class=\"np-radio-group\"\n          role=\"radiogroup\"\n          aria-label=\"Notifications\"\n          style=\"width: fit-content\"\n        >\n          <div class=\"np-field np-field-horizontal\" data-invalid>\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"notify\"\n              id=\"g1\"\n              value=\"email\"\n              aria-invalid=\"true\"\n            />\n            <label class=\"np-field-label\" for=\"g1\">Email</label>\n          </div>\n          <div class=\"np-field np-field-horizontal\" data-invalid>\n            <input\n              class=\"np-radio-group-item\"\n              type=\"radio\"\n              name=\"notify\"\n              id=\"g2\"\n              value=\"sms\"\n              aria-invalid=\"true\"\n              checked\n            />\n            <label class=\"np-field-label\" for=\"g2\">SMS (checked)</label>\n          </div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/radio-group.html"
    },
    {
      "path": "registry/html/radio-group/radio-group.css",
      "content": "/* nepui - Radio Group */\n\n.np-radio-group,\n[data-np-radio-group] {\n  --np-radio-group-gap: calc(var(--np-spacing) * 2);\n\n  box-sizing: border-box;\n  display: grid;\n  width: 100%;\n  gap: var(--np-radio-group-gap);\n}\n\n.np-radio-group-horizontal,\n:is(.np-radio-group, [data-np-radio-group])[data-orientation=\"horizontal\"] {\n  --np-radio-group-gap: calc(var(--np-spacing) * 4);\n\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n.np-radio-group-item,\n[data-np-radio-group-item] {\n  --np-radio-group-item-size: calc(var(--np-spacing) * 4);\n  --np-radio-group-dot-size: calc(var(--np-spacing) * 2);\n  --np-radio-group-dot-color: var(--np-primary-foreground);\n  --np-radio-group-border: var(--np-input, var(--np-border));\n  --np-radio-group-bg: transparent;\n  --np-radio-group-checked-bg: var(--np-primary);\n  --np-radio-group-checked-border: var(--np-primary);\n  --np-radio-group-invalid-border: var(--np-destructive);\n  --np-radio-group-invalid-ring: color-mix(\n    in oklch,\n    var(--np-destructive),\n    transparent 80%\n  );\n\n  box-sizing: border-box;\n  position: relative;\n  display: inline-flex;\n  flex-shrink: 0;\n  width: var(--np-radio-group-item-size);\n  height: var(--np-radio-group-item-size);\n  margin: 0;\n  padding: 0;\n  border: 1px solid var(--np-radio-group-border);\n  border-radius: var(--np-radius-full, 9999px);\n  background-color: var(--np-radio-group-bg);\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: var(--np-radio-group-dot-size) var(--np-radio-group-dot-size);\n  outline: none;\n  -webkit-appearance: none;\n  appearance: none;\n  transition:\n    background-color 150ms ease,\n    border-color 150ms ease,\n    box-shadow 150ms ease;\n}\n\n:is(.np-radio-group-item, [data-np-radio-group-item]):not(input)::after {\n  content: \"\";\n  position: absolute;\n  inset-block: calc(var(--np-spacing) * -2);\n  inset-inline: calc(var(--np-spacing) * -3);\n}\n\n:is(.np-radio-group-item, [data-np-radio-group-item]):focus-visible {\n  border-color: var(--np-ring);\n  box-shadow: 0 0 0 3px color-mix(in oklch, var(--np-ring), transparent 50%);\n}\n\n:is(.np-radio-group-item, [data-np-radio-group-item]):is(\n  :checked,\n  [data-checked],\n  [aria-checked=\"true\"]\n) {\n  border-color: var(--np-radio-group-checked-border);\n  background-color: var(--np-radio-group-checked-bg);\n  background-image: radial-gradient(\n    circle closest-side,\n    var(--np-radio-group-dot-color) calc(100% - 0.5px),\n    transparent 100%\n  );\n}\n\n:is(.np-radio-group-item, [data-np-radio-group-item]):is(\n  :disabled,\n  [aria-disabled=\"true\"],\n  [data-disabled]\n) {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n:is(.np-radio-group-item, [data-np-radio-group-item]):is(\n  [aria-invalid=\"true\"],\n  [data-invalid]\n) {\n  border-color: var(--np-radio-group-invalid-border);\n  box-shadow: 0 0 0 3px var(--np-radio-group-invalid-ring);\n}\n\n:is(.np-radio-group-item, [data-np-radio-group-item]):is(\n    [aria-invalid=\"true\"],\n    [data-invalid]\n  ):is(:checked, [data-checked], [aria-checked=\"true\"]) {\n  border-color: var(--np-radio-group-checked-border);\n}\n\n:is(.dark, [data-theme=\"dark\"])\n  :is(.np-radio-group-item, [data-np-radio-group-item]) {\n  --np-radio-group-bg: color-mix(\n    in oklab,\n    var(--np-radio-group-border) 30%,\n    transparent\n  );\n  --np-radio-group-invalid-border: color-mix(\n    in oklch,\n    var(--np-destructive),\n    transparent 50%\n  );\n  --np-radio-group-invalid-ring: color-mix(\n    in oklch,\n    var(--np-destructive),\n    transparent 60%\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not(.light, [data-theme=\"light\"])\n    :is(.np-radio-group-item, [data-np-radio-group-item]) {\n    --np-radio-group-bg: color-mix(\n      in oklab,\n      var(--np-radio-group-border) 30%,\n      transparent\n    );\n    --np-radio-group-invalid-border: color-mix(\n      in oklch,\n      var(--np-destructive),\n      transparent 50%\n    );\n    --np-radio-group-invalid-ring: color-mix(\n      in oklch,\n      var(--np-destructive),\n      transparent 60%\n    );\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .np-radio-group-item,\n  [data-np-radio-group-item] {\n    transition: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/radio-group.css"
    }
  ],
  "type": "registry:ui"
}
