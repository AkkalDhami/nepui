{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pagination",
  "title": "Pagination",
  "description": "Pagination with page navigation, next and previous links.",
  "registryDependencies": ["https://nepui.vercel.app/r/html/button.json"],
  "files": [
    {
      "path": "registry/html/pagination/pagination.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Pagination</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/pagination.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem;\n        font-family: var(--np-font-sans, system-ui, sans-serif);\n        background: var(--np-background);\n        color: var(--np-foreground);\n      }\n      main {\n        max-width: 40rem;\n        margin-inline: auto;\n        display: grid;\n        gap: 2rem;\n      }\n      h2 {\n        margin: 0 0 0.75rem;\n        font-size: 0.875rem;\n        color: var(--np-muted-foreground);\n        font-weight: 500;\n      }\n      section {\n        padding-bottom: 1.5rem;\n        border-bottom: 1px solid var(--np-border);\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <nav class=\"np-pagination\" aria-label=\"pagination\">\n          <ul class=\"np-pagination-content\">\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-pagination-previous\"\n                href=\"#\"\n                aria-label=\"Go to previous page\"\n              >\n                <svg\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"m15 18-6-6 6-6\" />\n                </svg>\n                <span class=\"np-pagination-text\">Previous</span>\n              </a>\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon np-pagination-link\"\n                href=\"#\"\n                >1</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-outline np-button-icon np-pagination-link\"\n                href=\"#\"\n                aria-current=\"page\"\n                >2</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon np-pagination-link\"\n                href=\"#\"\n                >3</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <span class=\"np-pagination-ellipsis\">\n                <svg\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <circle cx=\"12\" cy=\"12\" r=\"1\" />\n                  <circle cx=\"19\" cy=\"12\" r=\"1\" />\n                  <circle cx=\"5\" cy=\"12\" r=\"1\" />\n                </svg>\n                <span class=\"np-pagination-sr-only\">More pages</span>\n              </span>\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-pagination-next\"\n                href=\"#\"\n                aria-label=\"Go to next page\"\n              >\n                <span class=\"np-pagination-text\">Next</span>\n                <svg\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"m9 18 6-6-6-6\" />\n                </svg>\n              </a>\n            </li>\n          </ul>\n        </nav>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <nav data-np-pagination aria-label=\"pagination\">\n          <ul data-np-pagination-content>\n            <li data-np-pagination-item>\n              <a\n                data-np-button\n                data-variant=\"ghost\"\n                data-np-pagination-previous\n                href=\"#\"\n                aria-label=\"Go to previous page\"\n              >\n                <svg\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"m15 18-6-6 6-6\" />\n                </svg>\n                <span data-np-pagination-text>Previous</span>\n              </a>\n            </li>\n            <li data-np-pagination-item>\n              <a\n                data-np-button\n                data-variant=\"outline\"\n                data-size=\"icon\"\n                data-np-pagination-link\n                href=\"#\"\n                aria-current=\"page\"\n                >1</a\n              >\n            </li>\n            <li data-np-pagination-item>\n              <a\n                data-np-button\n                data-variant=\"ghost\"\n                data-size=\"icon\"\n                data-np-pagination-link\n                href=\"#\"\n                >2</a\n              >\n            </li>\n            <li data-np-pagination-item>\n              <a\n                data-np-button\n                data-variant=\"ghost\"\n                data-size=\"icon\"\n                data-np-pagination-link\n                href=\"#\"\n                >3</a\n              >\n            </li>\n            <li data-np-pagination-item>\n              <a\n                data-np-button\n                data-variant=\"ghost\"\n                data-np-pagination-next\n                href=\"#\"\n                aria-label=\"Go to next page\"\n              >\n                <span data-np-pagination-text>Next</span>\n                <svg\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"m9 18 6-6-6-6\" />\n                </svg>\n              </a>\n            </li>\n          </ul>\n        </nav>\n      </section>\n\n      <section>\n        <h2>Simple (numbers only)</h2>\n        <nav class=\"np-pagination\" aria-label=\"pagination\">\n          <ul class=\"np-pagination-content\">\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon np-pagination-link\"\n                href=\"#\"\n                >1</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-outline np-button-icon np-pagination-link\"\n                href=\"#\"\n                aria-current=\"page\"\n                >2</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon np-pagination-link\"\n                href=\"#\"\n                >3</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon np-pagination-link\"\n                href=\"#\"\n                >4</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon np-pagination-link\"\n                href=\"#\"\n                >5</a\n              >\n            </li>\n          </ul>\n        </nav>\n      </section>\n\n      <section>\n        <h2>Sizes (Button sizes) and custom gap</h2>\n        <nav\n          class=\"np-pagination\"\n          aria-label=\"pagination small\"\n          style=\"--np-pagination-gap: 0.25rem\"\n        >\n          <ul class=\"np-pagination-content\">\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon-sm np-pagination-link\"\n                href=\"#\"\n                >1</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-outline np-button-icon-sm np-pagination-link\"\n                href=\"#\"\n                aria-current=\"page\"\n                >2</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon-sm np-pagination-link\"\n                href=\"#\"\n                >3</a\n              >\n            </li>\n          </ul>\n        </nav>\n      </section>\n\n      <section>\n        <h2>Disabled previous</h2>\n        <nav class=\"np-pagination\" aria-label=\"pagination disabled\">\n          <ul class=\"np-pagination-content\">\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-pagination-previous\"\n                href=\"#\"\n                aria-disabled=\"true\"\n                tabindex=\"-1\"\n                aria-label=\"Go to previous page\"\n              >\n                <svg\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"m15 18-6-6 6-6\" />\n                </svg>\n                <span class=\"np-pagination-text\">Previous</span>\n              </a>\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-outline np-button-icon np-pagination-link\"\n                href=\"#\"\n                aria-current=\"page\"\n                >1</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-button-icon np-pagination-link\"\n                href=\"#\"\n                >2</a\n              >\n            </li>\n            <li class=\"np-pagination-item\">\n              <a\n                class=\"np-button np-button-ghost np-pagination-next\"\n                href=\"#\"\n                aria-label=\"Go to next page\"\n              >\n                <span class=\"np-pagination-text\">Next</span>\n                <svg\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"m9 18 6-6-6-6\" />\n                </svg>\n              </a>\n            </li>\n          </ul>\n        </nav>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/pagination.html"
    },
    {
      "path": "registry/html/pagination/pagination.css",
      "content": "/* nepui — Pagination */\n\n.np-pagination,\n[data-np-pagination] {\n  --np-pagination-gap: calc(var(--np-spacing) * 0.5);\n  --np-pagination-size: calc(var(--np-spacing) * 8);\n  --np-pagination-icon-size: 1rem;\n  --np-pagination-edge-padding: calc(var(--np-spacing) * 1.5);\n\n  box-sizing: border-box;\n  display: flex;\n  justify-content: center;\n  width: 100%;\n  margin-inline: auto;\n}\n\n.np-pagination-content,\n[data-np-pagination-content] {\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: var(--np-pagination-gap);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.np-pagination-item,\n[data-np-pagination-item] {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(\n    .np-pagination-link,\n    [data-np-pagination-link],\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  ) {\n  text-decoration: none;\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(.np-pagination-previous, [data-np-pagination-previous]) {\n  padding-inline-start: var(--np-pagination-edge-padding);\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(.np-pagination-next, [data-np-pagination-next]) {\n  padding-inline-end: var(--np-pagination-edge-padding);\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  )\n  svg {\n  flex-shrink: 0;\n  pointer-events: none;\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  )\n  svg:not([class*=\"size-\"]) {\n  width: var(--np-pagination-icon-size);\n  height: var(--np-pagination-icon-size);\n}\n\n.np-pagination-text,\n[data-np-pagination-text] {\n  display: none;\n}\n\n@media (min-width: 40rem) {\n  .np-pagination-text,\n  [data-np-pagination-text] {\n    display: block;\n  }\n}\n\n[dir=\"rtl\"]\n  :is(\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  )\n  svg {\n  transform: scaleX(-1);\n}\n\n.np-pagination-ellipsis,\n[data-np-pagination-ellipsis] {\n  box-sizing: border-box;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--np-pagination-size);\n  height: var(--np-pagination-size);\n}\n\n:is(.np-pagination-ellipsis, [data-np-pagination-ellipsis]) svg {\n  flex-shrink: 0;\n  pointer-events: none;\n}\n\n:is(.np-pagination-ellipsis, [data-np-pagination-ellipsis])\n  svg:not([class*=\"size-\"]) {\n  width: var(--np-pagination-icon-size);\n  height: var(--np-pagination-icon-size);\n}\n\n.np-pagination-sr-only,\n[data-np-pagination-sr-only] {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  border: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n",
      "type": "registry:ui",
      "target": "styles/pagination.css"
    }
  ],
  "type": "registry:ui"
}
