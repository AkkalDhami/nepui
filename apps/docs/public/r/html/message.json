{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "message",
  "title": "Message",
  "description": "Displays a message in a conversation, with optional avatar, header, footer, and alignment.",
  "registryDependencies": [
    "https://nepui.vercel.app/r/html/button.json",
    "https://nepui.vercel.app/r/html/avatar.json",
    "https://nepui.vercel.app/r/html/bubble.json",
    "https://nepui.vercel.app/r/html/attachment.json",
    "https://nepui.vercel.app/r/html/marker.json",
    "https://nepui.vercel.app/r/html/spinner.json"
  ],
  "files": [
    {
      "path": "registry/html/message/message.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Message</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/avatar.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/bubble.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/marker.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/spinner.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/attachment.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/message.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        max-width: 44rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 2rem 0 0.25rem;\n        font-size: 1rem;\n      }\n      p.hint {\n        margin: 0 0 0.75rem;\n        color: var(--np-muted-foreground);\n        font-size: 0.875rem;\n      }\n      section {\n        padding-block-end: 1.25rem;\n        border-block-end: 1px solid var(--np-border);\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <p class=\"hint\">\n        One message in a conversation: avatar, header, bubble and footer. Pure\n        CSS, no JavaScript.\n      </p>\n\n      <section>\n        <h2>Class form</h2>\n        <p class=\"hint\">\n          <code>class=\"np-message\"</code> with <code>np-message-*</code> parts.\n          Add <code>np-message-end</code> for the current user.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n            width: 100%;\n            max-width: 28rem;\n          \"\n        >\n          <div class=\"np-message np-message-end\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">ME</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble\">\n                <div class=\"np-bubble-content\">\n                  Deploying to prod real quick.\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">R</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">It's 4:55 PM. On a Friday.</div>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message np-message-end\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">ME</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble\">\n                <div class=\"np-bubble-content\">It's a one-line change.</div>\n              </div>\n              <div class=\"np-message-footer\">Delivered</div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Data-attribute form</h2>\n        <p class=\"hint\">\n          <code>data-np-message</code>, <code>data-align=\"end\"</code> and\n          <code>data-np-message-*</code>, no classes on the message parts.\n        </p>\n        <div data-np-message data-align=\"end\" style=\"max-width: 28rem\">\n          <div data-np-message-avatar>\n            <span class=\"np-avatar\"\n              ><span class=\"np-avatar-fallback\">ME</span></span\n            >\n          </div>\n          <div data-np-message-content>\n            <div data-np-message-header>You</div>\n            <div class=\"np-bubble\">\n              <div class=\"np-bubble-content\">Data attribute form.</div>\n            </div>\n            <div data-np-message-footer>Seen</div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Avatar</h2>\n        <p class=\"hint\">\n          <code>np-message-end</code> moves the avatar and the message to the\n          end side.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n            width: 100%;\n            max-width: 28rem;\n          \"\n        >\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">R</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">\n                  The build failed during dependency installation.\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message np-message-end\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <img\n                  class=\"np-avatar-image\"\n                  src=\"https://github.com/shadcn.png\"\n                  alt=\"@shadcn\"\n                />\n                <span class=\"np-avatar-fallback\">CN</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble\">\n                <div class=\"np-bubble-content\">\n                  Can you share the exact error?\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Group</h2>\n        <p class=\"hint\">\n          An empty <code>np-message-avatar</code> keeps the space of an avatar,\n          so stacked messages line up.\n        </p>\n        <div class=\"np-message-group\" style=\"width: 100%; max-width: 28rem\">\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\"></div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">\n                  I checked the registry addresses.\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\"></div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">\n                  The component and example JSON now live under the UI registry.\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">CN</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">\n                  Want me to open a pull request?\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Header and footer</h2>\n        <p class=\"hint\">\n          The header stays at the start. The avatar rises to stay level with the\n          bubble when there is a footer.\n        </p>\n        <div class=\"np-message-group\" style=\"width: 100%; max-width: 28rem\">\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\"></div>\n            <div class=\"np-message-content\">\n              <div class=\"np-message-header\">Olivia</div>\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">I already checked the logs.</div>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">OL</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">\n                  Send the report to the team. Ping @shadcn if you need help.\n                </div>\n              </div>\n              <div class=\"np-message-footer\">Read Yesterday</div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Actions</h2>\n        <p class=\"hint\">Icon-only actions need an <code>aria-label</code>.</p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n            width: 100%;\n            max-width: 28rem;\n          \"\n        >\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">R</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">\n                  The install failure is coming from the workspace package.\n                </div>\n              </div>\n              <div class=\"np-message-footer\">\n                <button\n                  type=\"button\"\n                  class=\"np-button np-button-ghost np-button-icon-xs\"\n                  aria-label=\"Copy\"\n                >\n                  <svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    width=\"24\"\n                    height=\"24\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    aria-hidden=\"true\"\n                  >\n                    <rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\" />\n                    <path\n                      d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"\n                    />\n                  </svg>\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"np-button np-button-ghost np-button-icon-xs\"\n                  aria-label=\"Retry\"\n                >\n                  <svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    width=\"24\"\n                    height=\"24\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    aria-hidden=\"true\"\n                  >\n                    <path\n                      d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"\n                    />\n                    <path d=\"M21 3v5h-5\" />\n                    <path\n                      d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"\n                    />\n                    <path d=\"M8 16H3v5\" />\n                  </svg>\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"np-button np-button-ghost np-button-icon-xs\"\n                  aria-label=\"Good response\"\n                >\n                  <svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    width=\"24\"\n                    height=\"24\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    aria-hidden=\"true\"\n                  >\n                    <path d=\"M7 10v12\" />\n                    <path\n                      d=\"M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z\"\n                    />\n                  </svg>\n                </button>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message np-message-end\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">ME</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble\">\n                <div class=\"np-bubble-content\">\n                  Okay drop me a link. Taking a look...\n                </div>\n              </div>\n              <div\n                class=\"np-message-footer\"\n                style=\"color: var(--np-destructive)\"\n              >\n                Failed to send\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Attachment</h2>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n            width: 100%;\n            max-width: 28rem;\n          \"\n        >\n          <div class=\"np-message np-message-end\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">ME</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div\n                class=\"np-attachment np-attachment-vertical\"\n                style=\"width: 12rem\"\n              >\n                <div class=\"np-attachment-media np-attachment-media-image\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=900&auto=format&fit=crop&q=80\"\n                    alt=\"Workspace\"\n                  />\n                </div>\n              </div>\n              <div class=\"np-bubble\">\n                <div class=\"np-bubble-content\">\n                  Here's the image. Can you add it to the PDF? Use it for the\n                  cover page.\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">R</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-bubble np-bubble-secondary\">\n                <div class=\"np-bubble-content\">\n                  Done. Here's the PDF with the image added as the cover page.\n                </div>\n              </div>\n              <div class=\"np-attachment\">\n                <div class=\"np-attachment-media\">\n                  <svg\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    width=\"24\"\n                    height=\"24\"\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"2\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    aria-hidden=\"true\"\n                  >\n                    <path\n                      d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                    />\n                    <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n                    <path d=\"M10 9H8\" />\n                    <path d=\"M16 13H8\" />\n                    <path d=\"M16 17H8\" />\n                  </svg>\n                </div>\n                <div class=\"np-attachment-content\">\n                  <div class=\"np-attachment-title\">sales-dashboard.pdf</div>\n                  <div class=\"np-attachment-description\">PDF · 2.4 MB</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Status</h2>\n        <p class=\"hint\">\n          A <code>role=\"status\"</code> marker is announced as it appears.\n        </p>\n        <div style=\"width: 100%; max-width: 28rem\">\n          <div class=\"np-message\">\n            <div class=\"np-message-avatar\">\n              <span class=\"np-avatar\">\n                <span class=\"np-avatar-fallback\">R</span>\n              </span>\n            </div>\n            <div class=\"np-message-content\">\n              <div class=\"np-marker\" role=\"status\">\n                <span class=\"np-marker-icon\">\n                  <span class=\"np-spinner\" aria-hidden=\"true\"></span>\n                </span>\n                <span class=\"np-marker-content\">Checking the logs...</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Variables</h2>\n        <p class=\"hint\">\n          Set <code>--np-message-*</code> variables on the message.\n        </p>\n        <div\n          class=\"np-message\"\n          style=\"\n            max-width: 28rem;\n            --np-message-avatar-size: 3rem;\n            --np-message-gap: 0.75rem;\n            --np-message-footer-height: 2rem;\n            --np-message-meta-size: 0.8125rem;\n          \"\n        >\n          <div class=\"np-message-avatar\">\n            <span class=\"np-avatar\" style=\"width: 3rem; height: 3rem\"\n              ><span class=\"np-avatar-fallback\">LG</span></span\n            >\n          </div>\n          <div class=\"np-message-content\">\n            <div class=\"np-bubble np-bubble-secondary\">\n              <div class=\"np-bubble-content\">\n                A larger avatar slot and footer.\n              </div>\n            </div>\n            <div class=\"np-message-footer\">2 min ago</div>\n          </div>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/message.html"
    },
    {
      "path": "registry/html/message/message.css",
      "content": "/* nepui — Message */\n\n.np-message,\n[data-np-message] {\n  --np-message-gap: calc(var(--np-spacing) * 2);\n  --np-message-content-gap: var(--np-spacing);\n  --np-message-avatar-size: calc(var(--np-spacing) * 8);\n  --np-message-footer-height: calc(var(--np-spacing) * 6);\n  --np-message-meta-size: 0.75rem;\n  --np-message-meta-color: var(--np-muted-foreground);\n  --np-message-meta-inset: var(--np-spacing);\n\n  box-sizing: border-box;\n  display: flex;\n  align-items: flex-end;\n  gap: var(--np-message-gap);\n  width: 100%;\n  min-width: 0;\n}\n\n.np-message-end,\n:is(.np-message, [data-np-message])[data-align=\"end\"] {\n  flex-direction: row-reverse;\n}\n\n.np-message-group,\n[data-np-message-group] {\n  --np-message-group-gap: var(--np-spacing);\n\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: var(--np-message-group-gap);\n  width: 100%;\n  min-width: 0;\n}\n\n.np-message-avatar,\n[data-np-message-avatar] {\n  display: flex;\n  flex-shrink: 0;\n  align-self: flex-end;\n  width: var(--np-message-avatar-size);\n}\n\n:is(.np-message, [data-np-message]):has(\n    > :is(.np-message-content, [data-np-message-content])\n      > :is(.np-message-footer, [data-np-message-footer])\n  )\n  > :is(.np-message-avatar, [data-np-message-avatar]) {\n  margin-block-end: calc(\n    var(--np-message-footer-height) + var(--np-message-content-gap)\n  );\n}\n\n.np-message-content,\n[data-np-message-content] {\n  box-sizing: border-box;\n  display: flex;\n  flex: 1 1 0%;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: var(--np-message-content-gap);\n  min-width: 0;\n}\n\n:is(.np-message, [data-np-message]):is(.np-message-end, [data-align=\"end\"])\n  > :is(.np-message-content, [data-np-message-content]) {\n  align-items: flex-end;\n}\n\n:is(.np-message, [data-np-message])\n  :is(.np-message-content, [data-np-message-content])\n  > :is(.np-bubble, [data-np-bubble]) {\n  align-self: flex-start;\n}\n\n:is(.np-message, [data-np-message]):is(.np-message-end, [data-align=\"end\"])\n  :is(.np-message-content, [data-np-message-content])\n  > :is(.np-bubble, [data-np-bubble]) {\n  align-self: flex-end;\n}\n\n.np-message-header,\n[data-np-message-header] {\n  box-sizing: border-box;\n  align-self: flex-start;\n  padding-inline: var(--np-message-meta-inset);\n  color: var(--np-message-meta-color);\n  font-size: var(--np-message-meta-size);\n  font-weight: 500;\n  line-height: calc(1 / 0.75);\n}\n\n.np-message-footer,\n[data-np-message-footer] {\n  box-sizing: border-box;\n  display: flex;\n  align-items: center;\n  gap: var(--np-spacing);\n  height: var(--np-message-footer-height);\n  padding-inline: var(--np-message-meta-inset);\n  color: var(--np-message-meta-color);\n  font-size: var(--np-message-meta-size);\n  line-height: calc(1 / 0.75);\n}\n",
      "type": "registry:ui",
      "target": "styles/message.css"
    }
  ],
  "type": "registry:ui"
}
