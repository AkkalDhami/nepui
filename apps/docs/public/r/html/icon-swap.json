{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "icon-swap",
  "title": "Icon Swap",
  "description": "Animate icon swaps with scale, blur, and fade transitions.",
  "registryDependencies": ["https://nepui.vercel.app/r/html/button.json"],
  "files": [
    {
      "path": "registry/html/icon-swap/icon-swap.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Icon Swap</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/icon-swap.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem;\n        font-family: var(--np-font-sans, system-ui, sans-serif);\n        background: var(--np-background);\n        color: var(--np-foreground);\n      }\n      main {\n        max-width: 40rem;\n        margin-inline: auto;\n        display: grid;\n        gap: 2rem;\n      }\n      h2 {\n        margin: 0 0 0.75rem;\n        font-size: 0.875rem;\n        color: var(--np-muted-foreground);\n        font-weight: 500;\n      }\n      section {\n        padding-bottom: 1.5rem;\n        border-bottom: 1px solid var(--np-border);\n      }\n      p.note {\n        margin: 0.75rem 0 0;\n        font-size: 0.875rem;\n        color: var(--np-muted-foreground);\n      }\n    </style>\n  </head>\n\n  <body>\n    <main>\n      <section>\n        <h2>Class form: three icons</h2>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 1rem;\n          \"\n          onclick=\"\n            const p = event.target.closest('[data-pick]')\n            if (!p) return\n            this.querySelectorAll('[data-icon]').forEach((i) =>\n              i.toggleAttribute(\n                'data-active',\n                i.dataset.icon === p.dataset.pick\n              )\n            )\n            this.querySelectorAll('[data-pick]').forEach((b) => {\n              b.classList.toggle('np-button-secondary', b === p)\n              b.classList.toggle('np-button-ghost', b !== p)\n            })\n            this.querySelector('.np-button-icon-sm').setAttribute(\n              'aria-label',\n              p.dataset.pick\n            )\n          \"\n        >\n          <button\n            class=\"np-button np-button-outline np-button-icon-sm\"\n            type=\"button\"\n            aria-label=\"sun\"\n          >\n            <span class=\"np-icon-swap\">\n              <span class=\"np-icon-swap-item\" data-icon=\"sun\" data-active\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <circle cx=\"12\" cy=\"12\" r=\"4\" />\n                  <path d=\"M12 2v2\" />\n                  <path d=\"M12 20v2\" />\n                  <path d=\"m4.93 4.93 1.41 1.41\" />\n                  <path d=\"m17.66 17.66 1.41 1.41\" />\n                  <path d=\"M2 12h2\" />\n                  <path d=\"M20 12h2\" />\n                  <path d=\"m6.34 17.66-1.41 1.41\" />\n                  <path d=\"m19.07 4.93-1.41 1.41\" /></svg\n              ></span>\n              <span class=\"np-icon-swap-item\" data-icon=\"moon\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\" /></svg\n              ></span>\n              <span class=\"np-icon-swap-item\" data-icon=\"monitor\"\n                ><svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <rect width=\"20\" height=\"14\" x=\"2\" y=\"3\" rx=\"2\" />\n                  <path d=\"M8 21h8\" />\n                  <path d=\"M12 17v4\" /></svg\n              ></span>\n            </span>\n          </button>\n\n          <div\n            role=\"group\"\n            aria-label=\"Icon\"\n            style=\"\n              display: flex;\n              gap: 2px;\n              padding: 2px;\n              border-radius: var(--np-radius-lg);\n              box-shadow: 0 0 0 1px var(--np-border);\n            \"\n          >\n            <button\n              class=\"np-button np-button-secondary np-button-xs\"\n              type=\"button\"\n              data-pick=\"sun\"\n            >\n              Sun\n            </button>\n            <button\n              class=\"np-button np-button-ghost np-button-xs\"\n              type=\"button\"\n              data-pick=\"moon\"\n            >\n              Moon\n            </button>\n            <button\n              class=\"np-button np-button-ghost np-button-xs\"\n              type=\"button\"\n              data-pick=\"monitor\"\n            >\n              Monitor\n            </button>\n          </div>\n        </div>\n        <p class=\"note\">\n          Move data-active between items. Old and new icons animate together.\n        </p>\n      </section>\n\n      <section>\n        <h2>Class form: copy, then back</h2>\n        <button\n          class=\"np-button np-button-outline np-button-icon-sm\"\n          type=\"button\"\n          aria-label=\"Copy\"\n          onclick=\"\n            const b = this,\n              i = b.querySelectorAll('.np-icon-swap-item')\n            i[0].toggleAttribute('data-active', false)\n            i[1].toggleAttribute('data-active', true)\n            b.setAttribute('aria-label', 'Copied')\n            clearTimeout(b._t)\n            b._t = setTimeout(() => {\n              i[0].toggleAttribute('data-active', true)\n              i[1].toggleAttribute('data-active', false)\n              b.setAttribute('aria-label', 'Copy')\n            }, 1500)\n          \"\n        >\n          <span class=\"np-icon-swap\">\n            <span class=\"np-icon-swap-item\" data-active\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\" />\n                <path\n                  d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"\n                /></svg\n            ></span>\n            <span class=\"np-icon-swap-item\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M20 6 9 17l-5-5\" /></svg\n            ></span>\n          </span>\n        </button>\n      </section>\n\n      <section>\n        <h2>Data-attribute form: play and pause</h2>\n        <button\n          data-np-button\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          type=\"button\"\n          aria-pressed=\"false\"\n          aria-label=\"Playback\"\n          onclick=\"\n            this.querySelectorAll('[data-np-icon-swap-item]').forEach((i) =>\n              i.toggleAttribute('data-active')\n            )\n            this.setAttribute(\n              'aria-pressed',\n              String(this.getAttribute('aria-pressed') !== 'true')\n            )\n          \"\n        >\n          <span data-np-icon-swap>\n            <span data-np-icon-swap-item data-active\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <polygon points=\"6 3 20 12 6 21 6 3\" /></svg\n            ></span>\n            <span data-np-icon-swap-item\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <rect x=\"14\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\" />\n                <rect x=\"6\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\" /></svg\n            ></span>\n          </span>\n        </button>\n      </section>\n\n      <section>\n        <h2>Custom variables (slow, strong blur, scale 0.5)</h2>\n        <button\n          class=\"np-button np-button-outline np-button-icon-lg\"\n          type=\"button\"\n          aria-label=\"Copy\"\n          onclick=\"\n            this.querySelectorAll('.np-icon-swap-item').forEach((i) =>\n              i.toggleAttribute('data-active')\n            )\n          \"\n        >\n          <span\n            class=\"np-icon-swap\"\n            style=\"\n              --np-icon-swap-duration: 700ms;\n              --np-icon-swap-blur: 10px;\n              --np-icon-swap-scale: 0.5;\n            \"\n          >\n            <span class=\"np-icon-swap-item\" data-active\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\" />\n                <path\n                  d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"\n                /></svg\n            ></span>\n            <span class=\"np-icon-swap-item\"\n              ><svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M20 6 9 17l-5-5\" /></svg\n            ></span>\n          </span>\n        </button>\n      </section>\n\n      <section style=\"border-bottom: 0\">\n        <h2>Reduced motion</h2>\n        <p class=\"note\" style=\"margin-top: 0\">\n          With <code>prefers-reduced-motion: reduce</code>, scale and blur are\n          off and only the fade remains. Try it in your OS or browser settings.\n        </p>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/icon-swap.html"
    },
    {
      "path": "registry/html/icon-swap/icon-swap.css",
      "content": "/* nepui — Icon Swap */\n\n.np-icon-swap,\n[data-np-icon-swap] {\n  --np-icon-swap-duration: 300ms;\n  --np-icon-swap-easing: cubic-bezier(0.2, 0, 0, 1);\n  --np-icon-swap-scale: 0.25;\n  --np-icon-swap-blur: 4px;\n\n  box-sizing: border-box;\n  display: inline-grid;\n  flex-shrink: 0;\n  place-items: center;\n  vertical-align: middle;\n}\n\n.np-icon-swap-item,\n[data-np-icon-swap-item] {\n  box-sizing: border-box;\n  display: inline-flex;\n  grid-area: 1 / 1;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  scale: var(--np-icon-swap-scale);\n  filter: blur(var(--np-icon-swap-blur));\n  pointer-events: none;\n  transition:\n    opacity var(--np-icon-swap-duration) var(--np-icon-swap-easing),\n    scale var(--np-icon-swap-duration) var(--np-icon-swap-easing),\n    filter var(--np-icon-swap-duration) var(--np-icon-swap-easing);\n}\n\n:is(.np-icon-swap-item, [data-np-icon-swap-item]):is(\n  .np-icon-swap-active,\n  [data-active]\n) {\n  opacity: 1;\n  scale: 1;\n  filter: blur(0);\n  pointer-events: auto;\n}\n\n:is(.np-icon-swap-item, [data-np-icon-swap-item])[data-state=\"enter\"] {\n  animation: np-icon-swap-in var(--np-icon-swap-duration)\n    var(--np-icon-swap-easing) backwards;\n}\n\n@keyframes np-icon-swap-in {\n  from {\n    opacity: 0;\n    scale: var(--np-icon-swap-scale);\n    filter: blur(var(--np-icon-swap-blur));\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .np-icon-swap,\n  [data-np-icon-swap] {\n    --np-icon-swap-scale: 1;\n    --np-icon-swap-blur: 0px;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/icon-swap.css"
    }
  ],
  "type": "registry:ui"
}
