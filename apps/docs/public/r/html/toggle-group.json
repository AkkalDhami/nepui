      "path": "registry/html/toggle-group/toggle-group.css",
      "content": "/* nepui — Toggle Group */\n\n.np-toggle-group,\n[data-np-toggle-group] {\n  --np-toggle-group-spacing: 2;\n  --np-toggle-group-radius: var(--np-radius-md);\n\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  width: fit-content;\n  gap: calc(var(--np-spacing) * var(--np-toggle-group-spacing));\n  border-radius: var(--np-toggle-group-radius);\n}\n\n:is(.np-toggle-group, [data-np-toggle-group])\n  > :is(.np-toggle, [data-np-toggle]) {\n  position: relative;\n  flex-shrink: 0;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group])\n  > :is(.np-toggle, [data-np-toggle]):focus-visible {\n  z-index: 10;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    [data-disabled],\n    [aria-disabled=\"true\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]) {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.np-toggle-group-vertical,\n:is(.np-toggle-group, [data-np-toggle-group])[data-orientation=\"vertical\"] {\n  flex-direction: column;\n  align-items: stretch;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-outline,\n    [data-variant=\"outline\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]) {\n  --np-toggle-border-width: 1px;\n  --np-toggle-border-color: var(--np-input, var(--np-border));\n  --np-toggle-shadow: var(--np-shadow-sm);\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n  .np-toggle-group-sm,\n  [data-size=\"sm\"]\n) {\n  --np-toggle-group-radius: min(var(--np-radius-md), 10px);\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-sm,\n    [data-size=\"sm\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]) {\n  --np-toggle-height: 1.75rem;\n  --np-toggle-min-width: 1.75rem;\n  --np-toggle-radius: min(var(--np-radius-md), 12px);\n  --np-toggle-font-size: 0.8rem;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-lg,\n    [data-size=\"lg\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]) {\n  --np-toggle-height: 2.25rem;\n  --np-toggle-min-width: 2.25rem;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n  .np-toggle-group-connected,\n  [data-spacing=\"0\"]\n) {\n  --np-toggle-group-spacing: 0;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]) {\n  --np-toggle-padding-inline: calc(var(--np-spacing) * 2);\n  border-radius: 0;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]):first-child {\n  border-start-start-radius: var(--np-toggle-radius);\n  border-end-start-radius: var(--np-toggle-radius);\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]):last-child {\n  border-start-end-radius: var(--np-toggle-radius);\n  border-end-end-radius: var(--np-toggle-radius);\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  )\n  > :is(.np-toggle, [data-np-toggle]):not(:first-child) {\n  border-inline-start-width: 0;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  ):is(.np-toggle-group-vertical, [data-orientation=\"vertical\"])\n  > :is(.np-toggle, [data-np-toggle]):first-child {\n  border-start-start-radius: var(--np-toggle-radius);\n  border-start-end-radius: var(--np-toggle-radius);\n  border-end-start-radius: 0;\n  border-end-end-radius: 0;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  ):is(.np-toggle-group-vertical, [data-orientation=\"vertical\"])\n  > :is(.np-toggle, [data-np-toggle]):last-child {\n  border-end-start-radius: var(--np-toggle-radius);\n  border-end-end-radius: var(--np-toggle-radius);\n  border-start-start-radius: 0;\n  border-start-end-radius: 0;\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  ):is(.np-toggle-group-vertical, [data-orientation=\"vertical\"])\n  > :is(.np-toggle, [data-np-toggle]):only-child {\n  border-radius: var(--np-toggle-radius);\n}\n\n:is(.np-toggle-group, [data-np-toggle-group]):is(\n    .np-toggle-group-connected,\n    [data-spacing=\"0\"]\n  ):is(.np-toggle-group-vertical, [data-orientation=\"vertical\"])\n  > :is(.np-toggle, [data-np-toggle]):not(:first-child) {\n  border-inline-start-width: var(--np-toggle-border-width);\n  border-block-start-width: 0;\n}\n",
