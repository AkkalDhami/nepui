{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "toggle-group",
  "title": "Toggle Group",
  "description": "A set of two-state buttons that can be toggled on or off.",
  "registryDependencies": ["https://nepui.vercel.app/r/html/toggle.json"],
  "files": [
    {
      "path": "registry/html/toggle-group/toggle-group.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Toggle Group</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/toggle.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/toggle-group.css\" />\n    <script src=\"../javascripts/toggle-group.js\" defer></script>\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        max-width: 44rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 2rem 0 0.25rem;\n        font-size: 1rem;\n      }\n      p {\n        margin: 0 0 0.75rem;\n        color: var(--np-muted-foreground);\n        font-size: 0.875rem;\n      }\n      .row {\n        display: flex;\n        flex-wrap: wrap;\n        align-items: flex-start;\n        gap: 1.5rem;\n      }\n      section {\n        padding-block-end: 1.25rem;\n        border-block-end: 1px solid var(--np-border);\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <p>\n          <code>class=\"np-toggle-group\"</code> with plain\n          <code>np-toggle</code> items.\n        </p>\n        <div\n          class=\"np-toggle-group np-toggle-group-multiple\"\n          role=\"group\"\n          aria-label=\"Text formatting\"\n        >\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            value=\"bold\"\n            aria-label=\"Toggle bold\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8\"\n              />\n            </svg>\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            value=\"italic\"\n            aria-label=\"Toggle italic\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <line x1=\"19\" x2=\"10\" y1=\"4\" y2=\"4\" />\n              <line x1=\"14\" x2=\"5\" y1=\"20\" y2=\"20\" />\n              <line x1=\"15\" x2=\"9\" y1=\"4\" y2=\"20\" />\n            </svg>\n          </button>\n          <button\n            type=\"button\"\n            class=\"np-toggle\"\n            aria-pressed=\"false\"\n            value=\"underline\"\n            aria-label=\"Toggle underline\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M6 4v6a6 6 0 0 0 12 0V4\" />\n              <line x1=\"4\" x2=\"20\" y1=\"20\" y2=\"20\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <p>\n          <code>data-np-toggle-group</code> with <code>data-variant</code>,\n          <code>data-size</code> and <code>data-spacing</code>. Items use\n          <code>data-np-toggle</code>.\n        </p>\n        <div\n          data-np-toggle-group\n          data-variant=\"outline\"\n          data-size=\"sm\"\n          data-spacing=\"0\"\n          role=\"group\"\n          aria-label=\"Text alignment\"\n        >\n          <button\n            type=\"button\"\n            data-np-toggle\n            aria-pressed=\"true\"\n            value=\"left\"\n            aria-label=\"Align left\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M15 12H3\" />\n              <path d=\"M17 18H3\" />\n              <path d=\"M21 6H3\" />\n            </svg>\n          </button>\n          <button\n            type=\"button\"\n            data-np-toggle\n            aria-pressed=\"false\"\n            value=\"center\"\n            aria-label=\"Align center\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M17 12H7\" />\n              <path d=\"M19 18H5\" />\n              <path d=\"M21 6H3\" />\n            </svg>\n          </button>\n          <button\n            type=\"button\"\n            data-np-toggle\n            aria-pressed=\"false\"\n            value=\"right\"\n            aria-label=\"Align right\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M21 12H9\" />\n              <path d=\"M21 18H7\" />\n              <path d=\"M21 6H3\" />\n            </svg>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h2>Multiple and single</h2>\n        <p>Multiple lets any item be on. Single keeps one item on at a time.</p>\n        <div class=\"row\">\n          <div\n            class=\"np-toggle-group np-toggle-group-multiple\"\n            role=\"group\"\n            aria-label=\"Text formatting\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bold\"\n              aria-label=\"Toggle bold\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  d=\"M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8\"\n                />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"italic\"\n              aria-label=\"Toggle italic\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <line x1=\"19\" x2=\"10\" y1=\"4\" y2=\"4\" />\n                <line x1=\"14\" x2=\"5\" y1=\"20\" y2=\"20\" />\n                <line x1=\"15\" x2=\"9\" y1=\"4\" y2=\"20\" />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"underline\"\n              aria-label=\"Toggle underline\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M6 4v6a6 6 0 0 0 12 0V4\" />\n                <line x1=\"4\" x2=\"20\" y1=\"20\" y2=\"20\" />\n              </svg>\n            </button>\n          </div>\n          <div class=\"np-toggle-group\" role=\"group\" aria-label=\"Text alignment\">\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"left\"\n              aria-label=\"Align left\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M15 12H3\" />\n                <path d=\"M17 18H3\" />\n                <path d=\"M21 6H3\" />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"center\"\n              aria-label=\"Align center\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M17 12H7\" />\n                <path d=\"M19 18H5\" />\n                <path d=\"M21 6H3\" />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n              aria-label=\"Align right\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M21 12H9\" />\n                <path d=\"M21 18H7\" />\n                <path d=\"M21 6H3\" />\n              </svg>\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Variants</h2>\n        <p>Default and outline.</p>\n        <div class=\"row\">\n          <div\n            class=\"np-toggle-group\"\n            role=\"group\"\n            aria-label=\"Default variant\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n          <div\n            class=\"np-toggle-group np-toggle-group-outline\"\n            role=\"group\"\n            aria-label=\"Outline variant\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Sizes</h2>\n        <p>The group size applies to every item.</p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start;\n            gap: 1rem;\n          \"\n        >\n          <div\n            class=\"np-toggle-group np-toggle-group-outline np-toggle-group-connected np-toggle-group-sm\"\n            role=\"group\"\n            aria-label=\"Small\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n          <div\n            class=\"np-toggle-group np-toggle-group-outline np-toggle-group-connected\"\n            role=\"group\"\n            aria-label=\"Default\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n          <div\n            class=\"np-toggle-group np-toggle-group-outline np-toggle-group-connected np-toggle-group-lg\"\n            role=\"group\"\n            aria-label=\"Large\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Spacing</h2>\n        <p>\n          Connected, default (2) and wide (4). Set\n          <code>--np-toggle-group-spacing</code> for any step.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start;\n            gap: 1rem;\n          \"\n        >\n          <div\n            class=\"np-toggle-group np-toggle-group-outline np-toggle-group-connected\"\n            role=\"group\"\n            aria-label=\"Connected\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n          <div\n            class=\"np-toggle-group np-toggle-group-outline\"\n            role=\"group\"\n            aria-label=\"Default spacing\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n          <div\n            class=\"np-toggle-group np-toggle-group-outline\"\n            role=\"group\"\n            aria-label=\"Wide spacing\"\n            style=\"--np-toggle-group-spacing: 4\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"true\"\n              value=\"top\"\n            >\n              Top\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bottom\"\n            >\n              Bottom\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"left\"\n            >\n              Left\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"right\"\n            >\n              Right\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Vertical</h2>\n        <div class=\"row\">\n          <div\n            class=\"np-toggle-group np-toggle-group-outline np-toggle-group-connected np-toggle-group-vertical np-toggle-group-multiple\"\n            role=\"group\"\n            aria-label=\"Vertical connected\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bold\"\n              aria-label=\"Toggle bold\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  d=\"M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8\"\n                />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"italic\"\n              aria-label=\"Toggle italic\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <line x1=\"19\" x2=\"10\" y1=\"4\" y2=\"4\" />\n                <line x1=\"14\" x2=\"5\" y1=\"20\" y2=\"20\" />\n                <line x1=\"15\" x2=\"9\" y1=\"4\" y2=\"20\" />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"underline\"\n              aria-label=\"Toggle underline\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M6 4v6a6 6 0 0 0 12 0V4\" />\n                <line x1=\"4\" x2=\"20\" y1=\"20\" y2=\"20\" />\n              </svg>\n            </button>\n          </div>\n          <div\n            class=\"np-toggle-group np-toggle-group-outline np-toggle-group-vertical np-toggle-group-multiple\"\n            role=\"group\"\n            aria-label=\"Vertical spaced\"\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bold\"\n              aria-label=\"Toggle bold\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  d=\"M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8\"\n                />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"italic\"\n              aria-label=\"Toggle italic\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <line x1=\"19\" x2=\"10\" y1=\"4\" y2=\"4\" />\n                <line x1=\"14\" x2=\"5\" y1=\"20\" y2=\"20\" />\n                <line x1=\"15\" x2=\"9\" y1=\"4\" y2=\"20\" />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"underline\"\n              aria-label=\"Toggle underline\"\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M6 4v6a6 6 0 0 0 12 0V4\" />\n                <line x1=\"4\" x2=\"20\" y1=\"20\" y2=\"20\" />\n              </svg>\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Disabled</h2>\n        <p>\n          Set <code>data-disabled</code> on the group and\n          <code>disabled</code> on each button.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start;\n            gap: 1rem;\n          \"\n        >\n          <div\n            class=\"np-toggle-group np-toggle-group-multiple\"\n            role=\"group\"\n            aria-label=\"Disabled\"\n            data-disabled\n          >\n            <button\n              type=\"button\"\n              class=\"np-toggle\"\n              aria-pressed=\"false\"\n              value=\"bold\"\n              aria-label=\"Toggle bold\"\n              disabled\n            >\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                width=\"24\"\n                height=\"24