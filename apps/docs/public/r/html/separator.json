{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "separator",
  "title": "Separator",
  "description": "Visually or semantically separates content.",
  "files": [
    {
      "path": "registry/html/separator/separator.html",
      "content": "<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Separator - nepui</title>\r\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\r\n    <link rel=\"stylesheet\" href=\"../styles/separator.css\" />\r\n\r\n    <style>\r\n      body {\r\n        margin: 0;\r\n        padding: 2rem;\r\n        font-family: system-ui, sans-serif;\r\n        background: var(--np-background);\r\n        color: var(--np-foreground);\r\n      }\r\n      .demo {\r\n        max-width: 28rem;\r\n      }\r\n      h2 {\r\n        margin: 2rem 0 0.75rem;\r\n        font-size: 0.75rem;\r\n        font-weight: 500;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.05em;\r\n        opacity: 0.6;\r\n      }\r\n      p {\r\n        margin: 0;\r\n        font-size: 0.875rem;\r\n        opacity: 0.7;\r\n      }\r\n      .row {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 1rem;\r\n        height: 1.5rem;\r\n        font-size: 0.875rem;\r\n      }\r\n    </style>\r\n  </head>\r\n  <body>\r\n    <main class=\"demo\">\r\n      <section>\r\n        <h2>Horizontal (class)</h2>\r\n        <strong>nepui</strong>\r\n        <p>A set of accessible UI components.</p>\r\n        <div class=\"np-separator\" role=\"separator\" style=\"margin: 1rem 0\"></div>\r\n        <p>Plain CSS, no framework required.</p>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Vertical (data attributes)</h2>\r\n        <div class=\"row\">\r\n          <span>Blog</span>\r\n          <div\r\n            data-np-separator\r\n            data-orientation=\"vertical\"\r\n            role=\"separator\"\r\n            aria-orientation=\"vertical\"\r\n          ></div>\r\n          <span>Docs</span>\r\n          <div\r\n            data-np-separator\r\n            data-orientation=\"vertical\"\r\n            role=\"separator\"\r\n            aria-orientation=\"vertical\"\r\n          ></div>\r\n          <span>Source</span>\r\n        </div>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>On an &lt;hr&gt;</h2>\r\n        <p>Above</p>\r\n        <hr class=\"np-separator\" style=\"margin: 1rem 0\" />\r\n        <p>Below</p>\r\n      </section>\r\n\r\n      <section>\r\n        <h2>Custom color and thickness</h2>\r\n        <div\r\n          class=\"np-separator\"\r\n          role=\"separator\"\r\n          style=\"--np-separator-color: #7c3aed; --np-separator-size: 2px\"\r\n        ></div>\r\n      </section>\r\n    </main>\r\n  </body>\r\n</html>\r\n",
      "type": "registry:ui",
      "target": "html/separator.html"
    },
    {
      "path": "registry/html/separator/separator.css",
      "content": "/* nepui — Separator */\r\n\r\n.np-separator,\r\n[data-np-separator] {\r\n  --np-separator-size: 1px;\r\n  --np-separator-color: var(--np-border);\r\n  flex-shrink: 0;\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  height: var(--np-separator-size);\r\n  margin: 0;\r\n  border: 0;\r\n  background: var(--np-separator-color);\r\n}\r\n\r\n.np-separator-vertical,\r\n:is(.np-separator, [data-np-separator])[data-orientation=\"vertical\"] {\r\n  align-self: stretch;\r\n  width: var(--np-separator-size, 1px);\r\n  height: auto;\r\n}\r\n",
      "type": "registry:ui",
      "target": "styles/separator.css"
    }
  ],
  "type": "registry:ui"
}
