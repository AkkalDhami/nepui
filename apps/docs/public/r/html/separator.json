{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "separator",
  "title": "Separator",
  "description": "Visually or semantically separates content.",
  "files": [
    {
      "path": "registry/html/separator/separator.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Separator - nepui</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/separator.css\" />\n\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem;\n        font-family: system-ui, sans-serif;\n        background: var(--np-background);\n        color: var(--np-foreground);\n      }\n      .demo {\n        max-width: 28rem;\n      }\n      h2 {\n        margin: 2rem 0 0.75rem;\n        font-size: 0.75rem;\n        font-weight: 500;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        opacity: 0.6;\n      }\n      p {\n        margin: 0;\n        font-size: 0.875rem;\n        opacity: 0.7;\n      }\n      .row {\n        display: flex;\n        align-items: center;\n        gap: 1rem;\n        height: 1.5rem;\n        font-size: 0.875rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main class=\"demo\">\n      <section>\n        <h2>Horizontal (class)</h2>\n        <strong>nepui</strong>\n        <p>A set of accessible UI components.</p>\n        <div class=\"np-separator\" role=\"separator\" style=\"margin: 1rem 0\"></div>\n        <p>Plain CSS, no framework required.</p>\n      </section>\n\n      <section>\n        <h2>Vertical (data attributes)</h2>\n        <div class=\"row\">\n          <span>Blog</span>\n          <div\n            data-np-separator\n            data-orientation=\"vertical\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <span>Docs</span>\n          <div\n            data-np-separator\n            data-orientation=\"vertical\"\n            role=\"separator\"\n            aria-orientation=\"vertical\"\n          ></div>\n          <span>Source</span>\n        </div>\n      </section>\n\n      <section>\n        <h2>On an &lt;hr&gt;</h2>\n        <p>Above</p>\n        <hr class=\"np-separator\" style=\"margin: 1rem 0\" />\n        <p>Below</p>\n      </section>\n\n      <section>\n        <h2>Custom color and thickness</h2>\n        <div\n          class=\"np-separator\"\n          role=\"separator\"\n          style=\"--np-separator-color: #7c3aed; --np-separator-size: 2px\"\n        ></div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/separator.html"
    },
    {
      "path": "registry/html/separator/separator.css",
      "content": "/* nepui — Separator */\n\n.np-separator,\n[data-np-separator] {\n  --np-separator-size: 1px;\n  --np-separator-color: var(--np-border);\n  flex-shrink: 0;\n  box-sizing: border-box;\n  width: 100%;\n  height: var(--np-separator-size);\n  margin: 0;\n  border: 0;\n  background: var(--np-separator-color);\n}\n\n.np-separator-vertical,\n:is(.np-separator, [data-np-separator])[data-orientation=\"vertical\"] {\n  align-self: stretch;\n  width: var(--np-separator-size, 1px);\n  height: auto;\n}\n",
      "type": "registry:ui",
      "target": "styles/separator.css"
    }
  ],
  "type": "registry:ui"
}
