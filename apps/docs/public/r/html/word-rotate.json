{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "word-rotate",
  "title": "Word Rotate",
  "description": "Swap one word in a sentence for the next, on a loop.",
  "files": [
    {
      "path": "registry/html/word-rotate/word-rotate.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Word Rotate — nepui Motion</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/word-rotate.css\" />\n    <style>\n      body {\n        margin: 0;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: system-ui, sans-serif;\n      }\n      main {\n        max-width: 56rem;\n        margin: 0 auto;\n        padding: 2rem 1.25rem 4rem;\n      }\n      h2 {\n        margin: 2.5rem 0 0.75rem;\n        font-size: 0.875rem;\n        color: var(--np-muted-foreground);\n        font-weight: 500;\n      }\n      .preview {\n        border: 1px solid var(--np-border);\n        border-radius: var(--np-radius);\n        padding: 2rem 1.5rem;\n      }\n      button {\n        font: inherit;\n        font-size: 0.875rem;\n        color: var(--np-secondary-foreground);\n        background: var(--np-secondary);\n        border: 1px solid var(--np-border);\n        border-radius: var(--np-radius);\n        padding: 0.375rem 0.75rem;\n        cursor: pointer;\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Demo</h2>\n        <div class=\"preview\">\n          <p\n            style=\"\n              margin: 0;\n              font-size: clamp(1.875rem, 5vw, 3rem);\n              font-weight: 600;\n              letter-spacing: -0.025em;\n            \"\n          >\n            Build interfaces that feel\n            <span\n              class=\"np-word-rotate\"\n              role=\"img\"\n              aria-label=\"fast, calm, sharp, alive\"\n              data-gradient\n            >\n              <span class=\"np-word-rotate-item\" aria-hidden=\"true\">fast</span>\n              <span class=\"np-word-rotate-item\" aria-hidden=\"true\">calm</span>\n              <span class=\"np-word-rotate-item\" aria-hidden=\"true\">sharp</span>\n              <span class=\"np-word-rotate-item\" aria-hidden=\"true\">alive</span>\n            </span>\n          </p>\n        </div>\n      </section>\n\n      <section>\n        <h2>Variants</h2>\n        <div class=\"preview\">\n          <div\n            style=\"\n              display: grid;\n              grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));\n              gap: 1.25rem 2rem;\n            \"\n          >\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >slide</span\n              >\n              <p style=\"margin: 0\">\n                Feels\n                <span\n                  class=\"np-word-rotate\"\n                  role=\"img\"\n                  aria-label=\"fast, calm, sharp, alive\"\n                >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >fast</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >calm</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >sharp</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >alive</span\n                  >\n                </span>\n              </p>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >fade</span\n              >\n              <p style=\"margin: 0\">\n                Feels\n                <span\n                  class=\"np-word-rotate\"\n                  role=\"img\"\n                  aria-label=\"fast, calm, sharp, alive\"\n                  data-variant=\"fade\"\n                >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >fast</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >calm</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >sharp</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >alive</span\n                  >\n                </span>\n              </p>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >flip</span\n              >\n              <p style=\"margin: 0\">\n                Feels\n                <span\n                  class=\"np-word-rotate\"\n                  role=\"img\"\n                  aria-label=\"fast, calm, sharp, alive\"\n                  data-variant=\"flip\"\n                >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >fast</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >calm</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >sharp</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >alive</span\n                  >\n                </span>\n              </p>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >blur</span\n              >\n              <p style=\"margin: 0\">\n                Feels\n                <span\n                  class=\"np-word-rotate\"\n                  role=\"img\"\n                  aria-label=\"fast, calm, sharp, alive\"\n                  data-variant=\"blur\"\n                >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >fast</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >calm</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >sharp</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >alive</span\n                  >\n                </span>\n              </p>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >zoom</span\n              >\n              <p style=\"margin: 0\">\n                Feels\n                <span\n                  class=\"np-word-rotate\"\n                  role=\"img\"\n                  aria-label=\"fast, calm, sharp, alive\"\n                  data-variant=\"zoom\"\n                >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >fast</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >calm</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >sharp</span\n                  >\n                  <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                    >alive</span\n                  >\n                </span>\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Speeds and direction</h2>\n        <div class=\"preview\">\n          <div\n            style=\"\n              display: grid;\n              grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));\n              gap: 1.25rem 2rem;\n            \"\n          >\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >slow</span\n              >\n              <span\n                class=\"np-word-rotate\"\n                role=\"img\"\n                aria-label=\"fast, calm, sharp, alive\"\n                data-speed=\"slow\"\n              >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">fast</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">calm</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >sharp</span\n                >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >alive</span\n                >\n              </span>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >default</span\n              >\n              <span\n                class=\"np-word-rotate\"\n                role=\"img\"\n                aria-label=\"fast, calm, sharp, alive\"\n              >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">fast</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">calm</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >sharp</span\n                >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >alive</span\n                >\n              </span>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >fast</span\n              >\n              <span\n                class=\"np-word-rotate\"\n                role=\"img\"\n                aria-label=\"fast, calm, sharp, alive\"\n                data-speed=\"fast\"\n              >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">fast</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">calm</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >sharp</span\n                >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >alive</span\n                >\n              </span>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >reverse</span\n              >\n              <span\n                class=\"np-word-rotate\"\n                role=\"img\"\n                aria-label=\"fast, calm, sharp, alive\"\n                data-direction=\"reverse\"\n              >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">fast</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">calm</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >sharp</span\n                >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >alive</span\n                >\n              </span>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                font-size: 1.5rem;\n                font-weight: 600;\n              \"\n            >\n              <span style=\"font-size: 0.75rem; font-weight: 400; opacity: 0.6\"\n                >data-animate=\"false\"</span\n              >\n              <span\n                class=\"np-word-rotate\"\n                role=\"img\"\n                aria-label=\"fast, calm, sharp, alive\"\n                data-animate=\"false\"\n              >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">fast</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\">calm</span>\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >sharp</span\n                >\n                <span class=\"np-word-rotate-item\" aria-hidden=\"true\"\n                  >alive</span\n                >\n              </span>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section>\n        <h2>Inline</h2>\n        <div class=\"preview\">\n          <p\n            style=\"\n              margin: 0;\n              max-width: 28rem;\n              font-size: 1rem;\n              line-height: 1.75;\n            \"\n          >\n            Our team writes\n            <span\n              class=\"np-word-rotate\"\n              role=\"img\"\n              aria-label=\"plans, specs, notes\"\n              data-gradient=\"ocean\"\n            >\n              <span class=\"np-word-rotate-item\" aria-hidden=\"true\">plans</span>\n              <span class=\"np-word-rotate-item\" aria-hidden=\"true\">specs</span>\n              <span class=\"np-word-rotate-item\" aria-hidden=\"true\">notes</span>\n            </span>\n            that people actually read, then keeps them up to date as the product\n            changes.\n          </p>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/word-rotate.html"
    },
    {
      "path": "registry/html/pagination/pagination.css",
      "content": "/* nepui — Pagination */\n\n.np-pagination,\n[data-np-pagination] {\n  --np-pagination-gap: calc(var(--np-spacing) * 0.5);\n  --np-pagination-size: calc(var(--np-spacing) * 8);\n  --np-pagination-icon-size: 1rem;\n  --np-pagination-edge-padding: calc(var(--np-spacing) * 1.5);\n\n  box-sizing: border-box;\n  display: flex;\n  justify-content: center;\n  width: 100%;\n  margin-inline: auto;\n}\n\n.np-pagination-content,\n[data-np-pagination-content] {\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: var(--np-pagination-gap);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.np-pagination-item,\n[data-np-pagination-item] {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(\n    .np-pagination-link,\n    [data-np-pagination-link],\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  ) {\n  text-decoration: none;\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(.np-pagination-previous, [data-np-pagination-previous]) {\n  padding-inline-start: var(--np-pagination-edge-padding);\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(.np-pagination-next, [data-np-pagination-next]) {\n  padding-inline-end: var(--np-pagination-edge-padding);\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  )\n  svg {\n  flex-shrink: 0;\n  pointer-events: none;\n}\n\n:is(.np-pagination, [data-np-pagination])\n  :is(\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  )\n  svg:not([class*=\"size-\"]) {\n  width: var(--np-pagination-icon-size);\n  height: var(--np-pagination-icon-size);\n}\n\n.np-pagination-text,\n[data-np-pagination-text] {\n  display: none;\n}\n\n@media (min-width: 40rem) {\n  .np-pagination-text,\n  [data-np-pagination-text] {\n    display: block;\n  }\n}\n\n[dir=\"rtl\"]\n  :is(\n    .np-pagination-previous,\n    [data-np-pagination-previous],\n    .np-pagination-next,\n    [data-np-pagination-next]\n  )\n  svg {\n  transform: scaleX(-1);\n}\n\n.np-pagination-ellipsis,\n[data-np-pagination-ellipsis] {\n  box-sizing: border-box;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--np-pagination-size);\n  height: var(--np-pagination-size);\n}\n\n:is(.np-pagination-ellipsis, [data-np-pagination-ellipsis]) svg {\n  flex-shrink: 0;\n  pointer-events: none;\n}\n\n:is(.np-pagination-ellipsis, [data-np-pagination-ellipsis])\n  svg:not([class*=\"size-\"]) {\n  width: var(--np-pagination-icon-size);\n  height: var(--np-pagination-icon-size);\n}\n\n.np-pagination-sr-only,\n[data-np-pagination-sr-only] {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  border: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n",
      "type": "registry:ui",
      "target": "styles/word-rotate.css"
    }
  ],
  "type": "registry:ui"
}
