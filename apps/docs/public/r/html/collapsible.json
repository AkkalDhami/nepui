{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "collapsible",
  "title": "Collapsible",
  "description": "An interactive component which expands/collapses a panel.",
  "files": [
    {
      "path": "registry/html/collapsible/collapsible.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>nepui — Collapsible</title>\n    <link rel=\"stylesheet\" href=\"../styles/tokens.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/button.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/label.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/input.css\" />\n    <link rel=\"stylesheet\" href=\"../styles/collapsible.css\" />\n    <style>\n      body {\n        margin: 0;\n        padding: 2rem 1rem 4rem;\n        background: var(--np-background);\n        color: var(--np-foreground);\n        font-family: var(--np-font-sans, system-ui, sans-serif);\n      }\n      main {\n        display: flex;\n        flex-direction: column;\n        gap: 2.5rem;\n        max-width: 40rem;\n        margin-inline: auto;\n      }\n      h2 {\n        margin: 0 0 0.25rem;\n        font-size: 0.875rem;\n        font-weight: 600;\n      }\n      .hint {\n        margin: 0 0 0.75rem;\n        font-size: 0.8125rem;\n        color: var(--np-muted-foreground);\n      }\n    </style>\n  </head>\n  <body>\n    <main>\n      <section>\n        <h2>Class form</h2>\n        <p class=\"hint\">\n          <code>details.np-collapsible</code> with a\n          <code>summary.np-collapsible-trigger</code> first and a\n          <code>np-collapsible-content</code> after it.\n        </p>\n        <details\n          class=\"np-collapsible\"\n          open\n          style=\"width: 100%; max-width: 22rem; font-size: 0.875rem\"\n        >\n          <summary\n            class=\"np-collapsible-trigger\"\n            style=\"\n              display: flex;\n              width: 100%;\n              align-items: center;\n              justify-content: space-between;\n              font-weight: 600;\n              cursor: pointer;\n            \"\n          >\n            Order #4189\n            <svg\n              class=\"np-collapsible-icon\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              width=\"16\"\n              height=\"16\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </summary>\n          <div class=\"np-collapsible-content\">\n            <div\n              style=\"\n                display: flex;\n                justify-content: space-between;\n                padding-top: 0.75rem;\n              \"\n            >\n              <span style=\"color: var(--np-muted-foreground)\">Status</span>\n              <span>Shipped</span>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                justify-content: space-between;\n                padding-top: 0.75rem;\n              \"\n            >\n              <span style=\"color: var(--np-muted-foreground)\">Carrier</span>\n              <span>DHL Express</span>\n            </div>\n            <div\n              style=\"\n                display: flex;\n                justify-content: space-between;\n                padding-top: 0.75rem;\n              \"\n            >\n              <span style=\"color: var(--np-muted-foreground)\">Tracking</span>\n              <span>JD014600003SE</span>\n            </div>\n          </div>\n        </details>\n      </section>\n\n      <section>\n        <h2>Data-attribute form</h2>\n        <p class=\"hint\">\n          <code>data-np-collapsible</code>, <code>-trigger</code>,\n          <code>-content</code> and <code>-icon</code>.\n        </p>\n        <details\n          data-np-collapsible\n          open\n          style=\"max-width: 22rem; font-size: 0.875rem\"\n        >\n          <summary\n            data-np-collapsible-trigger\n            style=\"\n              display: flex;\n              width: 100%;\n              align-items: center;\n              justify-content: space-between;\n              font-weight: 600;\n              cursor: pointer;\n            \"\n          >\n            Data-attribute form\n            <svg\n              data-np-collapsible-icon\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              width=\"16\"\n              height=\"16\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </summary>\n          <div data-np-collapsible-content>\n            <p\n              style=\"\n                margin: 0;\n                padding-top: 0.5rem;\n                color: var(--np-muted-foreground);\n              \"\n            >\n              Same behaviour with <code>data-np-collapsible-*</code>.\n            </p>\n          </div>\n        </details>\n      </section>\n\n      <section>\n        <h2>Button trigger</h2>\n        <p class=\"hint\">Put the Button classes on the <code>summary</code>.</p>\n        <details class=\"np-collapsible\" style=\"width: 100%; max-width: 22rem\">\n          <summary\n            class=\"np-collapsible-trigger np-button np-button-outline np-button-sm\"\n          >\n            Product details\n            <svg\n              class=\"np-collapsible-icon\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              width=\"16\"\n              height=\"16\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </summary>\n          <div class=\"np-collapsible-content\">\n            <p\n              style=\"\n                margin: 0;\n                padding-top: 0.75rem;\n                font-size: 0.875rem;\n                color: var(--np-muted-foreground);\n              \"\n            >\n              This product has a lightweight aluminum frame, a 14-hour battery\n              and a two-year warranty. It ships in recyclable packaging.\n            </p>\n          </div>\n        </details>\n      </section>\n\n      <section>\n        <h2>Settings panel</h2>\n        <p class=\"hint\">\n          The content can hold form controls.\n          <code>--np-collapsible-overflow: visible</code> stops focus rings\n          being clipped.\n        </p>\n        <details\n          class=\"np-collapsible\"\n          style=\"\n            width: 100%;\n            max-width: 22rem;\n            padding: 1rem;\n            border: 1px solid var(--np-border);\n            border-radius: var(--np-radius-md);\n            --np-collapsible-overflow: visible;\n          \"\n        >\n          <summary\n            class=\"np-collapsible-trigger\"\n            style=\"\n              display: flex;\n              width: 100%;\n              align-items: center;\n              justify-content: space-between;\n              gap: 1rem;\n              cursor: pointer;\n            \"\n          >\n            <span style=\"display: flex; flex-direction: column; gap: 0.125rem\">\n              <span style=\"font-size: 0.875rem; font-weight: 600\">Radius</span>\n              <span\n                style=\"font-size: 0.8125rem; color: var(--np-muted-foreground)\"\n                >Set the corner radius of the element.</span\n              >\n            </span>\n            <svg\n              class=\"np-collapsible-icon\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              width=\"16\"\n              height=\"16\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </summary>\n          <div class=\"np-collapsible-content\">\n            <div style=\"display: flex; gap: 0.75rem; padding-top: 1rem\">\n              <div\n                style=\"\n                  display: flex;\n                  flex: 1;\n                  flex-direction: column;\n                  gap: 0.5rem;\n                \"\n              >\n                <label class=\"np-label\" for=\"radius-x\">Radius X</label>\n                <input class=\"np-input\" id=\"radius-x\" value=\"8\" />\n              </div>\n              <div\n                style=\"\n                  display: flex;\n                  flex: 1;\n                  flex-direction: column;\n                  gap: 0.5rem;\n                \"\n              >\n                <label class=\"np-label\" for=\"radius-y\">Radius Y</label>\n                <input class=\"np-input\" id=\"radius-y\" value=\"8\" />\n              </div>\n            </div>\n          </div>\n        </details>\n      </section>\n\n      <section>\n        <h2>File tree</h2>\n        <p class=\"hint\">\n          Nested collapsibles. The icon rotates 90deg with\n          <code>--np-collapsible-icon-rotate</code>.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            gap: 0.25rem;\n            width: 100%;\n            max-width: 16rem;\n            font-size: 0.875rem;\n          \"\n        >\n          <details class=\"np-collapsible\" open>\n            <summary\n              class=\"np-collapsible-trigger\"\n              style=\"\n                display: flex;\n                align-items: center;\n                gap: 0.5rem;\n                cursor: pointer;\n              \"\n            >\n              <svg\n                class=\"np-collapsible-icon\"\n                style=\"--np-collapsible-icon-rotate: 90deg\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                width=\"16\"\n                height=\"16\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"m9 18 6-6-6-6\" />\n              </svg>\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                width=\"16\"\n                height=\"16\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  d=\"M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z\"\n                />\n              </svg>\n              components\n            </summary>\n            <div\n              class=\"np-collapsible-content\"\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                padding-top: 0.25rem;\n                padding-inline-start: 1.25rem;\n              \"\n            >\n              <div style=\"display: flex; align-items: center; gap: 0.5rem\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  width=\"16\"\n                  height=\"16\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path\n                    d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                  />\n                  <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n                </svg>\n                button.tsx\n              </div>\n              <div style=\"display: flex; align-items: center; gap: 0.5rem\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  width=\"16\"\n                  height=\"16\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path\n                    d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                  />\n                  <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n                </svg>\n                card.tsx\n              </div>\n            </div>\n          </details>\n          <details class=\"np-collapsible\">\n            <summary\n              class=\"np-collapsible-trigger\"\n              style=\"\n                display: flex;\n                align-items: center;\n                gap: 0.5rem;\n                cursor: pointer;\n              \"\n            >\n              <svg\n                class=\"np-collapsible-icon\"\n                style=\"--np-collapsible-icon-rotate: 90deg\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                width=\"16\"\n                height=\"16\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"m9 18 6-6-6-6\" />\n              </svg>\n              <svg\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                width=\"16\"\n                height=\"16\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  d=\"M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z\"\n                />\n              </svg>\n              lib\n            </summary>\n            <div\n              class=\"np-collapsible-content\"\n              style=\"\n                display: flex;\n                flex-direction: column;\n                gap: 0.25rem;\n                padding-top: 0.25rem;\n                padding-inline-start: 1.25rem;\n              \"\n            >\n              <div style=\"display: flex; align-items: center; gap: 0.5rem\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 24 24\"\n                  width=\"16\"\n                  height=\"16\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  aria-hidden=\"true\"\n                >\n                  <path\n                    d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n                  />\n                  <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n                </svg>\n                utils.ts\n              </div>\n            </div>\n          </details>\n          <div\n            style=\"\n              display: flex;\n              align-items: center;\n              gap: 0.5rem;\n              padding-inline-start: 1.5rem;\n            \"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              width=\"16\"\n              height=\"16\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n              />\n              <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n            </svg>\n            app.tsx\n          </div>\n          <div\n            style=\"\n              display: flex;\n              align-items: center;\n              gap: 0.5rem;\n              padding-inline-start: 1.5rem;\n            \"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              width=\"16\"\n              height=\"16\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"\n              />\n              <path d=\"M14 2v4a2 2 0 0 0 2 2h4\" />\n            </svg>\n            package.json\n          </div>\n        </div>\n      </section>\n\n      <section>\n        <h2>Exclusive group</h2>\n        <p class=\"hint\">\n          Give several <code>details</code> the same <code>name</code> and only\n          one stays open.\n        </p>\n        <div\n          style=\"\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n            max-width: 22rem;\n          \"\n        >\n          <details class=\"np-collapsible\" name=\"faq\">\n            <summary\n              class=\"np-collapsible-trigger\"\n              style=\"\n                display: flex;\n                width: 100%;\n                align-items: center;\n                justify-content: space-between;\n                font-weight: 600;\n                cursor: pointer;\n              \"\n            >\n              Can I use this in my project?\n              <svg\n                class=\"np-collapsible-icon\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                width=\"16\"\n                height=\"16\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"m6 9 6 6 6-6\" />\n              </svg>\n            </summary>\n            <div class=\"np-collapsible-content\">\n              <p\n                style=\"\n                  margin: 0;\n                  padding-block: 0.5rem;\n                  font-size: 0.875rem;\n                  color: var(--np-muted-foreground);\n                \"\n              >\n                Yes. Free for personal and commercial projects.\n              </p>\n            </div>\n          </details>\n          <details class=\"np-collapsible\" name=\"faq\">\n            <summary\n              class=\"np-collapsible-trigger\"\n              style=\"\n                display: flex;\n                width: 100%;\n                align-items: center;\n                justify-content: space-between;\n                font-weight: 600;\n                cursor: pointer;\n              \"\n            >\n              Is it accessible?\n              <svg\n                class=\"np-collapsible-icon\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                width=\"16\"\n                height=\"16\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"m6 9 6 6 6-6\" />\n              </svg>\n            </summary>\n            <div class=\"np-collapsible-content\">\n              <p\n                style=\"\n                  margin: 0;\n                  padding-block: 0.5rem;\n                  font-size: 0.875rem;\n                  color: var(--np-muted-foreground);\n                \"\n              >\n                It is a native details element, so keyboard and screen readers\n                work.\n              </p>\n            </div>\n          </details>\n          <details class=\"np-collapsible\" name=\"faq\">\n            <summary\n              class=\"np-collapsible-trigger\"\n              style=\"\n                display: flex;\n                width: 100%;\n                align-items: center;\n                justify-content: space-between;\n                font-weight: 600;\n                cursor: pointer;\n              \"\n            >\n              Does it need JavaScript?\n              <svg\n                class=\"np-collapsible-icon\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 24 24\"\n                width=\"16\"\n                height=\"16\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"m6 9 6 6 6-6\" />\n              </svg>\n            </summary>\n            <div class=\"np-collapsible-content\">\n              <p\n                style=\"\n                  margin: 0;\n                  padding-block: 0.5rem;\n                  font-size: 0.875rem;\n                  color: var(--np-muted-foreground);\n                \"\n              >\n                No.\n              </p>\n            </div>\n          </details>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
      "type": "registry:ui",
      "target": "html/collapsible.html"
    },
    {
      "path": "registry/html/collapsible/collapsible.css",
      "content": "/* nepui - Collapsible */\n\n.np-collapsible,\n[data-np-collapsible] {\n  --np-collapsible-duration: 200ms;\n  --np-collapsible-easing: ease;\n  --np-collapsible-icon-rotate: 180deg;\n  --np-collapsible-overflow: visible;\n\n  display: block;\n  box-sizing: border-box;\n}\n\ndetails:is(.np-collapsible, [data-np-collapsible]) {\n  interpolate-size: allow-keywords;\n}\n\n:where(.np-collapsible-trigger, [data-np-collapsible-trigger]) {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: var(--np-radius-sm);\n  background-color: transparent;\n  color: inherit;\n  font: inherit;\n  text-align: inherit;\n  appearance: none;\n  outline: none;\n}\n\nsummary:is(.np-collapsible-trigger, [data-np-collapsible-trigger]) {\n  list-style: none;\n}\n\nsummary:is(\n    .np-collapsible-trigger,\n    [data-np-collapsible-trigger]\n  )::-webkit-details-marker {\n  display: none;\n}\n\n:is(.np-collapsible-trigger, [data-np-collapsible-trigger]):focus-visible {\n  box-shadow: 0 0 0 3px color-mix(in oklch, var(--np-ring), transparent 50%);\n}\n\n:is(.np-collapsible-trigger, [data-np-collapsible-trigger]):is(\n  :disabled,\n  [aria-disabled=\"true\"],\n  [data-disabled]\n) {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.np-collapsible-icon,\n[data-np-collapsible-icon] {\n  flex-shrink: 0;\n  pointer-events: none;\n  transition: transform var(--np-collapsible-duration, 200ms)\n    var(--np-collapsible-easing, ease);\n}\n\n:is(.np-collapsible-trigger, [data-np-collapsible-trigger]):is(\n    [aria-expanded=\"true\"],\n    [data-panel-open]\n  )\n  :is(.np-collapsible-icon, [data-np-collapsible-icon]),\n:is(.np-collapsible, [data-np-collapsible])[open]\n  > :is(.np-collapsible-trigger, [data-np-collapsible-trigger])\n  :is(.np-collapsible-icon, [data-np-collapsible-icon]) {\n  transform: rotate(var(--np-collapsible-icon-rotate, 180deg));\n}\n\n.np-collapsible-content,\n[data-np-collapsible-content] {\n  box-sizing: border-box;\n  height: var(--collapsible-panel-height, auto);\n  overflow: hidden;\n  transition: height var(--np-collapsible-duration, 200ms)\n    var(--np-collapsible-easing, ease);\n}\n\n:is(.np-collapsible-content, [data-np-collapsible-content]):is(\n  [data-starting-style],\n  [data-ending-style]\n) {\n  height: 0;\n}\n\n:is(.np-collapsible-content, [data-np-collapsible-content])[data-open]:not(\n    [data-starting-style],\n    [data-ending-style]\n  ) {\n  overflow: var(--np-collapsible-overflow, visible);\n  transition:\n    height var(--np-collapsible-duration, 200ms)\n      var(--np-collapsible-easing, ease),\n    overflow 0s linear var(--np-collapsible-duration, 200ms) allow-discrete;\n}\n\ndetails:is(.np-collapsible, [data-np-collapsible])\n  > :is(.np-collapsible-content, [data-np-collapsible-content]) {\n  overflow: visible;\n}\n\n@supports selector(::details-content) {\n  details:is(.np-collapsible, [data-np-collapsible])::details-content {\n    block-size: 0;\n    overflow: hidden;\n    transition:\n      block-size var(--np-collapsible-duration, 200ms)\n        var(--np-collapsible-easing, ease),\n      content-visibility var(--np-collapsible-duration, 200ms) allow-discrete;\n  }\n\n  details:is(.np-collapsible, [data-np-collapsible])[open]::details-content {\n    block-size: auto;\n    overflow: var(--np-collapsible-overflow, visible);\n    transition:\n      block-size var(--np-collapsible-duration, 200ms)\n        var(--np-collapsible-easing, ease),\n      content-visibility var(--np-collapsible-duration, 200ms) allow-discrete,\n      overflow 0s linear var(--np-collapsible-duration, 200ms) allow-discrete;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .np-collapsible-icon,\n  [data-np-collapsible-icon],\n  .np-collapsible-content,\n  [data-np-collapsible-content] {\n    transition: none;\n  }\n\n  details:is(.np-collapsible, [data-np-collapsible])::details-content {\n    transition: none;\n  }\n}\n",
      "type": "registry:ui",
      "target": "styles/collapsible.css"
    }
  ],
  "type": "registry:ui"
}
