import { cp, mkdir, rm, writeFile } from "node:fs/promises"
import path from "node:path"
import { fileURLToPath } from "node:url"

const rootDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..")

const sourceDir = path.join(rootDir, "registry", "react")
const outputDir = path.join(rootDir, "components", "nepui")

const readme = `# Nepui Components

This directory contains auto-generated nepui component files.

**Do not edit these files directly.** Changes should be made in the
source files under \`registry/\` and regenerated using the build command.

## Generate files

Run the following command from the repository root:

\`\`\`bash
pnpm build:components
\`\`\`

The build script copies the contents of \`registry/\` into this directory,
preserving the original directory structure.

Generated by \`scripts/build-components.mts\`.
`

async function buildComponents() {
  console.log("Building nepui components...")

  // Ensure the source directory exists.
  await mkdir(sourceDir, { recursive: true })

  // Recreate the generated output to remove stale files.
  await rm(outputDir, { recursive: true, force: true })
  await mkdir(outputDir, { recursive: true })

  // Copy every file and folder, including HTML and React components.
  await cp(sourceDir, outputDir, {
    recursive: true,
    force: true,
  })

  // Add documentation to the generated directory.
  await writeFile(path.join(outputDir, "README.md"), readme, "utf8")

  console.log(`Components generated at: ${path.relative(rootDir, outputDir)}`)
}

buildComponents().catch((error: unknown) => {
  console.error("Failed to build nepui components:", error)
  process.exitCode = 1
})
