{
  "name": "nepui",
  "version": "1.0.0",
  "description": "CLI for installing nepui components (HTML & React, plain CSS, no runtime dependencies).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nepui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nepui",
    "cli",
    "ui",
    "components",
    "react",
    "html",
    "css",
    "registry",
    "shadcn"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": {
    "name": "Akkal Dhami",
    "github": "https://github.com/AkkalDhami",
    "url": "https://akkal.com.np"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkkalDhami/nepui.git",
    "directory": "packages/nepui"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "pub": "npm publish"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.9.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
