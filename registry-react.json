{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "nepui",
  "homepage": "https://nepui.vercel.app",
  "items": [
    {
      "name": "button",
      "type": "registry:component",
      "title": "Button",
      "description": "A button triggers an action, submits a form, or performs another user-initiated operation.",
      "files": [
        {
          "path": "registry/react/button/button.tsx",
          "type": "registry:component",
          "target": "components/nepui/button/button.tsx"
        },
        {
          "path": "registry/react/button/button.css",
          "type": "registry:component",
          "target": "components/nepui/button/button.css"
        },
        {
          "path": "registry/react/button/index.tsx",
          "type": "registry:component",
          "target": "components/nepui/button/index.tsx"
        }
      ]
    }
  ]
}
