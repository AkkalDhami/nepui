{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "nepui",
  "homepage": "https://nepui.vercel.app",
  "items": [
    {
      "name": "button",
      "type": "registry:component",
      "title": "Button",
      "description": "A button triggers an action, submits a form, or performs another user-initiated operation.",
      "files": [
        {
          "path": "registry/tokens.css",
          "type": "registry:component",
          "target": "components/nepui/tokens.css"
        },
        {
          "path": "registry/react/button/button.tsx",
          "type": "registry:component",
          "target": "components/nepui/button/button.tsx"
        },
        {
          "path": "registry/react/button/button.css",
          "type": "registry:component",
          "target": "components/nepui/button/button.css"
        },
        {
          "path": "registry/react/button/index.tsx",
          "type": "registry:component",
          "target": "components/nepui/button/index.tsx"
        }
      ]
    },
    {
      "name": "spinner",
      "type": "registry:component",
      "title": "Spinner",
      "description": "An indicator that can be used to show a loading state.",
      "files": [
        {
          "path": "registry/react/spinner/spinner.tsx",
          "type": "registry:component",
          "target": "components/nepui/spinner/spinner.tsx"
        },
        {
          "path": "registry/react/spinner/spinner.css",
          "type": "registry:component",
          "target": "components/nepui/spinner/spinner.css"
        },
        {
          "path": "registry/react/spinner/index.tsx",
          "type": "registry:component",
          "target": "components/nepui/spinner/index.tsx"
        }
      ]
    }
  ]
}
